			manager.setListOpen(not manager.listOpen)
		end)
		manager.saveButton.MouseButton1Click:Connect(function()
			local profileName = string.match(manager.nameBox.Text, "^%s*(.-)%s*$") or ""
			if profileName == "" then manager.setStatus("Digite um nome para a configuração.", true); return end
			if #profileName > 40 then manager.setStatus("O nome pode ter no máximo 40 caracteres.", true); return end
			local settings = {}
			for _, binding in ipairs(configBindings) do
				local ok, value = pcall(binding.getter)
				if ok then
					local encoded = manager.encode(value)
					if encoded ~= nil then settings[binding.key] = encoded end
				end
			end
			manager.profiles[profileName] = {version = 1, settings = settings}
			manager.setSelected(profileName)
			manager.nameBox.Text = ""
			local stored = manager.persist()
			manager.setStatus(stored and ("Configuração \"" .. profileName .. "\" salva.") or "Salva na sessão, mas não foi possível gravar o arquivo.", not stored)
			manager.refreshList()
		end)
		manager.useButton.MouseButton1Click:Connect(function()
			if not manager.selectedName or not manager.profiles[manager.selectedName] then
				manager.setStatus("Escolha uma configuração na lista primeiro.", true)
				return
			end
			local profile = manager.profiles[manager.selectedName]
			local settings = type(profile) == "table" and (profile.settings or profile) or nil
			if type(settings) ~= "table" then manager.setStatus("A configuração salva está inválida.", true); return end
			local applied = 0
			for _, binding in ipairs(configBindings) do
				local storedValue = settings[binding.key]
				if storedValue ~= nil then
					local value = manager.decode(storedValue)
					if value ~= nil then
						local ok = pcall(binding.setter, value)
						if ok then applied = applied + 1 end
					end
				end
			end
			manager.setStatus("Configuração aplicada: " .. manager.selectedName .. " (" .. tostring(applied) .. " opções).", false)
		end)
		manager.cancelDelete.MouseButton1Click:Connect(manager.hideConfirm)
		manager.confirmDelete.MouseButton1Click:Connect(function()
			local profileName = manager.deleteName
			if not profileName or manager.profiles[profileName] == nil then
				manager.hideConfirm()
				return
			end
			manager.profiles[profileName] = nil
			if manager.selectedName == profileName then manager.setSelected(nil) end
			manager.hideConfirm()
			local stored = manager.persist()
			manager.refreshList()
			manager.setStatus(stored and ("Configuração \"" .. profileName .. "\" excluída.") or "Excluída da sessão, mas não foi possível atualizar o arquivo.", not stored)
		end)
		manager.refreshList()
	end

	TweenService:Create(mainPanel, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = currentPanelSize
	}):Play()
end

