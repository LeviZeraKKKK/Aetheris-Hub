		local function applyPanelScale()
			-- usa o Size configurado (e não o AbsoluteSize) para não somar com a animação de escala
			local w, h = mainPanel.Size.X.Offset, mainPanel.Size.Y.Offset
			if w <= 0 or h <= 0 then return end
			local f = math.clamp(math.min(w / baseW, h / baseH), 0.6, 1.7)
			bodyScale.Scale = f
			body.Size = UDim2.new(0, w / f, 0, h / f)
		end
		mainPanel:GetPropertyChangedSignal("Size"):Connect(applyPanelScale)
		applyPanelScale()
	end

