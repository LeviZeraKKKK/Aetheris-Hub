				end
				table.sort(userIds)
				return userIds
			end, function(savedUserIds)
				local wanted = {}
				if type(savedUserIds) == "table" then
					for _, userId in ipairs(savedUserIds) do
						local numericId = tonumber(userId)
						if numericId then wanted[numericId] = true end
					end
				end
				for target in pairs(selectedManualTargets) do selectedManualTargets[target] = nil end
				for _, target in ipairs(Players:GetPlayers()) do
					if target ~= player and wanted[target.UserId] then selectedManualTargets[target] = true end
				end
