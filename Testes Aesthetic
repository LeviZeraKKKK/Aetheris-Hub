    if not col.emptyLbl then
        local label = Instance.new("TextLabel")
        label.Name = "StockStatus"
        label.Size = UDim2.new(1, -14, 1, -12)
        label.Position = UDim2.new(0, 7, 0, 6)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(151, 157, 175)
        label.Font = currentGlobalFont
        label.TextSize = 10
        label.TextWrapped = true
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.ZIndex = 13
        label.Parent = col.scroll
        table.insert(allTextLabels, label)
        col.emptyLbl = label
    end
    col.emptyLbl.Text = message
    col.emptyLbl.Visible = true
    if col.loadTween then col.loadTween:Cancel(); col.loadTween = nil end
    col.emptyLbl.TextTransparency = 0
    if string.find(message, "Carregando", 1, true) then
        col.loadTween = TweenService:Create(col.emptyLbl, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {TextTransparency = 0.65})
        col.loadTween:Play()
    end
    col.scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
end

local function render(adv, fruits)
    local col = columns[adv]
    local stock = {}
    for _, fruit in ipairs(fruits) do
        if type(fruit) == "table" and fruit.OnSale == true and type(fruit.Name) == "string" then
            table.insert(stock, fruit)
        end
    end
    table.sort(stock, function(a, b)
        local priceA = getFruitPrice(a)
        local priceB = getFruitPrice(b)
        if priceA == nil and priceB == nil then
            return string.lower(a.Name) < string.lower(b.Name)
        elseif priceA == nil then
            return false
        elseif priceB == nil then
            return true
        elseif priceA == priceB then
            return string.lower(a.Name) < string.lower(b.Name)
        end
        return priceA < priceB
    end)
    col.lastStock = stock

    if #stock == 0 then
        setMessage(col, "Nenhuma fruta disponível no momento")
    else
        if col.emptyLbl then col.emptyLbl.Visible = false end
        for i, fruit in ipairs(stock) do
            if not col.pool[i] then
                col.pool[i] = createRow(col.scroll, col.accent)
            end
            local entry = col.pool[i]
            entry.row.Visible = true
            entry.row.Position = UDim2.new(0, 2, 0, (i - 1) * ROW_STEP)
            entry.row.BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(31, 35, 49) or Color3.fromRGB(37, 41, 57)
            entry.baseColor = entry.row.BackgroundColor3
            entry.name.Text = fruit.Name
            local price = getFruitPrice(fruit)
            entry.price.Text = price and formatBeli(price) or "N/D"
            if not price then
                entry.price.TextColor3 = Color3.fromRGB(155, 160, 176)
            elseif getBeli() >= price then
                entry.price.TextColor3 = Color3.fromRGB(145, 235, 164)
            else
                entry.price.TextColor3 = Color3.fromRGB(255, 170, 130)
            end
        end
        for i = #stock + 1, #col.pool do
            col.pool[i].row.Visible = false
        end
    end
    col.scroll.CanvasSize = UDim2.new(0, 0, 0, #stock * ROW_STEP + 4)
    if not col.hasLoaded and #stock > 0 then FVX.playRows(col) end
    col.hasLoaded = true
end

-- ============ CONSULTA SEGURA ============
local fetching = {[false] = false, [true] = false}
local function fetch(adv)
    if type(StateUtil) ~= "table" then return nil end
    local ok, result = pcall(function()
        local remote = StateUtil.CommRemoteFunc
        if not remote then error("Remote indisponível") end
        local invokeServer = remote.InvokeServer
        if type(invokeServer) ~= "function" then error("InvokeServer indisponível") end
        return invokeServer(remote, "GetFruits", adv)
    end)
    if ok and type(result) == "table" then return result end
    return nil
end

local function formatCountdown(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local remainder = seconds % 60
    return string.format("%02d:%02d:%02d", hours, minutes, remainder)
end

local function fetchCol(adv)
    if fetching[adv] then return end
    fetching[adv] = true
    local col = columns[adv]
    if not col.hasLoaded then setMessage(col, "Carregando estoque...") end
    task.spawn(function()
        local fruits = fetch(adv)
        if sg.Parent and panel.Visible then
            if fruits then
                render(adv, fruits)
            elseif not col.hasLoaded then
                setMessage(col, "Não foi possível carregar. Toque em atualizar.")
            end
        end
        fetching[adv] = false
    end)
end

local function updateRefreshCountdown(now)
    now = tonumber(now) or os.time()
    for adv, col in pairs(columns) do
        local cycle = math.floor(now / col.interval)
        if col.lastCycle ~= nil and cycle ~= col.lastCycle then
            fetchCol(adv)
        end
        col.lastCycle = cycle
        local remaining = col.interval - (now % col.interval)
        col.timer.Text = "Atualiza em " .. formatCountdown(remaining)
        if col.progFill then
            TweenService:Create(col.progFill, TweenInfo.new(0.95, Enum.EasingStyle.Linear), {Size = UDim2.new(math.clamp(remaining / col.interval, 0, 1), 0, 1, 0)}):Play()
        end
    end
end

local function updatePriceColors()
    local balance = getBeli()
    for _, col in pairs(columns) do
        for i, entry in ipairs(col.pool) do
            local fruit = col.lastStock[i]
            if fruit and entry.row.Visible then
                local price = getFruitPrice(fruit)
                if not price then
                    entry.price.TextColor3 = Color3.fromRGB(155, 160, 176)
                elseif balance >= price then
                    entry.price.TextColor3 = Color3.fromRGB(145, 235, 164)
                else
                    entry.price.TextColor3 = Color3.fromRGB(255, 170, 130)
                end
            end
        end
    end
end

local function updateBalanceDisplay()
    subtitle.Text = "SEU SALDO  •  " .. formatBeli(getBeli()) .. " Beli"
    updatePriceColors()
end

local function refreshAll()
    updateBalanceDisplay()
    fetchCol(false)
    fetchCol(true)
end

