		blur = Instance.new("BlurEffect")
		blur.Name = "AetherisLoadingBlur"
		blur.Size = 0
		blur.Parent = Lighting
	end)
	screenGui.Destroying:Connect(function()
		if blur then blur:Destroy() end
	end)

	-- Card central. O UIScale ajusta o tamanho à tela (celular, janela pequena etc.).
	local loadWrapper = Instance.new("Frame")
	loadWrapper.Name = "LoadingCard"
	loadWrapper.Size = UDim2.new(0, 360, 0, 188)
	loadWrapper.AnchorPoint = Vector2.new(0.5, 0.5)
	loadWrapper.Position = UDim2.new(0.5, 0, 0.5, 0)
	loadWrapper.BackgroundColor3 = Color3.fromRGB(14, 14, 21)
	loadWrapper.BackgroundTransparency = 0.06
	loadWrapper.BorderSizePixel = 0
	loadWrapper.ClipsDescendants = true
	loadWrapper.Parent = screenGui

	local function computeBaseScale()
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		local fit = math.min(viewport.X / 400, viewport.Y / 250)
		return math.clamp(math.min(isMobile and 1.1 or 1, fit), 0.55, 1.15)
	end
	local baseScale = computeBaseScale()
	local leaving = false

	local loadScale = Instance.new("UIScale")
	loadScale.Scale = baseScale * 0.94
	loadScale.Parent = loadWrapper

	local resizeConn
	if camera then
		resizeConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if not loadWrapper.Parent then
				resizeConn:Disconnect()
				return
			end
			baseScale = computeBaseScale()
			if not leaving then loadScale.Scale = baseScale end
		end)
	end

	local loadCorner = Instance.new("UICorner")
	loadCorner.CornerRadius = UDim.new(0, 14)
	loadCorner.Parent = loadWrapper

	-- Contorno com degradê (mais forte no topo, mais suave embaixo).
	local loadStroke = Instance.new("UIStroke")
	loadStroke.Color = currentThemeColor
	loadStroke.Transparency = 0.3
	loadStroke.Thickness = 1.5
	loadStroke.Parent = loadWrapper
	table.insert(themeSections, loadStroke)
	local strokeGradient = Instance.new("UIGradient")
	strokeGradient.Color = ColorSequence.new(WHITE, Color3.fromRGB(150, 150, 150))
	strokeGradient.Rotation = 90
	strokeGradient.Parent = loadStroke

	-- Linha superior animada.
	local loadAccent = Instance.new("Frame")
	loadAccent.Name = "LoadingAccent"
	loadAccent.Size = UDim2.new(0.18, 0, 0, 2)
	loadAccent.Position = UDim2.new(0.41, 0, 0, 0)
	loadAccent.BackgroundColor3 = currentThemeColor
	loadAccent.BorderSizePixel = 0
	loadAccent.Parent = loadWrapper
	table.insert(themeSliders, loadAccent)
	local accentCorner = Instance.new("UICorner")
	accentCorner.CornerRadius = UDim.new(1, 0)
	accentCorner.Parent = loadAccent

	-- Partículas discretas ficam na camada de fundo, atrás dos textos.
	local loadingParticles = {}
	local loadingColumns = 5
	local loadingRows = 4
	for i = 1, loadingColumns * loadingRows do
		local column = (i - 1) % loadingColumns
		local row = math.floor((i - 1) / loadingColumns)
		local baseX = (column + 0.5) / loadingColumns + (math.random(0, 100) / 100 - 0.5) * 0.07
		local baseY = (row + 0.5) / loadingRows + (math.random(0, 100) / 100 - 0.5) * 0.12
		local particle = Instance.new("Frame")
		local particleSize = math.random(2, 4)
		particle.Size = UDim2.new(0, particleSize, 0, particleSize)
		particle.Position = UDim2.new(baseX, 0, baseY, 0)
		particle.BackgroundColor3 = currentThemeColor
		particle.BackgroundTransparency = 0.78
		particle.BorderSizePixel = 0
		particle.ZIndex = 1
		particle.Parent = loadWrapper
		local particleCorner = Instance.new("UICorner")
		particleCorner.CornerRadius = UDim.new(1, 0)
		particleCorner.Parent = particle
		table.insert(themeParticles, particle)
		table.insert(loadingParticles, particle)

		local driftX = (math.random(0, 100) / 100 - 0.5) * 0.05
		local driftY = (math.random(0, 100) / 100 - 0.5) * 0.08
		TweenService:Create(particle, TweenInfo.new(2.0 + (i % 5) * 0.24, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, (i - 1) * 0.07), {
			Position = UDim2.new(baseX + driftX, 0, baseY + driftY, 0),
			BackgroundTransparency = 0.54
		}):Play()
	end

	-- Aro: uma trilha fraca fixa + um arco com degradê de transparência que gira de verdade.
	local ringTrack = Instance.new("Frame")
	ringTrack.Size = UDim2.new(0, 42, 0, 42)
	ringTrack.Position = UDim2.new(0.5, -21, 0, 14)
	ringTrack.BackgroundTransparency = 1
	ringTrack.ZIndex = 2
