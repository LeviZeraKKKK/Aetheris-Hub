		local function httpGet(url)
			local req = (syn and syn.request) or request or http_request or (http and http.request)
			if req then
				local ok, res = pcall(req, {Url = url, Method = "GET"})
				if ok and res and res.Body then return res.Body end
			end
			local ok, body = pcall(function() return game:HttpGet(url) end)
			if ok then return body end
			return nil
		end

		local function pickServer(lowest)
			local body = httpGet("https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100")
			if not body then return nil end
			local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
			if not ok or type(data) ~= "table" or type(data.data) ~= "table" then return nil end
			local list = {}
			for _, sv in ipairs(data.data) do
				if sv.id ~= game.JobId and (sv.playing or 0) < (sv.maxPlayers or 0) then
					table.insert(list, sv)
				end
			end
			if #list == 0 then return nil end
			if lowest then
				table.sort(list, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
				return list[1].id
			end
			return list[math.random(1, #list)].id
		end

