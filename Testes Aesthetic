					BackgroundColor3 = Color3.fromRGB(52, 52, 74), BorderSizePixel = 0
				}, row)
				round(avatar, 11)
				local initial = new("TextLabel", {
					Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
					Text = string.upper(string.sub(target.DisplayName, 1, 1)), TextColor3 = Color3.fromRGB(225, 225, 240), TextSize = 11
				}, avatar)
				-- foto do avatar (skin) do jogador; a inicial fica como fallback enquanto carrega
				do
					AetherisAvatarCache = AetherisAvatarCache or {}
					local avatarImg = new("ImageLabel", {
						Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
						ScaleType = Enum.ScaleType.Crop, Image = "", Visible = false
					}, avatar)
					round(avatarImg, 11)
					local userId = target.UserId
					local function applyAvatar(img)
						if img and img ~= "" and avatarImg.Parent then
							avatarImg.Image = img
							avatarImg.Visible = true
							initial.Visible = false
						end
					end
					if AetherisAvatarCache[userId] then
						applyAvatar(AetherisAvatarCache[userId])
					else
						task.spawn(function()
							local ok, img = pcall(function()
								return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
							end)
							if ok and img then
								AetherisAvatarCache[userId] = img
								applyAvatar(img)
							end
						end)
					end
				end
				local nameLabel = new("TextLabel", {
					Size = UDim2.new(1, -78, 0, 14), Position = UDim2.new(0, 34, 0, 3), BackgroundTransparency = 1,
					Font = currentGlobalFont, Text = target.DisplayName, TextColor3 = currentTextColor, TextSize = 10,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd
				}, row)
				table.insert(allTextLabels, nameLabel)
				new("TextLabel", {
					Size = UDim2.new(1, -78, 0, 11), Position = UDim2.new(0, 34, 0, 17), BackgroundTransparency = 1,
					Font = Enum.Font.Gotham, Text = "@" .. target.Name, TextColor3 = GRAY, TextSize = 8,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd
				}, row)
				local check = new("Frame", {
					Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -26, 0.5, -9),
					BackgroundColor3 = Color3.fromRGB(52, 52, 72), BorderSizePixel = 0
				}, row)
