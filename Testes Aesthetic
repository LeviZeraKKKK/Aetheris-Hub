	local function setFruitRollStatus(message, color)
		if rollStatusLabel and rollStatusLabel.Parent then
			local cleanMessage = string.gsub(tostring(message or ""), "[%c]+", " ")
			if #cleanMessage > 150 then cleanMessage = string.sub(cleanMessage, 1, 147) .. "..." end
