				if not toastHolder or not toastHolder.Parent then return end
				duration = math.max(tonumber(duration) or tonumber(NC.duration) or 3, 0.5)
				local list = {}
				for _, c in ipairs(toastHolder:GetChildren()) do if c:IsA("Frame") then table.insert(list, c) end end
				table.sort(list, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
				if #list >= 4 then list[1]:Destroy() end

				-- toast simples: caixa preta, texto branco
				toastSeq = toastSeq + 1
				local t = Instance.new("Frame")
				t.LayoutOrder = toastSeq
				t.Size = UDim2.fromOffset(0, 28)
				t.AutomaticSize = Enum.AutomaticSize.X
				t.BackgroundColor3 = Color3.new(0, 0, 0)
				t.BackgroundTransparency = 1
