-- Dropdown único do hub: cabeçalho com a opção atual + lista que abre por baixo (com animação).
-- cfg = {prefix, placeholder, label, value, maxRows, getOptions = function() -> {{label, value, font?}}, onSelect = function(value, option)}
-- Retorna {setValue(value, label), close(), frame}
function AetherisDropdown(parent, cfg)
	local HEADER, ROW, GAP = 28, 24, 4
	local GRAYSTROKE = Color3.fromRGB(70, 70, 95)
	local state = {open = false, value = cfg.value, label = cfg.label, icon = cfg.icon, options = {}}

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, HEADER)
	frame.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
	frame.BackgroundTransparency = 0.35
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.Parent = parent
	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 7)
	frameCorner.Parent = frame
	local frameStroke = Instance.new("UIStroke")
	frameStroke.Color = GRAYSTROKE
	frameStroke.Transparency = 0.55
	frameStroke.Thickness = 1
	frameStroke.Parent = frame

	local header = Instance.new("TextButton")
	header.Size = UDim2.new(1, 0, 0, HEADER)
	header.BackgroundTransparency = 1
	header.Text = ""
	header.AutoButtonColor = false
	header.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -34, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Font = currentGlobalFont
	label.TextColor3 = currentTextColor
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = header
	table.insert(allTextLabels, label)
	local headerIcon = Instance.new("ImageLabel")
	headerIcon.Name = "DropdownOptionIcon"
	headerIcon.Size = UDim2.new(0, 16, 0, 16)
	headerIcon.Position = UDim2.new(0, 9, 0.5, -8)
	headerIcon.BackgroundTransparency = 1
	headerIcon.Visible = false
	headerIcon.ScaleType = Enum.ScaleType.Fit
	headerIcon.Parent = header
	table.insert(themeImages, headerIcon)
	local function applyHeaderIcon(icon)
		state.icon = icon
		if type(icon) == "table" and icon.Image then
			headerIcon.Image = icon.Image
			headerIcon.ImageColor3 = currentThemeColor
			headerIcon.ImageRectOffset = icon.Offset or Vector2.new(0, 0)
			headerIcon.ImageRectSize = icon.RectSize or Vector2.new(0, 0)
			headerIcon.Visible = true
			label.Position = UDim2.new(0, 31, 0, 0)
			label.Size = UDim2.new(1, -55, 1, 0)
		else
			headerIcon.Visible = false
			label.Position = UDim2.new(0, 10, 0, 0)
			label.Size = UDim2.new(1, -34, 1, 0)
		end
	end
	applyHeaderIcon(state.icon)

	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.new(0, 18, 1, 0)
	arrow.Position = UDim2.new(1, -24, 0, 0)
	arrow.BackgroundTransparency = 1
	arrow.Font = Enum.Font.GothamBold
	arrow.Text = "▼"
	arrow.TextColor3 = currentThemeColor
	arrow.TextSize = 10
	arrow.Parent = header
	table.insert(themeTexts, arrow)

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.new(0, 6, 0, HEADER + GAP)
	list.Size = UDim2.new(1, -12, 0, ROW)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 3
	list.ScrollBarImageColor3 = currentThemeColor
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.Parent = frame
	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 2)
	listLayout.Parent = list

	local function setLabelText()
		label.Text = (cfg.prefix or "") .. (state.label or cfg.placeholder or "Selecione")
	end
	setLabelText()

	local function openHeight()
		local rows = math.max(1, math.min(#state.options, cfg.maxRows or 5))
		return HEADER + GAP + rows * ROW + 6, rows * ROW
	end

	local close
	local function build()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("GuiObject") then child:Destroy() end
		end
		state.options = (cfg.getOptions and cfg.getOptions()) or {}
		if #state.options == 0 then
			local empty = Instance.new("TextLabel")
			empty.Size = UDim2.new(1, -6, 0, ROW - 2)
			empty.BackgroundTransparency = 1
			empty.Font = currentGlobalFont
			empty.Text = "Nenhuma opção encontrada."
			empty.TextColor3 = Color3.fromRGB(150, 150, 170)
			empty.TextSize = 10
			empty.Parent = list
		end
		for index, opt in ipairs(state.options) do
			local selected = state.value ~= nil and opt.value == state.value
			local b = Instance.new("TextButton")
			b.LayoutOrder = index
			b.Size = UDim2.new(1, -6, 0, ROW - 2)
			b.BackgroundColor3 = selected and currentThemeColor or Color3.fromRGB(40, 40, 58)
			b.BackgroundTransparency = selected and 0.35 or 0.2
			b.BorderSizePixel = 0
			b.AutoButtonColor = false
			b.Font = opt.font or currentGlobalFont
			b.Text = opt.label
			b.TextColor3 = currentTextColor
				b.TextSize = 10
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.Parent = list
				if not opt.font then table.insert(allTextLabels, b) end
				if type(opt.icon) == "table" and opt.icon.Image then
					b.Text = ""
					local optionIcon = Instance.new("ImageLabel")
					optionIcon.Name = "DropdownOptionIcon"
					optionIcon.Size = UDim2.new(0, 14, 0, 14)
					optionIcon.Position = UDim2.new(0, 8, 0.5, -7)
					optionIcon.BackgroundTransparency = 1
					optionIcon.Image = opt.icon.Image
					optionIcon.ImageRectOffset = opt.icon.Offset or Vector2.new(0, 0)
					optionIcon.ImageRectSize = opt.icon.RectSize or Vector2.new(0, 0)
					optionIcon.ImageColor3 = currentThemeColor
					optionIcon.ScaleType = Enum.ScaleType.Fit
					optionIcon.Parent = b
					table.insert(themeImages, optionIcon)
					local optionLabel = Instance.new("TextLabel")
					optionLabel.Size = UDim2.new(1, -32, 1, 0)
					optionLabel.Position = UDim2.new(0, 28, 0, 0)
					optionLabel.BackgroundTransparency = 1
					optionLabel.Font = opt.font or currentGlobalFont
					optionLabel.Text = opt.label
					optionLabel.TextColor3 = currentTextColor
					optionLabel.TextSize = 10
					optionLabel.TextXAlignment = Enum.TextXAlignment.Left
					optionLabel.TextTruncate = Enum.TextTruncate.AtEnd
					optionLabel.Parent = b
					if not opt.font then table.insert(allTextLabels, optionLabel) end
				end
			local bc = Instance.new("UICorner")
			bc.CornerRadius = UDim.new(0, 5)
			bc.Parent = b
			local bp = Instance.new("UIPadding")
			bp.PaddingLeft = UDim.new(0, 8)
			bp.Parent = b
			b.MouseEnter:Connect(function()
				if not (state.value ~= nil and opt.value == state.value) then
					TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(54, 54, 76)}):Play()
				end
			end)
			b.MouseLeave:Connect(function()
				if not (state.value ~= nil and opt.value == state.value) then
					TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(40, 40, 58)}):Play()
				end
			end)
			b.MouseButton1Click:Connect(function()
					state.value = opt.value
					state.label = opt.label
					applyHeaderIcon(opt.icon)
					setLabelText()
				close()
				if cfg.onSelect then cfg.onSelect(opt.value, opt) end
			end)
		end
		local total, viewH = openHeight()
		list.Size = UDim2.new(1, -12, 0, viewH)
		list.CanvasSize = UDim2.new(0, 0, 0, math.max(#state.options, 1) * ROW)
	end

	local function setOpen(open)
		state.open = open
		TweenService:Create(arrow, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {Rotation = open and 180 or 0}):Play()
		TweenService:Create(frameStroke, TweenInfo.new(0.2), {
			Color = open and currentThemeColor or GRAYSTROKE, Transparency = open and 0.2 or 0.55
		}):Play()
		if open then build() end
		local target = open and (openHeight()) or HEADER
		TweenService:Create(frame, TweenInfo.new(open and 0.28 or 0.2, open and Enum.EasingStyle.Quint or Enum.EasingStyle.Quad,
			open and Enum.EasingDirection.Out or Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, target)}):Play()
	end
	close = function() if state.open then setOpen(false) end end

	header.MouseEnter:Connect(function()
		TweenService:Create(frame, TweenInfo.new(0.12), {BackgroundTransparency = 0.15}):Play()
	end)
	header.MouseLeave:Connect(function()
		TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundTransparency = 0.35}):Play()
	end)
	header.MouseButton1Click:Connect(function() setOpen(not state.open) end)
	table.insert(AetherisThemeHooks, function(color)
		if not frame.Parent then return end
		list.ScrollBarImageColor3 = color
		if state.open then
			frameStroke.Color = color
			build()
		end
	end)

	return {
		frame = frame,
		close = close,
			setValue = function(value, text, icon)
				state.value = value
				state.label = text
				applyHeaderIcon(icon)
				setLabelText()
		end,
	}
end

local configBindings = {}
local configBindingCounts = {}
local function registerConfigBinding(parent, name, getter, setter)
    local section = parent and parent.Parent or nil
    local sectionTitle = "Geral"
    if section then
        for _, child in ipairs(section:GetChildren()) do
            if child:IsA("TextLabel") then
                sectionTitle = child.Text
                break
            end
        end
    end
	local page = section and section.Parent or nil
	local pageName = page and page.Name or "Page"
	-- O título visível mudou para Baú; mantenha as chaves antigas dos presets.
	if pageName == "Farming" and sectionTitle == "Baú" then
		sectionTitle = "Automação"
	end
	local baseKey = pageName .. "|" .. sectionTitle .. "|" .. name
    configBindingCounts[baseKey] = (configBindingCounts[baseKey] or 0) + 1
    local key = baseKey
    if configBindingCounts[baseKey] > 1 then
        key = baseKey .. " #" .. tostring(configBindingCounts[baseKey])
    end
    table.insert(configBindings, {key = key, getter = getter, setter = setter})
    return key
end

local function updateGlobalTheme(newColor)
	currentThemeColor = newColor
	
	for _, data in pairs(themeToggles) do
		if data.isToggled and data.circle and data.button and data.led then
			TweenService:Create(data.circle, TweenInfo.new(0.18), {Position = UDim2.new(1, -14, 0.5, -6)}):Play()
			TweenService:Create(data.button, TweenInfo.new(0.18), {BackgroundColor3 = newColor}):Play()
			TweenService:Create(data.led, TweenInfo.new(0.18), {BackgroundColor3 = newColor}):Play()
		end
	end

	for _, secStroke in pairs(themeSections) do
		secStroke.Color = newColor
	end

	for _, themedText in pairs(themeTexts) do
		if themedText and themedText.Parent then
			themedText.TextColor3 = newColor
		end
	end

	for _, themedImage in pairs(themeImages) do
		if themedImage and themedImage.Parent then
			themedImage.ImageColor3 = newColor
		end
	end

	for _, fill in pairs(themeSliders) do
		fill.BackgroundColor3 = newColor
	end

	for _, line in pairs(resizeSymbolsLines) do
		line.BackgroundColor3 = newColor
	end

	for _, subLabel in pairs(headerSubtitles) do
		subLabel.TextColor3 = newColor
	end

	for _, ind in pairs(tabIndicators) do
		ind.BackgroundColor3 = newColor
	end

	for _, part in pairs(themeParticles) do
		if part and part.Parent then
			part.BackgroundColor3 = newColor
		end
	end

	for _, hook in pairs(AetherisThemeHooks) do
		pcall(hook, newColor)
	end
end

local function updateGlobalTextFont(newFont)
	currentGlobalFont = newFont
	for _, txtObj in pairs(allTextLabels) do
		if txtObj and txtObj.Parent then
			pcall(function()
				txtObj.Font = newFont
			end)
		end
	end
end

local function updateGlobalTextColor(newColor)
	currentTextColor = newColor
	for _, txtObj in pairs(allTextLabels) do
		if txtObj and txtObj.Parent and (txtObj:IsA("TextLabel") or txtObj:IsA("TextButton") or txtObj:IsA("TextBox")) then
			pcall(function()
				txtObj.TextColor3 = newColor
			end)
		end
	end
end

