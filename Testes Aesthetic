	-- e usa o primeiro atributo dele como nome da berry. Tudo fica dentro deste bloco
	-- para não criar variáveis locais novas no nível superior do script.
	do
		local berryEspEnabled = false
		local berryEspName = false
		local berryEspDistance = false
		local berryEspDistanceColor = Color3.fromRGB(200, 200, 200)
		local berryEspObjects = {}

		local function getBerryPart(target)
			if target:IsA("BasePart") then return target end
			if target:IsA("Model") then
				return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
			end
			return nil
		end

		-- Cor do nome conforme o tipo da berry (texto do atributo): Red, Orange, Blue, Green...
		local function getBerryColor(text)
			local lowerName = string.lower(tostring(text))
			if string.find(lowerName, "green", 1, true) then
				return Color3.fromRGB(0, 255, 0)
			elseif string.find(lowerName, "yellow", 1, true) then
				return Color3.fromRGB(255, 255, 0)
			elseif string.find(lowerName, "red", 1, true) then
				return Color3.fromRGB(255, 0, 0)
			elseif string.find(lowerName, "blue", 1, true) then
				return Color3.fromRGB(0, 150, 255)
			elseif string.find(lowerName, "orange", 1, true) then
				return Color3.fromRGB(255, 140, 0)
			elseif string.find(lowerName, "purple", 1, true) then
				return Color3.fromRGB(180, 50, 255)
			end
			return Color3.fromRGB(255, 255, 255)
		end

		local function makeBerryLabel(parent, name, size, position, fontSize)
			local label = Instance.new("TextLabel")
			label.Name = name
			label.Size = size
			label.Position = position
			label.BackgroundTransparency = 1
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextStrokeColor3 = Color3.new(0, 0, 0)
			label.TextStrokeTransparency = 0.25
			label.Font = currentGlobalFont
			label.TextSize = fontSize
			label.TextWrapped = false
			label.TextTruncate = Enum.TextTruncate.AtEnd
			label.TextXAlignment = Enum.TextXAlignment.Center
			label.Parent = parent
			return label
		end

		local function createBerryESP(target, part, text)
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "AetherisBerryInfo"
			billboard.Adornee = part
			billboard.Size = UDim2.fromOffset(150, 34)
			billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
			billboard.AlwaysOnTop = true
			billboard.LightInfluence = 0
			billboard.Enabled = false
			billboard.Parent = screenGui

			local nameLabel = makeBerryLabel(billboard, "BerryName", UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 0), 12)
			nameLabel.Text = text
			local distanceLabel = makeBerryLabel(billboard, "BerryDistance", UDim2.new(1, 0, 0, 15), UDim2.fromOffset(0, 18), 10)

			berryEspObjects[target] = {
				billboard = billboard,
				part = part,
				nameLabel = nameLabel,
				distanceLabel = distanceLabel,
				text = text,
				color = getBerryColor(text),
				lastDistance = nil,
			}
		end

		local function removeBerryESP(target)
			local data = berryEspObjects[target]
			if not data then return end
			if data.billboard then data.billboard:Destroy() end
			berryEspObjects[target] = nil
		end

		local function clearBerryESP()
			for target in pairs(berryEspObjects) do removeBerryESP(target) end
		end

		-- Varredura periódica: cria/remove os ESPs conforme as berries aparecem no mapa.
		task.spawn(function()
			while screenGui.Parent do
				task.wait(0.5)
				if berryEspEnabled then
					local mapFolder = workspace:FindFirstChild("Map")
					if mapFolder then
						local found = {}
						for _, child in ipairs(mapFolder:GetDescendants()) do
							if string.sub(child.Name, 1, 1) == "{" then
								local berries = child:FindFirstChild("Berries")
								if berries then
									local _, attrValue = next(berries:GetAttributes())
									if attrValue ~= nil then
										found[child] = true
										local text = tostring(attrValue)
										local data = berryEspObjects[child]
										if data then
											data.text = text
											data.color = getBerryColor(text)
										else
											local part = getBerryPart(child)
											if part then createBerryESP(child, part, text) end
										end
									end
								end
							end
						end
						for target in pairs(berryEspObjects) do
							if not found[target] or not target.Parent then removeBerryESP(target) end
						end
					else
						clearBerryESP()
					end
				else
					clearBerryESP()
				end
			end
		end)

