		gui.Size = UDim2.fromOffset(popW, 0)
		gui.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
		gui.BackgroundTransparency = 0
		gui.BorderSizePixel = 0
		gui.ClipsDescendants = true
		gui.ZIndex = 60
		gui.Parent = screenGui
		pop.gui = gui
		local gCorner = Instance.new("UICorner")
		gCorner.CornerRadius = UDim.new(0, 9)
		gCorner.Parent = gui
		pop.stroke = Instance.new("UIStroke")
		pop.stroke.Color = currentThemeColor
		pop.stroke.Transparency = 0.45
		pop.stroke.Thickness = 1
		pop.stroke.Parent = gui

		local search = Instance.new("TextBox")
		search.Size = UDim2.new(1, -8, 0, SEARCH_H)
		search.Position = UDim2.new(0, 4, 0, PAD)
		search.BackgroundColor3 = Color3.fromRGB(21, 21, 30)
		search.BorderSizePixel = 0
		search.Font = currentGlobalFont
