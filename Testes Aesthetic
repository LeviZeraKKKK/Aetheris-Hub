local activeObservationInstance = nil
local originalObservationRadius = nil
local observationRoot = nil
local lastObservationPosition = Vector3.zero

local function bindObservationInstance(instance)
	if not instance then return end
	if activeObservationInstance ~= instance then
		activeObservationInstance = instance
		originalObservationRadius = instance.radius
	end
	if _G_InfiniteKenEnabled then
		pcall(function() instance.radius = math.huge end)
	end
end

local function setInfiniteObservationEnabled(state)
	_G_InfiniteKenEnabled = state
	if activeObservationInstance then
		pcall(function()
			if state then
				activeObservationInstance.radius = math.huge
			else
				activeObservationInstance.radius = originalObservationRadius
			end
		end)
	end
end

local function updateObservationRoot()
	local character = player.Character
	observationRoot = character and character:FindFirstChild("HumanoidRootPart") or nil
	if observationRoot then lastObservationPosition = observationRoot.Position end
end

