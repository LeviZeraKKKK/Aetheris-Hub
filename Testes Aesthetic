		ringStroke.Transparency = 0.15
		ringStroke.Parent = ring
		TweenService:Create(ring, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 110, 0, 110)}):Play()
		TweenService:Create(ringStroke, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1, Thickness = 0.5}):Play()
		task.delay(0.6, function() ring:Destroy() end)
	end

	local function toggleMinimizePanel()
		if panelAnimating then return end
		panelAnimating = true

		if mainPanel.Visible then
			-- ===== MINIMIZAR =====
			currentPanelSize = mainPanel.Size
			savedPanelPosition = mainPanel.Position
			local target = floatingCenter(40)
			local dur = 0.46
			local flyInfo = TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
			TweenService:Create(mainPanel, flyInfo, {
				Position = UDim2.fromOffset(target.X, target.Y)
			}):Play()
			TweenService:Create(panelAnimScale, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.04}):Play()
			TweenService:Create(mainPanel, TweenInfo.new(dur * 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
			TweenService:Create(panelStroke, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Transparency = 1}):Play()

			-- o botão surge um pouco antes do painel terminar de chegar
			task.delay(dur * 0.72, function()
				floatingBtn.Size = UDim2.new(0, 0, 0, 0)
				floatingBtn.Visible = true
				TweenService:Create(floatingBtn, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 40, 0, 40)}):Play()
				rippleAt(target, currentThemeColor)
			end)

			task.wait(dur)
			mainPanel.Visible = false
			-- restaura os valores para a próxima abertura
			panelAnimScale.Scale = 1
			mainPanel.Position = savedPanelPosition
			mainPanel.BackgroundTransparency = panelTransparencyValue
			panelStroke.Transparency = 0.25
		else
			-- ===== MAXIMIZAR =====
			local from = floatingCenter(40)
			local target = savedPanelPosition or mainPanel.Position
			local dur = 0.55
			-- o botão encolhe enquanto o painel já está nascendo dele
			TweenService:Create(floatingBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
			task.delay(0.2, function() floatingBtn.Visible = false end)
			rippleAt(from, currentThemeColor)

			panelAnimScale.Scale = 0.04
			mainPanel.Position = UDim2.fromOffset(from.X, from.Y)
			mainPanel.BackgroundTransparency = 1
			panelStroke.Transparency = 1
			panelStroke.Thickness = 4
			mainPanel.Size = currentPanelSize
			mainPanel.Visible = true

			TweenService:Create(mainPanel, TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Position = target
			}):Play()
			TweenService:Create(panelAnimScale, TweenInfo.new(dur, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0), {Scale = 1}):Play()
			TweenService:Create(mainPanel, TweenInfo.new(dur * 0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {BackgroundTransparency = panelTransparencyValue}):Play()
			TweenService:Create(panelStroke, TweenInfo.new(dur * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Transparency = 0.25, Thickness = 1.6}):Play()
			task.wait(dur)
		end

		panelAnimating = false
	end

