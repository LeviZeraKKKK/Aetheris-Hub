	function ColorPicker.toHex(color)
		return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
	end

	function ColorPicker.parseHex(text)
		local hex = string.match(text or "", "^%s*#?(%x+)%s*$")
		if not hex then return nil end
		if #hex == 3 then
			hex = string.rep(string.sub(hex, 1, 1), 2) .. string.rep(string.sub(hex, 2, 2), 2) .. string.rep(string.sub(hex, 3, 3), 2)
		end
		if #hex ~= 6 then return nil end
		return Color3.fromRGB(tonumber(string.sub(hex, 1, 2), 16), tonumber(string.sub(hex, 3, 4), 16), tonumber(string.sub(hex, 5, 6), 16))
	end

	-- colorBtn: botao pequeno que mostra a cor | title: nome exibido no popup
	-- onChange(color3): chamado sempre que a cor muda
	-- Retorna {get, set, animateTo, open, close}
	function ColorPicker.create(colorBtn, title, defaultColor, onChange)
		local guiService = game:GetService("GuiService")
		local state = {h = 0, s = 0, v = 0, original = defaultColor, open = false}
		state.h, state.s, state.v = defaultColor:ToHSV()
		local ui = nil
		local conns = {}
		local pulseTween, sweepTween = nil, nil
		local animValue = nil
		local dragMode = nil
		local picker = {}

		colorBtn.BackgroundColor3 = defaultColor
		local btnStroke = Instance.new("UIStroke")
		btnStroke.Color = Color3.new(1, 1, 1)
		btnStroke.Transparency = 0.75
		btnStroke.Thickness = 1
		btnStroke.Parent = colorBtn

		local function currentColor()
			return Color3.fromHSV(state.h, state.s, state.v)
		end
		picker.get = currentColor

		local function applyVisuals()
			local color = currentColor()
			colorBtn.BackgroundColor3 = color
			if not ui then return end
			local pureHue = Color3.fromHSV(state.h, 1, 1)
			ui.canvas.BackgroundColor3 = pureHue
			ui.hueThumb.BackgroundColor3 = pureHue
			ui.hueThumb.Position = UDim2.new(0.5, 0, state.h, 0)
			ui.cursorShadow.Position = UDim2.new(state.s, 0, 1 - state.v, 0)
			ui.cursorFill.BackgroundColor3 = color
			ui.newHalf.BackgroundColor3 = color
			if not ui.hexBox:IsFocused() then ui.hexBox.Text = ColorPicker.toHex(color) end
			for _, sw in ipairs(ui.swatches) do
				local c = sw.color
				local diff = math.abs(c.R - color.R) + math.abs(c.G - color.G) + math.abs(c.B - color.B)
				sw.stroke.Transparency = diff < 0.03 and 0 or 1
			end
		end

		local function commit()
			applyVisuals()
			onChange(currentColor())
		end

		-- Troca a cor na hora (usado pelos presets salvos e pelo HEX/arrasto)
		function picker.set(color)
			if typeof(color) ~= "Color3" then return end
			local h, s, v = color:ToHSV()
			if s < 0.001 or v < 0.001 then h = state.h end -- mantem o matiz em tons de cinza
			if v < 0.001 then s = state.s end
			state.h, state.s, state.v = h, s, v
			commit()
		end

		-- Troca a cor com transicao suave (cores rapidas, HEX, desfazer)
		function picker.animateTo(color)
			if typeof(color) ~= "Color3" then return end
			local from = currentColor()
			local alpha = Instance.new("NumberValue")
			alpha.Parent = screenGui
			if animValue then animValue:Destroy() end
			animValue = alpha
			alpha.Changed:Connect(function(a)
				if animValue ~= alpha then return end
				picker.set(from:Lerp(color, a))
			end)
			local t = ColorPicker.tween(alpha, 0.28, {Value = 1})
			t.Completed:Connect(function()
				if animValue == alpha then animValue = nil end
				alpha:Destroy()
			end)
		end

		local function isInside(guiObject, p)
			local pos, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
			return p.X >= pos.X and p.X <= pos.X + size.X and p.Y >= pos.Y and p.Y <= pos.Y + size.Y
		end

		local function reposition()
			local screen = screenGui.AbsoluteSize
			local scale = ui.baseScale
			local w, h = ColorPicker.width * scale, ColorPicker.height * scale
			local bp, bs = colorBtn.AbsolutePosition, colorBtn.AbsoluteSize
			local x = math.clamp(bp.X + bs.X - w, 8, math.max(8, screen.X - w - 8))
			local y = bp.Y + bs.Y + 6
			if y + h > screen.Y - 8 then y = math.max(8, bp.Y - h - 6) end
			ui.modal.Position = UDim2.fromOffset(x + w / 2, y)
		end

		local inputOffset = Vector2.new(0, 0)
		local function updateFromInput(position)
			local p = Vector2.new(position.X, position.Y) + inputOffset
			if dragMode == "sv" then
				local x = math.clamp((p.X - ui.canvas.AbsolutePosition.X) / ui.canvas.AbsoluteSize.X, 0, 1)
				local y = math.clamp((p.Y - ui.canvas.AbsolutePosition.Y) / ui.canvas.AbsoluteSize.Y, 0, 1)
				state.s, state.v = x, 1 - y
			elseif dragMode == "hue" then
				state.h = math.clamp((p.Y - ui.hueBar.AbsolutePosition.Y) / ui.hueBar.AbsoluteSize.Y, 0, 1)
			end
			commit()
		end

