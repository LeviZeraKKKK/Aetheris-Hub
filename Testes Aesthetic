		bCorner.Parent = bar

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
		fill.BackgroundColor3 = Color3.new(1, 1, 1)
		fill.BorderSizePixel = 0
		fill.Parent = bar
		AetherisBlueGradient(fill, 0)

		local fCorner = Instance.new("UICorner")
		fCorner.CornerRadius = UDim.new(1, 0)
		fCorner.Parent = fill

		local knob = Instance.new("Frame")
		knob.Name = "SliderKnob"
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Size = UDim2.new(0, 10, 0, 10)
		knob.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
		knob.BackgroundColor3 = Color3.new(1, 1, 1)
		knob.BorderSizePixel = 0
		knob.ZIndex = 5
		knob.Parent = bar
		local kCorner = Instance.new("UICorner")
		kCorner.CornerRadius = UDim.new(1, 0)
		kCorner.Parent = knob
		local kStroke = Instance.new("UIStroke")
		kStroke.Color = currentThemeColor
		kStroke.Thickness = 1.5
		kStroke.Parent = knob
		table.insert(themeSections, kStroke)
		local bubble = Instance.new("TextLabel")
		bubble.Name = "SliderBubble"
		bubble.AnchorPoint = Vector2.new(0.5, 1)
		bubble.Size = UDim2.new(0, 40, 0, 14)
		bubble.Position = UDim2.new(0.5, 0, 0, -6)
		bubble.BackgroundColor3 = Color3.fromRGB(12, 14, 22)
		bubble.BackgroundTransparency = 1
		bubble.TextTransparency = 1
		bubble.Font = Enum.Font.GothamBold
		bubble.TextSize = 9
		bubble.TextColor3 = Color3.new(1, 1, 1)
		bubble.Text = ""
		bubble.ZIndex = 6
		bubble.Parent = knob
		local bbCorner = Instance.new("UICorner")
		bbCorner.CornerRadius = UDim.new(0, 5)
		bbCorner.Parent = bubble
		local function showBubble(on)
			TweenService:Create(knob, TweenInfo.new(0.12), {Size = on and UDim2.new(0, 14, 0, 14) or UDim2.new(0, 10, 0, 10)}):Play()
			TweenService:Create(bubble, TweenInfo.new(0.12), {BackgroundTransparency = on and 0.05 or 1, TextTransparency = on and 0 or 1}):Play()
		end
		local draggingSlider = false
		local currentValue = default
		local function setSliderValue(value)
			value = math.clamp(tonumber(value) or default, min, max)
			if decimals and decimals > 0 then
				local factor = 10 ^ decimals
				value = math.floor(value * factor + 0.5) / factor
			else
				value = math.floor(value + 0.5)
			end
			currentValue = value
			fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
			knob.Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0)
			bubble.Text = formatSliderValue(value)
			label.Text = name .. ": " .. formatSliderValue(value)
			callback(value)
		end
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = true showBubble(true) end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				if draggingSlider then showBubble(false) end
				draggingSlider = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
				local rawValue = min + (max - min) * pos
				local val
				if decimals and decimals > 0 then
					local factor = 10 ^ decimals
					val = math.floor(rawValue * factor + 0.5) / factor
				else
					val = math.floor(rawValue)
				end
				setSliderValue(val)
			end
		end)
		registerConfigBinding(parent, name, function() return currentValue end, setSliderValue)
	end

