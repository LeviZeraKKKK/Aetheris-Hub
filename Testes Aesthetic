	local function toggleMinimizePanel()
		if panelAnimating then return end
		panelAnimating = true

		if mainPanel.Visible then
			-- ===== MINIMIZAR =====
			currentPanelSize = mainPanel.Size
			savedPanelPosition = mainPanel.Position
			local target = AetherisMinimize.center()
			local A = AetherisMinimize.animCfg[AetherisMinimize.anim] or AetherisMinimize.animCfg.Voar
			local dur = A.minDur
			local flyInfo = TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
			local posTo = UDim2.fromOffset(target.X, target.Y)
			if not A.fly then
				posTo = UDim2.new(savedPanelPosition.X.Scale, savedPanelPosition.X.Offset, savedPanelPosition.Y.Scale, savedPanelPosition.Y.Offset + A.slide)
			end
			if A.fly or A.slide > 0 then
				TweenService:Create(mainPanel, flyInfo, {Position = posTo}):Play()
			end
			TweenService:Create(panelAnimScale, TweenInfo.new(dur, A.minStyle, Enum.EasingDirection.In), {Scale = A.scale}):Play()
			TweenService:Create(mainPanel, TweenInfo.new(dur * 0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
			TweenService:Create(panelStroke, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Transparency = 1}):Play()

			-- o botão surge um pouco antes do painel terminar de chegar
			task.delay(dur * 0.72, function()
				if AetherisMinimize.mode == "Barra" then
					AetherisMinimize.showBar()
				else
					floatingBtn.Size = UDim2.new(0, 0, 0, 0)
					floatingBtn.Visible = true
					TweenService:Create(floatingBtn, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 40, 0, 40)}):Play()
				end
				rippleAt(target, currentThemeColor)
			end)

			task.wait(dur)
			mainPanel.Visible = false
			-- restaura os valores para a próxima abertura
			panelAnimScale.Scale = 1
			mainPanel.Position = savedPanelPosition
			mainPanel.BackgroundTransparency = panelTransparencyValue
			panelStroke.Transparency = 0.45
		else
			-- ===== MAXIMIZAR =====
			local from = AetherisMinimize.center()
			local target = savedPanelPosition or mainPanel.Position
			local A = AetherisMinimize.animCfg[AetherisMinimize.anim] or AetherisMinimize.animCfg.Voar
			local dur = A.maxDur
			-- o botão encolhe enquanto o painel já está nascendo dele
			if AetherisMinimize.mode == "Barra" then
				AetherisMinimize.hideBar()
			else
				TweenService:Create(floatingBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
				task.delay(0.2, function() floatingBtn.Visible = false end)
			end
			rippleAt(from, currentThemeColor)

			panelAnimScale.Scale = A.scale
			if A.fly then
				mainPanel.Position = UDim2.fromOffset(from.X, from.Y)
			else
				mainPanel.Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + A.slide)
			end
			mainPanel.BackgroundTransparency = 1
			panelStroke.Transparency = 1
			panelStroke.Thickness = 4
			-- Garante que o painel caiba na tela e que a lista de abas apareça inteira (ou role).
			do
				local vs = screenGui.AbsoluteSize
				local cw = math.clamp(currentPanelSize.X.Offset, 340, math.max(340, vs.X - 16))
				local ch = math.clamp(math.max(currentPanelSize.Y.Offset, 310), 210, math.max(210, vs.Y - 16))
				currentPanelSize = UDim2.new(0, cw, 0, ch)
				local tp = target
				local px = math.clamp(tp.X.Scale * vs.X + tp.X.Offset, cw / 2 + 4, math.max(cw / 2 + 4, vs.X - cw / 2 - 4))
				local py = math.clamp(tp.Y.Scale * vs.Y + tp.Y.Offset, ch / 2 + 4, math.max(ch / 2 + 4, vs.Y - ch / 2 - 4))
				target = UDim2.fromOffset(px, py)
				savedPanelPosition = target
			end
			mainPanel.Size = currentPanelSize
			mainPanel.Visible = true

			TweenService:Create(mainPanel, TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Position = target
			}):Play()
			TweenService:Create(panelAnimScale, TweenInfo.new(dur, A.maxStyle, Enum.EasingDirection.Out, 0, false, 0), {Scale = 1}):Play()
			TweenService:Create(mainPanel, TweenInfo.new(dur * 0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {BackgroundTransparency = panelTransparencyValue}):Play()
			TweenService:Create(panelStroke, TweenInfo.new(dur * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Transparency = 0.45, Thickness = 1}):Play()
			task.wait(dur)
		end

		panelAnimating = false
	end

