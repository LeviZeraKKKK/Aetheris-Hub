-- Altura do conteúdo de um UIListLayout em pixels LOCAIS (sem o UIScale do painel).
-- O AbsoluteContentSize vem multiplicado pela escala quando o painel é redimensionado, o que
-- deixava seções grandes demais (espaço sobrando) ou pequenas demais (toggles se sobrepondo).
function AetherisLayoutHeight(layout)
	local container = layout.Parent
	if not container then return layout.AbsoluteContentSize.Y end
	local total, count = 0, 0
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			if child.Size.Y.Scale ~= 0 or child.AutomaticSize ~= Enum.AutomaticSize.None then
				return layout.AbsoluteContentSize.Y
			end
			total = total + child.Size.Y.Offset
			count = count + 1
		end
	end
	return total + layout.Padding.Offset * math.max(count - 1, 0)
end

