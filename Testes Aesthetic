				if target == "" then return nil end
				for _, e in ipairs(Q.scanSpawns()) do
					if cleanBossName(e.name) == target then return e.pos end
				end
				for _, e in ipairs(Q.scanSpawns()) do
					local en = cleanBossName(e.name)
					if en ~= "" and (en:find(target, 1, true) or target:find(en, 1, true)) then
						return e.pos
					end
				end
				-- não está na lista agora (streaming/renomeado): usa a última posição conhecida
				if Q.known then
					if Q.known[target] then return Q.known[target] end
					for kn, kp in pairs(Q.known) do
						if kn ~= "" and (kn:find(target, 1, true) or target:find(kn, 1, true)) then return kp end
					end
				end
				return nil
