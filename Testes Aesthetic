local chestEspObjects = {}
local function isChestName(name)
    local lowerName = string.lower(name or "")
    return lowerName:find("baú", 1, true) ~= nil
        or lowerName:find("bau", 1, true) ~= nil
        or lowerName:find("chest", 1, true) ~= nil
end
local function getChestPart(target)
    if target:IsA("BasePart") then return target end
    if target:IsA("Model") then
        return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end
local function getChestTarget(instance)
    local current = instance
    for _ = 1, 4 do
        if not current or current == workspace then break end
        if current:IsA("Model") and isChestName(current.Name) then return current end
        current = current.Parent
    end
    if instance:IsA("BasePart") and isChestName(instance.Name) then return instance end
    return nil
end
local function createChestESP(target)
    if chestEspObjects[target] then return end
    local part = getChestPart(target)
    if not part then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "AetherisChestHighlight"
    highlight.Adornee = target
    highlight.FillColor = chestEspChamsColor
    highlight.OutlineColor = chestEspChamsColor
    highlight.FillTransparency = 0.55
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = screenGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AetherisChestInfo"
    billboard.Adornee = part
    billboard.Size = UDim2.fromOffset(150, 34)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Enabled = false
    billboard.Parent = screenGui
    local nameLabel = makeEnemyText(billboard, "ChestName", UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 0), 12)
    nameLabel.Text = "Baú"
    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    local distanceLabel = makeEnemyText(billboard, "ChestDistance", UDim2.new(1, 0, 0, 15), UDim2.fromOffset(0, 18), 10)
    distanceLabel.TextXAlignment = Enum.TextXAlignment.Center
    chestEspObjects[target] = {highlight = highlight, billboard = billboard, nameLabel = nameLabel, distanceLabel = distanceLabel}
end
local function removeChestESP(target)
    local data = chestEspObjects[target]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    chestEspObjects[target] = nil
end
-- ESP Baú otimizado:
--  * só cria os objetos (Highlight/Billboard) se o ESP estiver ligado E algum efeito (Chams/Nome/Distância) ativo;
--  * a busca de baús é feita em fatias (sem travar) e em intervalos longos, guardando o resultado;
--  * o modo "Limitar por alcance" só cria ESP para os baús dentro do alcance;
--  * o Highlight é limitado aos 30 baús mais próximos (o Roblox nem desenha mais que isso);
--  * a atualização por frame virou ~10 vezes por segundo e só escreve o que mudou.
AetherisChestCfg = AetherisChestCfg or {rangeOn = false, range = 500}
AetherisChestCfg.mode = AetherisChestCfg.mode or "ChestModels" -- "ChestModels" (Baús próximos) ou "Map" (mapa todo)
AetherisChestCfg.rangeOn = false -- alcance removido do menu
do -- bloco próprio: não gasta variáveis locais do nível superior
local chestKnown = {main = {}, map = {}}
local chestScanAt = {main = 0, map = 0}
-- Modo ChestModels: cada filho da pasta é um baú (Diamond, Gold...). O rótulo vira "[Diamond] Chest"
-- com a cor do tipo; tipos desconhecidos usam o nome do filho e a cor padrão do nome.
local chestTiers = {
    {key = "fragment", name = "Fragment", color = Color3.fromRGB(170, 90, 255)},
    {key = "diamond", name = "Diamond", color = Color3.fromRGB(70, 170, 255)},
    {key = "gold", name = "Gold", color = Color3.fromRGB(255, 200, 50)},
    {key = "silver", name = "Silver", color = Color3.fromRGB(205, 210, 222)},
    {key = "bronze", name = "Bronze", color = Color3.fromRGB(205, 127, 50)},
    {key = "copper", name = "Copper", color = Color3.fromRGB(205, 127, 50)},
    {key = "emerald", name = "Emerald", color = Color3.fromRGB(70, 220, 120)},
    {key = "ruby", name = "Ruby", color = Color3.fromRGB(235, 70, 80)},
}
local function chestTierInfo(instanceName)
    local lower = string.lower(instanceName or "")
    for _, tier in ipairs(chestTiers) do
        if lower:find(tier.key, 1, true) then return "[" .. tier.name .. "] Chest", tier.color end
    end
    local clean = (instanceName or ""):gsub("[Cc]hest", ""):gsub("[Mm]odel", ""):gsub("[_%-%d]+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" then clean = "Normal" end
    return "[" .. clean .. "] Chest", nil
end
local function scanChestModels(root)
    local found = {}
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            if getChestPart(child) then found[child] = true end
        elseif child:IsA("Folder") then
            for _, inner in ipairs(child:GetChildren()) do
                if (inner:IsA("Model") or inner:IsA("BasePart")) and getChestPart(inner) then found[inner] = true end
            end
        end
    end
    return found
end
local function scanChestRoot(root)
    local found = {}
    local count = 0
    for _, instance in ipairs(root:GetDescendants()) do
        count = count + 1
        if count % 1500 == 0 then task.wait() end
        if isChestName(instance.Name) then
            local target = getChestTarget(instance)
            if target and target:IsDescendantOf(root) and getChestPart(target) then found[target] = true end
        end
    end
    return found
end
task.spawn(function()
    while screenGui.Parent do
        task.wait(1)
        local cfg = AetherisChestCfg
        local active = chestEspEnabled and (chestEspChams or chestEspName or chestEspDistance)
        if not active then
            for target in pairs(chestEspObjects) do removeChestESP(target) end
        else
            -- Dois modos: "ChestModels" (só a pasta workspace.ChestModels, leve, com nome por tipo)
            -- e "Map" (procura baús dentro do Map, busca bem mais espaçada porque é grande).
            if cfg.mode == "Map" then
                chestKnown.main = {}
                local mapRoot = workspace:FindFirstChild("Map") or map
                if not mapRoot or mapRoot == workspace then mapRoot = workspace end
                if tick() - chestScanAt.map > 20 or chestScanAt.mapMode ~= "Map" then
                    chestScanAt.map = tick()
                    chestScanAt.mapMode = "Map"
                    chestKnown.map = scanChestRoot(mapRoot)
                end
            else
                chestKnown.map = {}
                chestScanAt.mapMode = "ChestModels"
                local chestModelsRoot = workspace:FindFirstChild("ChestModels")
                if chestModelsRoot then
                    if tick() - chestScanAt.main > 2 then
                        chestScanAt.main = tick()
                        chestKnown.main = scanChestModels(chestModelsRoot)
                    end
                else
                    chestKnown.main = {}
                end
            end

            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local wanted, ranked = {}, {}
            for _, set in pairs(chestKnown) do
                for target in pairs(set) do
                    if target.Parent then
                        local part = getChestPart(target)
                        if part then
                            local dist = root and (part.Position - root.Position).Magnitude or 0
                            local limit = cfg.range * (chestEspObjects[target] and 1.1 or 1)
                            if not cfg.rangeOn or dist <= limit then
                                wanted[target] = dist
                                table.insert(ranked, {target = target, dist = dist})
                            end
                        end
                    end
                end
            end
            table.sort(ranked, function(a, b) return a.dist < b.dist end)
            for target in pairs(chestEspObjects) do
                if not wanted[target] or not target.Parent then removeChestESP(target) end
            end
            for rank, entry in ipairs(ranked) do
                if not chestEspObjects[entry.target] then createChestESP(entry.target) end
                local data = chestEspObjects[entry.target]
                if data then data.near = rank <= 30 end
                if rank % 25 == 0 then task.wait() end
            end
        end
    end
end)
local chestEspAccum = 0
RunService.Heartbeat:Connect(function(dt)
    if not chestEspEnabled then return end
    chestEspAccum = chestEspAccum + dt
    if chestEspAccum < 0.1 then return end
    chestEspAccum = 0
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local rootPos = root.Position
    for target, data in pairs(chestEspObjects) do
        local part = data.billboard.Adornee
        if target.Parent and part and part.Parent then
            if data.mode ~= AetherisChestCfg.mode then
                data.mode = AetherisChestCfg.mode
                if data.mode == "ChestModels" then
                    data.label, data.labelColor = chestTierInfo(target.Name)
                else
                    data.label, data.labelColor = "Baú", nil
                end
            end
            -- Baús próximos: Chams e Nome usam a cor do tipo (Silver, Gold, Diamond, Fragment...);
            -- as cores escolhidas no menu valem para o modo de mapa todo e para tipos desconhecidos.
            local showChams = chestEspChams and data.near ~= false
            if data.highlight.Enabled ~= showChams then data.highlight.Enabled = showChams end
            if showChams then
                local chamsColor = data.labelColor or chestEspChamsColor
                data.highlight.FillColor = chamsColor
                data.highlight.OutlineColor = chamsColor
            end
            local showInfo = chestEspName or chestEspDistance
            if data.billboard.Enabled ~= showInfo then data.billboard.Enabled = showInfo end
            if showInfo then
                if data.nameLabel.Visible ~= chestEspName then data.nameLabel.Visible = chestEspName end
                if chestEspName then
                    if data.nameLabel.Text ~= data.label then data.nameLabel.Text = data.label end
                    data.nameLabel.TextColor3 = data.labelColor or chestEspNameColor
                end
                if data.distanceLabel.Visible ~= chestEspDistance then data.distanceLabel.Visible = chestEspDistance end
