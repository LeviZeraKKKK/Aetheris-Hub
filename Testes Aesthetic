		if data.ancestryConn then data.ancestryConn:Disconnect() end
		fruitEspObjects[tool] = nil
		
		for i = #fruitList, 1, -1 do
			if fruitList[i] == tool then table.remove(fruitList, i); break end
		end
		for i = #fruitCache, 1, -1 do
			if fruitCache[i] == tool then table.remove(fruitCache, i); break end
		end
	end

