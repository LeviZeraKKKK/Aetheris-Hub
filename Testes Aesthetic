				}, check)

				local function setVisual(selected, animate)
					local info = TweenInfo.new(animate and 0.2 or 0)
					TweenService:Create(row, info, {BackgroundColor3 = selected and currentThemeColor:Lerp(Color3.fromRGB(20, 20, 30), 0.78) or OFFCOLOR}):Play()
					TweenService:Create(rowStroke, info, {Transparency = selected and 0.45 or 1}):Play()
					TweenService:Create(check, info, {BackgroundColor3 = selected and currentThemeColor or Color3.fromRGB(52, 52, 72)}):Play()
					TweenService:Create(checkMark, info, {TextTransparency = selected and 0 or 1}):Play()
					TweenService:Create(avatar, info, {BackgroundColor3 = selected and currentThemeColor or Color3.fromRGB(52, 52, 74)}):Play()
					if animate and selected then
						check.Size = UDim2.new(0, 24, 0, 24)
