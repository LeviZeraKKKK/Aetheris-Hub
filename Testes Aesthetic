			local ups, downs = {}, {}
			for _, d in ipairs(tabButtonsList) do
				local b = d.Button
				if b.Visible and b.AbsoluteSize.Y > 0 then
					local center = b.AbsolutePosition.Y + b.AbsoluteSize.Y / 2
					if center < top then
