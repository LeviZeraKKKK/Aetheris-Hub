	-- decimals/suffix são opcionais: sem eles o slider continua inteiro, como sempre foi.
	-- Com decimals = 1 e suffix = "x" o valor aparece como "4.0x" (multiplicador).
	local function addSlider(parent, name, min, max, default, callback, decimals, suffix)
		local function formatSliderValue(value)
			if decimals and decimals > 0 then
				return string.format("%." .. decimals .. "f", value) .. (suffix or "")
			end
			return tostring(value) .. (suffix or "")
		end

		local sliderFrame = Instance.new("Frame")
		sliderFrame.Size = UDim2.new(1, 0, 0, 38)
		sliderFrame.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
		sliderFrame.BackgroundTransparency = 0.5
		sliderFrame.Parent = parent

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = sliderFrame

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -16, 0, 16)
		label.Position = UDim2.new(0, 8, 0, 3)
		label.BackgroundTransparency = 1
		label.Font = currentGlobalFont
		label.Text = name .. ": " .. formatSliderValue(default)
		label.TextColor3 = currentTextColor
		label.TextSize = 11
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = sliderFrame
		table.insert(allTextLabels, label)

		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(1, -16, 0, 4)
		bar.Position = UDim2.new(0, 8, 0, 24)
		bar.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
		bar.BorderSizePixel = 0
		bar.Parent = sliderFrame

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(1, 0)
		bCorner.Parent = bar

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
		fill.BackgroundColor3 = currentThemeColor
		fill.BorderSizePixel = 0
		fill.Parent = bar
		table.insert(themeSliders, fill)

		local fCorner = Instance.new("UICorner")
		fCorner.CornerRadius = UDim.new(1, 0)
		fCorner.Parent = fill

		local draggingSlider = false
		local currentValue = default
		local function setSliderValue(value)
			value = math.clamp(tonumber(value) or default, min, max)
			if decimals and decimals > 0 then
				local factor = 10 ^ decimals
				value = math.floor(value * factor + 0.5) / factor
			else
				value = math.floor(value + 0.5)
			end
			currentValue = value
			fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
			label.Text = name .. ": " .. formatSliderValue(value)
			callback(value)
		end
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = true end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = false end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
				local rawValue = min + (max - min) * pos
				local val
				if decimals and decimals > 0 then
					local factor = 10 ^ decimals
					val = math.floor(rawValue * factor + 0.5) / factor
				else
					val = math.floor(rawValue)
				end
				setSliderValue(val)
			end
		end)
		registerConfigBinding(parent, name, function() return currentValue end, setSliderValue)
	end

