			-- ===== Servidor (aba Misc): trocar de servidor, copiar link e Auto Hop até achar um evento =====
			-- O Auto Hop continua entre servidores se a "Auto execução" (aba Config > Save) estiver com o link/arquivo do hub.
			do
				local sec = createSection(pages["Misc"], "Servidor", sectionIcons.Physical)
				local HttpS = game:GetService("HttpService")
				local TpS = game:GetService("TeleportService")
				local FILE = "AetherisHub_HopSearch.json"
				local S = {crit = "random", targets = {mirage = false, kitsune = false, prehist = false, fruit = false}, active = false, visited = {}, token = 0}
				local CRIT = {random = "Aleatório", low = "Menos jogadores", high = "Mais jogadores", ping = "Menor ping"}
				local function readState()
					if not (readfile and isfile and isfile(FILE)) then return nil end
					local ok, d = pcall(function() return HttpS:JSONDecode(readfile(FILE)) end)
					return ok and type(d) == "table" and d or nil
				end
				local function saveState()
					if not writefile then return end
					pcall(function()
						writefile(FILE, HttpS:JSONEncode({active = S.active, crit = S.crit, targets = S.targets, visited = S.visited}))
					end)
				end
				local function getBody(url)
					local req = (syn and syn.request) or request or http_request or (http and http.request)
					if req then
						local ok, res = pcall(req, {Url = url, Method = "GET"})
						if ok and res and res.Body then return res.Body end
					end
					local ok, body = pcall(function() return game:HttpGet(url) end)
					return ok and body or nil
				end
				local function pick()
					local body = getBody("https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100")
					if not body then return nil end
					local ok, data = pcall(function() return HttpS:JSONDecode(body) end)
					if not ok or type(data) ~= "table" or type(data.data) ~= "table" then return nil end
					local seen = {}
					for _, id in ipairs(S.visited) do seen[id] = true end
					local list = {}
					for _, sv in ipairs(data.data) do
						if sv.id ~= game.JobId and not seen[sv.id] and (sv.playing or 0) < (sv.maxPlayers or 0) then table.insert(list, sv) end
					end
					if #list == 0 then S.visited = {}; return nil end
					if S.crit == "low" then
						table.sort(list, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
					elseif S.crit == "high" then
						table.sort(list, function(a, b) return (a.playing or 0) > (b.playing or 0) end)
					elseif S.crit == "ping" then
						table.sort(list, function(a, b) return (a.ping or 9999) < (b.ping or 9999) end)
					else
						return list[math.random(1, #list)].id
					end
					return list[math.min(#list, math.random(1, 3))].id
				end
				local function loaderCode()
					local ok, d = pcall(function() return HttpS:JSONDecode(readfile("AetherisHub_AutoExec.json")) end)
					local src = ok and type(d) == "table" and type(d.src) == "string" and d.src or ""
					src = src:gsub("^%s+", ""):gsub("%s+$", "")
					if src == "" then return nil end
					local qt = string.char(34)
					src = src:gsub(qt, "")
					if src:lower():match("^https?://") then return "loadstring(game:HttpGet(" .. qt .. src .. qt .. "))()" end
					return "loadstring(readfile(" .. qt .. src .. qt .. "))()"
				end
				local function hopNow()
					local id = pick()
					if not id then note("Servidor: nenhum servidor disponível agora.", Color3.fromRGB(255, 200, 120)) return false end
					table.insert(S.visited, game.JobId)
					while #S.visited > 40 do table.remove(S.visited, 1) end
					saveState()
					local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
					local code = loaderCode()
					if q and code then pcall(q, code) end
					local ok = pcall(function() TpS:TeleportToPlaceInstance(game.PlaceId, id, player) end)
					return ok
				end
				local function found()
					local map = workspace:FindFirstChild("Map")
					local why
					if S.targets.mirage and map and map:FindFirstChild("MysticIsland") then why = "Ilha Mirage" end
					if not why and S.targets.kitsune and map and map:FindFirstChild("KitsuneIsland") then why = "Ilha Kitsune" end
					if not why and S.targets.prehist and map and map:FindFirstChild("PrehistoricIsland") then why = "Ilha Pré-histórica" end
					if not why and S.targets.fruit then
						for _, c in ipairs(workspace:GetChildren()) do
							if c:IsA("Tool") and string.find(c.Name, "Fruit") then why = "Fruta no mapa (" .. c.Name .. ")" break end
						end
					end
					return why
				end
				local function runHop()
					S.token = S.token + 1
					local my = S.token
					task.spawn(function()
						task.wait(8) -- deixa o jogo carregar
						while S.active and S.token == my and screenGui.Parent do
							local why = found()
							if why then
								S.active = false
								saveState()
								note("Auto Hop: achei! " .. why, Color3.fromRGB(150, 255, 170))
								return
							end
							if not hopNow() then task.wait(6) else task.wait(12) end
						end
					end)
				end
				local rows = {}
				local function bigBtn(text, fn)
					local row = Instance.new("Frame")
					row.Size = UDim2.new(1, 0, 0, 26)
					row.BackgroundTransparency = 1
					row.Parent = sec
					local b = Instance.new("TextButton")
					AetherisBtnStyle(b)
					b.Size = UDim2.new(1, 0, 1, 0)
					b.Font = currentGlobalFont
					b.Text = text
					b.TextColor3 = currentTextColor
					b.TextSize = 10
					b.Parent = row
					local bc = Instance.new("UICorner")
					bc.CornerRadius = UDim.new(0, 6)
					bc.Parent = b
					table.insert(allTextLabels, b)
					b.MouseButton1Click:Connect(fn)
				end
				local critDD
				critDD = AetherisDropdown(sec, {
					prefix = "Critério: ",
					label = CRIT.random,
					value = "random",
					maxRows = 4,
					boxWidth = 130,
					getOptions = function()
						local o = {}
						for _, k in ipairs({"random", "low", "high", "ping"}) do table.insert(o, {label = CRIT[k], value = k}) end
						return o
					end,
					onSelect = function(v) S.crit = v; saveState() end,
				})
				bigBtn("Trocar de servidor", function()
					if not hopNow() then note("Servidor: falhou ao trocar.", Color3.fromRGB(255, 120, 120)) end
				end)
				bigBtn("Copiar link do servidor", function()
					local link = "roblox://experiences/start?placeId=" .. tostring(game.PlaceId) .. "&gameInstanceId=" .. tostring(game.JobId)
					local fn = setclipboard or toclipboard
					if fn then pcall(fn, link); note("Link do servidor copiado.", Color3.fromRGB(150, 255, 170))
					else note("Sem clipboard no executor.", Color3.fromRGB(255, 120, 120)) end
				end)
				tiny(sec, "— Auto Hop até achar —")
				addToggle(sec, "Procurar: Ilha Mirage", function(v) S.targets.mirage = v; saveState() end, false)
				addToggle(sec, "Procurar: Ilha Kitsune", function(v) S.targets.kitsune = v; saveState() end, false)
				addToggle(sec, "Procurar: Ilha Pré-histórica", function(v) S.targets.prehist = v; saveState() end, false)
				addToggle(sec, "Procurar: Fruta no mapa", function(v) S.targets.fruit = v; saveState() end, false)
				addToggle(sec, "Auto Hop (trocar até achar)", function(v)
					S.active = v
					saveState()
					if v then
						if not (S.targets.mirage or S.targets.kitsune or S.targets.prehist or S.targets.fruit) then
							note("Auto Hop: marque o que procurar.", Color3.fromRGB(255, 200, 120))
							S.active = false
							return
						end
						if not loaderCode() then
							note("Dica: configure a Auto execução (Config > Save) para o Auto Hop continuar entre servidores.", Color3.fromRGB(255, 200, 120))
						end
						runHop()
					else
						S.token = S.token + 1
					end
				end, false)
				-- retoma depois de trocar de servidor
				local saved = readState()
				if saved and saved.active then
					S.crit = saved.crit or S.crit
					if type(saved.targets) == "table" then for k, v in pairs(saved.targets) do S.targets[k] = v end end
					if type(saved.visited) == "table" then S.visited = saved.visited end
					S.active = true
					runHop()
				end
			end

			-- ===== Códigos (aba Misc): resgata todos os códigos de uma vez =====
			-- Usa Remotes.Redeem:InvokeServer(codigo). Códigos expirados ou já usados só retornam erro (sem problema).
			do
				local sec = createSection(pages["Misc"], "Códigos", sectionIcons.Physical)
				local CODES = {
					"SUB2GAMERROBOT_EXP1", "EASTEREXP", "Sub2CaptainMaui", "Enyu_is_Pro", "Starcodeheo", "Sub2Fer999",
