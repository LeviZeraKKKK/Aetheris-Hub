	-- AIM SILENT GUN (aba Combate)
	-- Ajusta o raio (FOV) e a distância máxima do AimAssist do próprio jogo.
	-- Os valores originais são guardados e devolvidos ao desligar ou ao fechar o hub.
	-----------------------------------------------------------------
	do
		local silentGunEnabled = false
		local silentFovMultiplier = 4.0   -- multiplicador do raio (FOV) padrão do jogo
		local silentDistMultiplier = 2.5  -- multiplicador da distância máxima padrão do jogo

		local aimSettings = nil        -- módulo ReplicatedStorage.Modules.AimAssistSettings
		local aimOriginals = {}        -- [perfil] = {radius = ..., dist = ...}
		local aimBaseFov = 40
		local aimBaseDist = 600
		local aimWarned = false
		local globalStateModule = nil  -- ReplicatedStorage.Global (false = não existe)
		local aimGateOpen = true       -- false = aim assist fechado (o alvo provável é aliado ou não é o foco)
		local lastTouchPosition = nil  -- última posição de toque (mira no celular)
		local guiService = game:GetService("GuiService")

		local function loadAimSettings()
			if aimSettings then return true end
			local ok, result = pcall(function()
				local modules = ReplicatedStorage:FindFirstChild("Modules") or ReplicatedStorage:WaitForChild("Modules", 3)
				local moduleScript = modules and (modules:FindFirstChild("AimAssistSettings") or modules:WaitForChild("AimAssistSettings", 3))
				return moduleScript and require(moduleScript)
			end)
			if ok and type(result) == "table" and type(result.Profiles) == "table" then
				aimSettings = result
				for profileName, profile in pairs(result.Profiles) do
					aimOriginals[profileName] = {radius = profile.AssistRadiusPixels, dist = profile.MaxDistance}
				end
				local defaultProfile = result.Profiles["PC"] or result.Profiles[result.DefaultProfile]
				if defaultProfile then
					aimBaseFov = defaultProfile.AssistRadiusPixels or 40
					aimBaseDist = defaultProfile.MaxDistance or 600
				end
				return true
			end
			return false
		end

		local function applyAimValues()
			if not aimSettings then return end
			-- Com o "portão" fechado o raio cai para 1 pixel, o que na prática desliga o aim assist.
			local radius = aimGateOpen and math.floor(aimBaseFov * silentFovMultiplier) or 1
			local maxDistance = math.floor(aimBaseDist * silentDistMultiplier)
			local ok = pcall(function()
				for _, profile in pairs(aimSettings.Profiles) do
					profile.AssistRadiusPixels = radius
					profile.MaxDistance = maxDistance
				end
			end)
			if not ok and not aimWarned then
				aimWarned = true
				warn("[Aetheris] Não foi possível alterar o AimAssistSettings (tabela protegida).")
			end
		end

		local function restoreAimValues()
			if not aimSettings then return end
			pcall(function()
				for profileName, profile in pairs(aimSettings.Profiles) do
					local original = aimOriginals[profileName]
					if original then
						profile.AssistRadiusPixels = original.radius
						profile.MaxDistance = original.dist
					end
				end
			end)
		end

		-- Ao fechar/recarregar o hub, devolve as configurações originais do jogo.
		screenGui.Destroying:Connect(function()
			silentGunEnabled = false
			restoreAimValues()
		end)

		-- Sincroniza o toque/clique com o wrapper do jogo (usado pelas skills e pelo CombatController).
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then lastTouchPosition = input.Position end
		end)
		UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then lastTouchPosition = input.Position end
			if not silentGunEnabled then return end
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				pcall(function()
					if globalStateModule == nil then
						local ok, result = pcall(function() return require(ReplicatedStorage.Global) end)
						globalStateModule = (ok and type(result) == "table") and result or false
					end
					if globalStateModule then
						globalStateModule.CurrentTouchObjectForMouse = input
					end
				end)
			end
		end)

		-- FOCO / ALIADO: o aim assist do jogo só deve atuar quando o alvo que ele provavelmente
		-- escolheria (o jogador mais perto da mira, dentro do raio e da distância) é permitido.
		-- Aliado = bloqueado. Se houver jogadores em Foco, só eles valem.
		local function getAimPoint()
			if UserInputService:GetLastInputType() == Enum.UserInputType.Touch and lastTouchPosition then
				return Vector2.new(lastTouchPosition.X, lastTouchPosition.Y) + guiService:GetGuiInset()
			end
			if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter and workspace.CurrentCamera then
				return workspace.CurrentCamera.ViewportSize / 2
			end
			return UserInputService:GetMouseLocation()
		end

		local function computeAimGate()
			local hasAllies = next(aimAllies) ~= nil
			local hasFocus = false
			for focusedPlayer, selected in pairs(selectedManualTargets) do
				if selected and focusedPlayer.Parent and not aimAllies[focusedPlayer] then
					hasFocus = true
					break
				end
			end
			if not hasAllies and not hasFocus then return true end

			local currentCamera = workspace.CurrentCamera
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not currentCamera or not myRoot then return true end

			local maxDistance = aimBaseDist * silentDistMultiplier
			local radiusPixels = aimBaseFov * silentFovMultiplier
			local aimPoint = getAimPoint()
			local nearestPlayer, nearestPixels = nil, math.huge

			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					local otherChar = other.Character
					local otherRoot = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
					local otherHum = otherChar and otherChar:FindFirstChildOfClass("Humanoid")
					if otherRoot and otherHum and otherHum.Health > 0
						and (otherRoot.Position - myRoot.Position).Magnitude <= maxDistance then
						local screenPos, onScreen = currentCamera:WorldToViewportPoint(otherRoot.Position)
						if onScreen then
							local pixels = (Vector2.new(screenPos.X, screenPos.Y) - aimPoint).Magnitude
							if pixels <= radiusPixels and pixels < nearestPixels then
								nearestPixels = pixels
								nearestPlayer = other
							end
						end
					end
				end
			end

			if not nearestPlayer then return true end
			if aimAllies[nearestPlayer] then return false end
			if hasFocus and not selectedManualTargets[nearestPlayer] then return false end
			return true
		end

		local aimGateConnection
		aimGateConnection = RunService.Heartbeat:Connect(function()
			if not screenGui.Parent then
				aimGateConnection:Disconnect()
				return
			end
			if not silentGunEnabled or not aimSettings then return end
			local open = computeAimGate()
			if open ~= aimGateOpen then
				aimGateOpen = open
				applyAimValues()
			end
		end)

		local secSilentGun = createSection(aimLockPage, "Aim Silent Gun", sectionIcons.Combat)

		addToggle(secSilentGun, "Aim Silent Gun", function(state)
			silentGunEnabled = state
			aimGateOpen = true
			task.spawn(function()
				if state then
					if not loadAimSettings() then
						warn("[Aetheris] AimAssistSettings não encontrado neste jogo.")
						return
					end
					if silentGunEnabled then applyAimValues() end
				else
					restoreAimValues()
				end
			end)
		end, false)

		addSlider(secSilentGun, "FOV Multiplier", 1.0, 15.0, silentFovMultiplier, function(val)
			silentFovMultiplier = val
			if silentGunEnabled then applyAimValues() end
		end, 1, "x")

		addSlider(secSilentGun, "Distance Multiplier", 1.0, 5.0, silentDistMultiplier, function(val)
			silentDistMultiplier = val
			if silentGunEnabled then applyAimValues() end
		end, 1, "x")

		-- Dropdown de jogadores: cada clique alterna Neutro -> Foco -> Aliado -> Neutro.
		-- Foco = o aim assist só atua nele (e entra na lista manual do Lock-On).
		-- Aliado = o aim assist não atua nele, e ele nunca é alvo do Lock-On.
		local playerDropFrame = Instance.new("Frame")
		playerDropFrame.Size = UDim2.new(1, 0, 0, 26)
		playerDropFrame.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
		playerDropFrame.BackgroundTransparency = 0.5
		playerDropFrame.Parent = secSilentGun
		local playerDropCorner = Instance.new("UICorner")
		playerDropCorner.CornerRadius = UDim.new(0, 5)
		playerDropCorner.Parent = playerDropFrame

		local playerDropLabel = Instance.new("TextLabel")
		playerDropLabel.Size = UDim2.new(1, -34, 1, 0)
		playerDropLabel.Position = UDim2.new(0, 8, 0, 0)
		playerDropLabel.BackgroundTransparency = 1
		playerDropLabel.Font = currentGlobalFont
		playerDropLabel.Text = "Jogadores: Focar / Aliado"
		playerDropLabel.TextColor3 = currentTextColor
		playerDropLabel.TextSize = 11
		playerDropLabel.TextXAlignment = Enum.TextXAlignment.Left
		playerDropLabel.TextTruncate = Enum.TextTruncate.AtEnd
		playerDropLabel.Parent = playerDropFrame
		table.insert(allTextLabels, playerDropLabel)

		local playerDropArrow = Instance.new("TextLabel")
		playerDropArrow.Size = UDim2.new(0, 24, 1, 0)
		playerDropArrow.Position = UDim2.new(1, -28, 0, 0)
		playerDropArrow.BackgroundTransparency = 1
		playerDropArrow.Font = currentGlobalFont
		playerDropArrow.Text = "▼"
		playerDropArrow.TextColor3 = currentTextColor
		playerDropArrow.TextSize = 10
		playerDropArrow.Parent = playerDropFrame
		table.insert(allTextLabels, playerDropArrow)

		local playerDropHit = Instance.new("TextButton")
		playerDropHit.Size = UDim2.new(1, 0, 1, 0)
		playerDropHit.BackgroundTransparency = 1
		playerDropHit.Text = ""
		playerDropHit.ZIndex = 5
		playerDropHit.Parent = playerDropFrame

		local playerDropList = Instance.new("ScrollingFrame")
		playerDropList.Size = UDim2.new(1, 0, 0, 130)
		playerDropList.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
		playerDropList.BackgroundTransparency = 0.5
		playerDropList.BorderSizePixel = 0
		playerDropList.CanvasSize = UDim2.new(0, 0, 0, 0)
		playerDropList.ScrollBarThickness = 3
		playerDropList.Visible = false
		playerDropList.Parent = secSilentGun
		local playerDropListCorner = Instance.new("UICorner")
		playerDropListCorner.CornerRadius = UDim.new(0, 5)
		playerDropListCorner.Parent = playerDropList
		local playerDropListLayout = Instance.new("UIListLayout")
		playerDropListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		playerDropListLayout.Padding = UDim.new(0, 4)
		playerDropListLayout.Parent = playerDropList

		local focusColor = currentThemeColor
		local allyColor = Color3.fromRGB(46, 160, 90)
		local neutralColor = Color3.fromRGB(34, 34, 46)

		local function renderAimPlayers()
			for _, child in ipairs(playerDropList:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end

			local count, focusCount, allyCount = 0, 0, 0
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player then
					count = count + 1
					local isAlly = aimAllies[p] == true
					local isFocus = (not isAlly) and selectedManualTargets[p] == true
					if isAlly then allyCount = allyCount + 1 end
					if isFocus then focusCount = focusCount + 1 end

					local item = Instance.new("TextButton")
					item.Size = UDim2.new(1, -6, 0, 24)
					item.BackgroundColor3 = isAlly and allyColor or (isFocus and currentThemeColor or neutralColor)
					item.Font = currentGlobalFont
					item.Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ")"
					item.TextColor3 = currentTextColor
					item.TextSize = 10
					item.TextXAlignment = Enum.TextXAlignment.Left
					item.TextTruncate = Enum.TextTruncate.AtEnd
					item.Parent = playerDropList
					local itemPadding = Instance.new("UIPadding")
					itemPadding.PaddingRight = UDim.new(0, 62)
					itemPadding.Parent = item
					local itemCorner = Instance.new("UICorner")
					itemCorner.CornerRadius = UDim.new(0, 4)
					itemCorner.Parent = item

					local tag = Instance.new("TextLabel")
					tag.Size = UDim2.new(0, 56, 1, 0)
					tag.Position = UDim2.new(1, 62 - 58, 0, 0)
					tag.BackgroundTransparency = 1
					tag.Font = Enum.Font.GothamBold
					tag.Text = isAlly and "ALIADO" or (isFocus and "FOCO" or "NEUTRO")
					tag.TextColor3 = (isAlly or isFocus) and Color3.new(1, 1, 1) or Color3.fromRGB(140, 140, 160)
					tag.TextSize = 9
					tag.TextXAlignment = Enum.TextXAlignment.Right
					tag.Parent = item

					item.MouseButton1Click:Connect(function()
						if aimAllies[p] then
							aimAllies[p] = nil                  -- Aliado -> Neutro
						elseif selectedManualTargets[p] then
							selectedManualTargets[p] = nil      -- Foco -> Aliado
							aimAllies[p] = true
						else
							selectedManualTargets[p] = true     -- Neutro -> Foco
							lockOnMode = "Manual"
							modeSwitchBtn.Text = lockOnMode
						end
						updateServerList()
						renderAimPlayers()
					end)
				end
			end

			playerDropList.CanvasSize = UDim2.new(0, 0, 0, count * 28)
			playerDropLabel.Text = string.format("Jogadores  (Foco: %d · Aliados: %d)", focusCount, allyCount)
		end

		playerDropHit.MouseButton1Click:Connect(function()
			playerDropList.Visible = not playerDropList.Visible
			playerDropArrow.Text = playerDropList.Visible and "▲" or "▼"
			if playerDropList.Visible then renderAimPlayers() end
		end)

		Players.PlayerAdded:Connect(function()
			if playerDropList.Visible then renderAimPlayers() end
		end)
		Players.PlayerRemoving:Connect(function(leavingPlayer)
			aimAllies[leavingPlayer] = nil
			task.defer(function()
				if playerDropList.Parent then renderAimPlayers() end
			end)
		end)
		renderAimPlayers()
	end

	-----------------------------------------------------------------
	-- ABA FARMING (CHEST COLLECTOR)
	-----------------------------------------------------------------
	local farmingPage = pages["Farming"]
	local secFarm = createSection(farmingPage, "Automação", sectionIcons.FarmAutomation)

	local chestFolder = workspace:WaitForChild("ChestModels", 5) or workspace
	local mapFolder = workspace:WaitForChild("Map", 5) or workspace

	local chestActive = false
	local chestSpeed = 50
	local WATER_SAFE_Y = 15
	local ISLAND_HEIGHT = 15
	local ISLAND_ARRIVAL_DISTANCE = 20

	local chestTarget = nil
	local chestTargetType = nil
	local visitedChests = {}
	local visitedIslands = {}
	local originalCollisionChest = {}

	local moveConnectionChest, noclipConnectionChest, sitConnectionChest, healthConnectionChest
	local lastHealth = nil
	local lastDamageTime = 0

	local function getCharacterParts()
		local character = player.Character
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 then
			return character, humanoid, root
		end
	end

	local function setOmniNoclip(enabled)
		if noclipConnectionChest then
			noclipConnectionChest:Disconnect()
			noclipConnectionChest = nil
		end

		if enabled then
			table.clear(originalCollisionChest)
			local character = player.Character
			if not character then return end

			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					originalCollisionChest[part] = part.CanCollide
					part.CanCollide = false
				end
			end

			noclipConnectionChest = RunService.Stepped:Connect(function()
				if not chestActive then return end
				local currentCharacter = player.Character
				if not currentCharacter then return end

				for _, part in ipairs(currentCharacter:GetDescendants()) do
					if part:IsA("BasePart") then
						if originalCollisionChest[part] == nil then
							originalCollisionChest[part] = part.CanCollide
						end
						part.CanCollide = false
					end
				end
			end)
		else
			for part, originalValue in pairs(originalCollisionChest) do
				if part and part.Parent then
					part.CanCollide = originalValue
				end
			end
			table.clear(originalCollisionChest)
		end
	end

	local function jumpIfSeated()
		local _, humanoid = getCharacterParts()
		if not humanoid or not chestActive then return end
		if humanoid.Sit or humanoid:GetState() == Enum.HumanoidStateType.Seated then
			humanoid.Sit = false
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end

	local function getPosition(object)
		if not object or not object.Parent then return nil end
		if object:IsA("Model") then
			return object:GetPivot().Position
		elseif object:IsA("BasePart") then
			return object.Position
		end
		return nil
	end

	local function getChestCandidates()
		local candidates = {}
		for _, object in ipairs(chestFolder:GetDescendants()) do
			if object:IsA("Model") or object:IsA("BasePart") then
				local ancestor = object.Parent
				local nested = false

				while ancestor and ancestor ~= chestFolder do
					if ancestor:IsA("Model") or ancestor:IsA("BasePart") then
						nested = true
						break
					end
					ancestor = ancestor.Parent
				end

				if not nested and getPosition(object) then
					table.insert(candidates, object)
				end
			end
		end
		return candidates
	end

	local function getIslandCandidates()
		local candidates = {}
		for _, object in ipairs(mapFolder:GetDescendants()) do
			if object:IsA("Model") then
				local ancestor = object.Parent
				local nestedModel = false

				while ancestor and ancestor ~= mapFolder do
					if ancestor:IsA("Model") then
						nestedModel = true
						break
					end
					ancestor = ancestor.Parent
				end

				if not nestedModel and getPosition(object) then
					table.insert(candidates, object)
				end
			end
		end
		return candidates
	end

	local function findNearest(candidates, root, visited)
		local nearest, nearestDistance = nil, math.huge
		for _, object in ipairs(candidates) do
			if object.Parent and not visited[object] then
				local position = getPosition(object)
				if position then
					local distance = (position - root.Position).Magnitude
					if distance < nearestDistance then
						nearestDistance = distance
						nearest = object
					end
				end
			end
		end
		return nearest
	end

	local function stopChestCollector()
		chestActive = false
		chestTarget = nil
		chestTargetType = nil

		if moveConnectionChest then moveConnectionChest:Disconnect(); moveConnectionChest = nil end
		if sitConnectionChest then sitConnectionChest:Disconnect(); sitConnectionChest = nil end
		if healthConnectionChest then healthConnectionChest:Disconnect(); healthConnectionChest = nil end

		setOmniNoclip(false)

		local _, humanoid, root = getCharacterParts()
		if humanoid then
			humanoid:Move(Vector3.zero)
			humanoid.AutoRotate = true
		end
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end

		table.clear(visitedChests)
		table.clear(visitedIslands)
	end

	local function startChestCollector()
		local _, humanoid, root = getCharacterParts()
		if not humanoid or not root then return end

		chestActive = true
		chestTarget = nil
		chestTargetType = nil
		lastHealth = humanoid.Health
		lastDamageTime = 0

		table.clear(visitedChests)
		table.clear(visitedIslands)
		setOmniNoclip(true)

		if healthConnectionChest then healthConnectionChest:Disconnect() end
		healthConnectionChest = humanoid.HealthChanged:Connect(function(newHealth)
			if lastHealth and newHealth < lastHealth then
				lastDamageTime = os.clock()
			end
			lastHealth = newHealth
		end)

		sitConnectionChest = RunService.Heartbeat:Connect(function()
			if chestActive then jumpIfSeated() end
		end)

		moveConnectionChest = RunService.Heartbeat:Connect(function()
			if not chestActive then return end

			local _, hum, hrp = getCharacterParts()
			if not hum or not hrp then
				stopChestCollector()
				return
			end

			local nearestChest = findNearest(getChestCandidates(), hrp, visitedChests)
			if nearestChest then
				chestTarget = nearestChest
				chestTargetType = "Chest"
			elseif not chestTarget or chestTargetType ~= "Island" or not chestTarget.Parent or visitedIslands[chestTarget] then
				chestTarget = findNearest(getIslandCandidates(), hrp, visitedIslands)
				chestTargetType = chestTarget and "Island" or nil
			end

			if not chestTarget then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hum:Move(Vector3.zero)
				return
			end

			local position = getPosition(chestTarget)
			if not position then
				chestTarget = nil
				chestTargetType = nil
				return
			end

			local destination
			if chestTargetType == "Chest" then
				destination = position + Vector3.new(0, 2, 0)
			else
				local safeY = math.max(position.Y + ISLAND_HEIGHT, WATER_SAFE_Y, hrp.Position.Y)
				destination = Vector3.new(position.X, safeY, position.Z)
			end

			local offset = destination - hrp.Position
			local distance = offset.Magnitude

			if chestTargetType == "Chest" and distance < 4 then
				visitedChests[chestTarget] = true
				chestTarget = nil
				chestTargetType = nil
				hrp.AssemblyLinearVelocity = Vector3.zero
				return
			end

			if chestTargetType == "Island" then
				local horizontalOffset = Vector3.new(position.X - hrp.Position.X, 0, position.Z - hrp.Position.Z)
				local recentlyDamaged = (os.clock() - lastDamageTime) < 1

				if horizontalOffset.Magnitude < ISLAND_ARRIVAL_DISTANCE or recentlyDamaged then
					visitedIslands[chestTarget] = true
					chestTarget = nil
					chestTargetType = nil
					hrp.AssemblyLinearVelocity = Vector3.zero
					return
				end
			end

			if chestTargetType == "Island" and hrp.Position.Y < WATER_SAFE_Y then
				hrp.AssemblyLinearVelocity = Vector3.new(
					offset.Unit.X * chestSpeed,
					math.max(chestSpeed * 0.5, 10),
					offset.Unit.Z * chestSpeed
				)
			elseif distance > 0.1 then
				local direction = offset.Unit
				hrp.AssemblyLinearVelocity = direction * chestSpeed
				hum:Move(direction, false)
			else
				hrp.AssemblyLinearVelocity = Vector3.zero
				hum:Move(Vector3.zero)
			end
		end)
	end

	addToggle(secFarm, "Auto Collect Chest", function(state)
		if state then startChestCollector() else stopChestCollector() end
	end, false)

	addSlider(secFarm, "Velocidade do Chest Collector", 5, 500, 50, function(val)
		chestSpeed = val
	end)

