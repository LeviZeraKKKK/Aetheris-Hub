		corner.Parent = sliderFrame

		sliderFrame.MouseEnter:Connect(function()
			TweenService:Create(sliderFrame, TweenInfo.new(0.15), {BackgroundTransparency = 0.3}):Play()
		end)
		sliderFrame.MouseLeave:Connect(function()
			TweenService:Create(sliderFrame, TweenInfo.new(0.15), {BackgroundTransparency = 0.5}):Play()
		end)

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -16, 0, 16)
		label.Position = UDim2.new(0, 8, 0, 3)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamMedium
		label.Text = name .. ": " .. default
		label.TextColor3 = Color3.fromRGB(200, 200, 200)
		label.TextSize = 11
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = sliderFrame

		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(1, -16, 0, 4)
		bar.Position = UDim2.new(0, 8, 0, 24)
		bar.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
		bar.BorderSizePixel = 0
		bar.Parent = sliderFrame

		local bCorner = Instance.new("UICorner")
		bCorner.CornerRadius = UDim.new(1, 0)
		bCorner.Parent = bar

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
		fill.BackgroundColor3 = currentThemeColor
		fill.BorderSizePixel = 0
		fill.Parent = bar
		table.insert(themeSliders, fill)

		local fCorner = Instance.new("UICorner")
		fCorner.CornerRadius = UDim.new(1, 0)
		fCorner.Parent = fill

		local draggingSlider = false
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = true end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = false end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
				fill.Size = UDim2.new(pos, 0, 1, 0)
				local val = math.floor(min + (max - min) * pos)
				label.Text = name .. ": " .. val
				callback(val)
			end
		end)
	end

	-----------------------------------------------------------------
	-- ABAS DO HUB (Exemplo organizado com Cards e Seções)
	-----------------------------------------------------------------
	local playerPage = pages["Player"]
	local secMovimento = createSection(playerPage, "Movimento", "🏃‍♂️")
	
	-- Exemplo de Agrupamento em Cards dentro da seção
	local cardWalk = createCard(secMovimento, "Configurações de Velocidade")
	addToggle(cardWalk, "Ativar WalkSpeed", function(state) _G_WalkSpeedEnabled = state end, false)
	addSlider(cardWalk, "Velocidade", 16, 250, 16, function(val) _G_WalkSpeedValue = val end)

	local cardJump = createCard(secMovimento, "Configurações de Pulo")
	addToggle(cardJump, "Ativar JumpPower", function(state) _G_JumpPowerEnabled = state end, false)
	addSlider(cardJump, "Força do Pulo", 50, 300, 50, function(val) _G_JumpPowerValue = val end)

	local secConfig = createSection(pages["Config"], "Tema do Hub", "⚙️")
	addColorPicker(secConfig, "Cor Principal do Hub", currentThemeColor, function(color)
		updateGlobalTheme(color)
		saveConfig()
	end)
	addSlider(secConfig, "Transparência do Painel", 0, 80, math.floor(panelTransparencyValue * 100), function(val)
		panelTransparencyValue = val / 100
		mainPanel.BackgroundTransparency = panelTransparencyValue
		floatingBtn.BackgroundTransparency = panelTransparencyValue
		saveConfig()
	end)

	TweenService:Create(mainPanel, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = currentPanelSize
	}):Play()
end

