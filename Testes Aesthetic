		getOptions = function()
			refreshIslands()
			local opts = {}
			for _, island in ipairs(islands) do table.insert(opts, {label = island.Name, value = island}) end
			return opts
		end,
		onSelect = function(island) selectedIsland = island end,
	})
	registerConfigBinding(secTravel, "Ilha selecionada", function() return selectedIsland and selectedIsland.Name or "" end, function(savedName)
