			else
				local t = TweenService:Create(wrap, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)})
				t:Play()
				t.Completed:Connect(function()
					if not dropOpen then wrap.Visible = false end
				end)
			end
		end

