						for _, child in ipairs(mapFolder:GetDescendants()) do
							if string.sub(child.Name, 1, 1) == "{" then
								local berries = child:FindFirstChild("Berries")
								if berries then
									local _, attrValue = next(berries:GetAttributes())
									if attrValue ~= nil then
										found[child] = true
										local text = tostring(attrValue)
										local data = berryEspObjects[child]
										if data then
