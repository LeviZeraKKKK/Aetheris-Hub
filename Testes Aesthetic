				if lvl and lvl:IsA("ValueBase") then return lvl.Value end
				for _, c in ipairs(data:GetChildren()) do
					if c.Name:lower():find("level") and c:IsA("ValueBase") then return c.Value end
				end
			end
			local direct = player:FindFirstChild("Level") or player:FindFirstChild("LevelValue")
			if direct and direct:IsA("ValueBase") then return direct.Value end
			local attr = player:GetAttribute("Level")
			if attr then return attr end
			local char = player.Character
			if char then
				local a = char:GetAttribute("Level")
				if a then return a end
			end
			return 0
		end

		-- Todas as quests elegíveis (nível atual), da mais forte para a mais fraca.
		function Q.getAllQuests(ceilExclusive)
			local all = {}
			if not Q.quests then return all end
			local level = Q.getLevel()
			for catName, entries in pairs(Q.quests) do
				if type(entries) == "table" then
					for idx, q in ipairs(entries) do
						if type(q) == "table" and type(q.LevelReq) == "number" and q.LevelReq <= level
							and (not ceilExclusive or q.LevelReq < ceilExclusive)
							and not q.MeetsRequirements
							and not q.OnComplete then
							local taskType, count = nil, 0
							for t, c in pairs(q.Task or {}) do taskType = t; count = c; break end
							table.insert(all, {
								category = catName, questName = q.Name, index = idx, levelReq = q.LevelReq,
								taskType = taskType, isSingle = (count == 1),
							})
						end
					end
				end
			end
			table.sort(all, function(a, b) return a.levelReq > b.levelReq end)
			return all
		end

		-- O boss/inimigo desse tipo de tarefa está vivo agora?
