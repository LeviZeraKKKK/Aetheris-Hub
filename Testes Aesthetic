						TweenService:Create(check, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
							Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -26, 0.5, -9)
						}):Play()
					end
				end
