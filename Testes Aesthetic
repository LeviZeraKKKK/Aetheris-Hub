		local function descendantToggle(label, test, apply, restore)
			local saved = setmetatable({}, {__mode = "k"})
			local on, conn = false, nil
			local function handle(inst)
				local okTest, match = pcall(test, inst)
				if okTest and match and saved[inst] == nil then
					local okApply, orig = pcall(apply, inst)
					if okApply then saved[inst] = {orig} end
				end
			end
			addToggle(secFps, label, function(state)
				on = state
				if conn then conn:Disconnect(); conn = nil end
				if state then
					conn = workspace.DescendantAdded:Connect(function(d) if on then handle(d) end end)
					task.spawn(function()
						local n = 0
						for _, d in ipairs(workspace:GetDescendants()) do
							if not on then break end
							handle(d)
							n = n + 1
							if n % 300 == 0 then task.wait() end
						end
					end)
				else
					for inst, box in pairs(saved) do
						if inst.Parent then pcall(restore, inst, box[1]) end
					end
					table.clear(saved)
				end
			end, false)
		end

