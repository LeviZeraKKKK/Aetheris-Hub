		-- Aceitar quest: método 1 (direto)
		function Q.acceptDirect()
			if not Q.questCat then return false end
			local cat, name, idx = Q.questCat, Q.questName, Q.questIndex
			local commF = Q.commF
			local attempts = {
				function() return commF:InvokeServer("StartQuest", cat, idx) end,
				function() return commF:InvokeServer("StartQuest", cat, name) end,
				function() return commF:InvokeServer("StartQuest", cat) end,
				function() return commF:InvokeServer("AcceptQuest", cat, idx) end,
				function() return commF:InvokeServer("AcceptQuest", cat) end,
				function() return commF:InvokeServer("QuestStart", cat, idx) end,
				function() return commF:InvokeServer(cat, idx) end,
				function() return commF:InvokeServer("Quest", cat, name) end,
			}
			-- Permissivo: o StartQuest costuma devolver nil quando dá certo, então qualquer chamada
			-- que não der erro de execução já conta como missão aceita (assim ele pega e já vai direto).
			for _, fn in ipairs(attempts) do
				local ok, result = pcall(fn)
				if ok then
					print("[AutoFarm] StartQuest " .. tostring(cat) .. " #" .. tostring(idx) .. " -> " .. tostring(result))
					return true
				end
				task.wait(0.1)
			end
			-- todas deram erro de execução (raro): abandona e tenta de novo
			pcall(function() commF:InvokeServer("AbandonQuest") end)
			task.wait(0.3)
			return (pcall(function() commF:InvokeServer("StartQuest", cat, idx) end))
		end

		-- Aceitar quest: método 2 (diálogo)
		function Q.findGiver()
			local exactName = Q.questCat and Q.npcMap[Q.questCat]
			if not exactName then return nil end
			local function scan(folder)
				if not folder then return nil end
				for _, obj in ipairs(folder:GetChildren()) do
					if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj.Name == exactName then return obj end
				end
				return nil
			end
			return scan(workspace:FindFirstChild("NPCs")) or scan(workspace:FindFirstChild("Map")) or scan(workspace:FindFirstChild("Characters")) or scan(workspace)
		end

		function Q.pickDialogueOption()
			local D = Q.dialogue
			if not D or not D.Active then return false end
			local dl = D.getActiveDialogue()
			local page = dl and dl:getCurrent()
			local options = page and page._options
			if not options or #options == 0 then return false end
			local best = nil
			for _, opt in ipairs(options) do
				if not opt._isCancel and not opt._locked then
					local txt = ""
					pcall(function()
						if type(opt._text) == "string" then txt = opt._text end
						if opt._label and type(opt._label) == "string" then txt = txt .. " " .. opt._label end
					end)
					txt = txt:lower()
					for _, key in ipairs({"accept", "yes", "i'll", "complete", "turn", "ok", "sure", "deal", "start"}) do
						if txt:find(key, 1, true) then best = opt; break end
					end
					if best then break end
				end
			end
			if not best then
				for _, opt in ipairs(options) do
					if not opt._isCancel and not opt._locked then best = opt; break end
				end
			end
			if best then pcall(function() D.select(best) end); return true end
			return false
		end

		function Q.acceptDialog()
			local D, NM = Q.dialogue, Q.npcManager
			if not NM or not D then return false end
			local giver = Q.findGiver()
			if not giver then return false end
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local npcPart = giver:FindFirstChild("HumanoidRootPart") or giver:FindFirstChild("Head") or giver.PrimaryPart
			if hrp and npcPart then
				hrp.CFrame = CFrame.new(npcPart.Position + Vector3.new(4, 0, 4))
				task.wait(0.4)
			end
			pcall(function() if D.Active then D.close() end end)
			task.wait(0.2)
			local instances = NM.getNPCsByName(giver.Name)
			if not instances or #instances == 0 then return false end
			task.spawn(function() pcall(function() NM.startDialogue(instances[1], nil) end) end)
			for _ = 1, 30 do
				task.wait(0.1)
				if D.Active then break end
			end
			if not D.Active then return false end
			task.wait(0.6)
			for _ = 1, 4 do
				if not D.Active then break end
				if not Q.pickDialogueOption() then pcall(function() D.advance() end) end
				task.wait(0.7)
			end
			task.wait(0.3)
			pcall(function() if D.Active then D.close() end end)
			task.wait(0.2)
			return true
		end

		function Q.acceptQuest()
			if Q.method == 1 then return Q.acceptDirect() end
			return Q.acceptDialog()
		end

