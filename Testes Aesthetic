		local function getBerryColor(text)
			local lowerName = string.lower(tostring(text))
			if string.find(lowerName, "green", 1, true) then
				return Color3.fromRGB(0, 255, 0)
			elseif string.find(lowerName, "yellow", 1, true) then
				return Color3.fromRGB(255, 255, 0)
			elseif string.find(lowerName, "red", 1, true) then
				return Color3.fromRGB(255, 0, 0)
			elseif string.find(lowerName, "blue", 1, true) then
				return Color3.fromRGB(0, 150, 255)
			elseif string.find(lowerName, "orange", 1, true) then
				return Color3.fromRGB(255, 140, 0)
			elseif string.find(lowerName, "purple", 1, true) then
				return Color3.fromRGB(180, 50, 255)
			end
			return Color3.fromRGB(255, 255, 255)
		end

