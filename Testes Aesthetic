				btn.AutoButtonColor = true
				btn.Font = currentGlobalFont
				btn.Text = "Resgatar todos os códigos"
				btn.TextColor3 = currentTextColor
				btn.TextSize = 10
				btn.Parent = row
				local bc = Instance.new("UICorner")
				bc.CornerRadius = UDim.new(0, 5)
				bc.Parent = btn
				table.insert(allTextLabels, btn)
				addToggle(sec, "Incluir códigos que resetam stats", function(state) C.reset = state end, false)
				local function redeem(code)
					local rs = game:GetService("ReplicatedStorage")
					local remotes = rs:FindFirstChild("Remotes")
					local r = remotes and remotes:FindFirstChild("Redeem")
					if not r then return nil, "remote Redeem não encontrado" end
					local ok, res = pcall(function()
						if r:IsA("RemoteFunction") then return r:InvokeServer(code) end
						r:FireServer(code)
						return "enviado"
					end)
					if not ok then return false, tostring(res) end
					local txt = typeof(res) == "table" and "(tabela)" or tostring(res)
					local low = string.lower(txt)
					local bad = low:find("expired") or low:find("invalid") or low:find("already") or low:find("used") or low:find("not ") or low:find("fail")
					return not bad, txt
				end
				btn.MouseButton1Click:Connect(function()
					if C.busy then return end
					C.busy = true
					local list = {}
					for _, c in ipairs(CODES) do table.insert(list, c) end
					if C.reset then for _, c in ipairs(RESET) do table.insert(list, c) end end
					task.spawn(function()
						local okN, failN, first = 0, 0, nil
						for i, code in ipairs(list) do
							if not screenGui.Parent then break end
							btn.Text = "Resgatando " .. i .. "/" .. #list .. "..."
							local good, txt = redeem(code)
							if good == nil then
								note("Códigos: " .. tostring(txt), Color3.fromRGB(255, 120, 120))
								break
							end
							if not first then
								first = code .. " → " .. tostring(txt)
								note("Resposta do 1º código: " .. first, Color3.fromRGB(150, 220, 255))
							end
							if good then okN = okN + 1 else failN = failN + 1 end
							task.wait(0.7)
						end
						btn.Text = "Resgatar todos os códigos"
						note("Códigos: " .. okN .. " resgatados, " .. failN .. " expirados/já usados", Color3.fromRGB(150, 255, 170))
						C.busy = false
					end)
				end)
			end

			-- ===== Dash Longo (aba Player) =====
			-- O jogo coloca "DashTrail" dentro do seu personagem (Workspace.Characters.<seu nome>) quando você dá dash.
			-- Enquanto ele existir, o script dá micro teleportes para a frente (parece que o dash vai mais longe)
			-- e a direção acompanha o seu movimento na hora (WASD/analógico), então dá para mudar de direção no dash.
			do
				local sec = createSection(pages["Player"], "Dash Longo", sectionIcons.Physical)
				local st = tiny(sec, "💤 Desligado")
				local D = {on = false, speed = 100, maxDur = 0.6, steer = true, walls = true, conns = {}, count = 0, running = false}
				local SKIP = {"fly", "travel", "aetheris", "boat"}
				local function skipName(n)
					n = n:lower()
					for _, p in ipairs(SKIP) do
						if n:find(p, 1, true) then return true end
					end
					return false
				end
				local function flat(v)
					local f = Vector3.new(v.X, 0, v.Z)
					return f.Magnitude > 0.01 and f.Unit or nil
				end
				local function runDash(char, trail)
					if D.running then return end
					local hrp = char:FindFirstChild("HumanoidRootPart")
					local hum = char:FindFirstChildOfClass("Humanoid")
					if not hrp or not hum then return end
					D.running = true
					D.count = D.count + 1
					local t0 = tick()
					local dir = flat(hrp.AssemblyLinearVelocity) or flat(hrp.CFrame.LookVector) or Vector3.new(0, 0, -1)
					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = {char}
					local conn
					conn = RunService.Heartbeat:Connect(function(dt)
						if not D.on or not trail.Parent or tick() - t0 > D.maxDur or not hrp.Parent then
							conn:Disconnect()
							D.running = false
							return
						end
						if D.steer then
							local md = flat(hum.MoveDirection)
							if md then dir = md end
							-- faz o impulso do próprio jogo seguir a nova direção
							for _, c in ipairs(hrp:GetChildren()) do
								if not skipName(c.Name) then
									if c:IsA("BodyVelocity") then
										local v = c.Velocity
										local m = Vector3.new(v.X, 0, v.Z).Magnitude
										if m > 1 then c.Velocity = Vector3.new(dir.X * m, v.Y, dir.Z * m) end
									elseif c:IsA("LinearVelocity") then
										local v = c.VectorVelocity
										local m = Vector3.new(v.X, 0, v.Z).Magnitude
										if m > 1 then c.VectorVelocity = Vector3.new(dir.X * m, v.Y, dir.Z * m) end
									end
								end
							end
						end
						local step = D.speed * dt
						if D.walls then
							local hit = workspace:Raycast(hrp.Position, dir * (step + 2), params)
							if hit then step = math.max(0, hit.Distance - 2) end
						end
						if step > 0 then
							hrp.CFrame = hrp.CFrame + dir * step
						end
					end)
					st.Text = "💨 Dash longo (" .. D.count .. ")"
					st.TextColor3 = Color3.fromRGB(110, 255, 160)
				end
				local function bindChar(char)
					for _, cn in ipairs(D.conns) do if cn.char then cn.conn:Disconnect() end end
					local c1 = char.ChildAdded:Connect(function(c)
						if c.Name == "DashTrail" and D.on then pcall(runDash, char, c) end
					end)
					D.conns[#D.conns + 1] = {char = true, conn = c1}
				end
				addToggle(sec, "Dash Longo", function(state)
					D.on = state
					for _, cn in ipairs(D.conns) do cn.conn:Disconnect() end
					D.conns = {}
					D.running = false
					if not state then
						st.Text = "💤 Desligado"
						st.TextColor3 = Color3.fromRGB(150, 150, 180)
						return
					end
					st.Text = "💨 Pronto — faça um dash"
					st.TextColor3 = Color3.fromRGB(150, 220, 255)
					D.conns[#D.conns + 1] = {conn = player.CharacterAdded:Connect(function(ch) task.defer(bindChar, ch) end)}
					if player.Character then bindChar(player.Character) end
				end, false)
				addSlider(sec, "Velocidade extra do dash", 0, 400, 100, function(v) D.speed = v end, 0, " studs/s")
				addSlider(sec, "Duração máxima do impulso", 0.1, 1.5, 0.6, function(v) D.maxDur = v end, 1, "s")
				addToggle(sec, "Mudar de direção durante o dash", function(state) D.steer = state end, true)
				addToggle(sec, "Parar em paredes", function(state) D.walls = state end, true)
				screenGui.Destroying:Connect(function() D.on = false; for _, cn in ipairs(D.conns) do cn.conn:Disconnect() end end)
			end

			-- ===== Silent Aim Universal (aba Combate): vale para todas as armas, frutas e estilos =====
			-- Faz o jogo "ler" o mouse apontando para o alvo (Mouse.Hit / Target / X / Y / UnitRay e
			-- UserInputService:GetMouseLocation), então qualquer skill ou arma que mire no mouse acerta o alvo,
			-- sem mexer na câmera nem no cursor.
			do
				local sec = createSection(pages["Combate"], "Silent Aim Universal", sectionIcons.SilentGun)
				local st = tiny(sec, "💤 Desligado")
				local UIS = game:GetService("UserInputService")
				local GuiSvc = game:GetService("GuiService")
				local mouse = player:GetMouse()
				local S = {
					on = false, targets = "Both", priority = "Mouse", part = "Root", fov = 300, range = 600,
					friends = true, allies = true,
					target = nil, tpart = nil, pos = nil, sx = 0, sy = 0, name = "", dist = 0,
					hooked = false, conn = nil, last = 0,
					method = "GameRay", lead = false, leadTime = 0.15, cursorSaved = nil,
					skillsOnly = true, windowUntil = 0, exemptUntil = 0, touch = false, inputConn = nil, inputEnd = nil,
				}
				-- A mira só vale logo depois de uma skill/ataque (Z X C V F, clique ou toque); movimento como Soru/Dash/TP
				-- usa o mouse de verdade, para não teleportar você até o inimigo.
				S.active = function()
					if not S.skillsOnly then return true end
					local now = tick()
					if S.exemptUntil > now then return false end
					if S.touch then return true end
					return S.windowUntil > now
				end
				local SKILL_KEYS = {[Enum.KeyCode.Z] = true, [Enum.KeyCode.X] = true, [Enum.KeyCode.C] = true, [Enum.KeyCode.V] = true, [Enum.KeyCode.F] = true}
				local MOVE_PATTERNS = {"soru", "dash", "geppo", "flash"}
				local function isMoveButton(pos)
					local ok, objs = pcall(function() return player.PlayerGui:GetGuiObjectsAtPosition(pos.X, pos.Y) end)
					if not ok then return false end
					for _, o in ipairs(objs) do
						local cur = o
						for _ = 1, 4 do
							if not cur or cur == player.PlayerGui then break end
							local n = cur.Name:lower()
							for _, p in ipairs(MOVE_PATTERNS) do
								if n:find(p, 1, true) then return true end
							end
							cur = cur.Parent
						end
					end
					return false
				end
				local function onInputBegan(input)
					local t = input.UserInputType
					if t == Enum.UserInputType.Keyboard then
						S.touch = false
						if SKILL_KEYS[input.KeyCode] then S.windowUntil = tick() + 0.7 end
					elseif t == Enum.UserInputType.MouseButton1 then
						S.touch = false
						S.windowUntil = tick() + 0.7
					elseif t == Enum.UserInputType.Touch then
						S.touch = true
						if isMoveButton(Vector2.new(input.Position.X, input.Position.Y)) then
							S.exemptUntil = tick() + 1.2
						else
							S.windowUntil = tick() + 0.7
						end
					end
				end
				local function onInputEnded(input)
					local t = input.UserInputType
					if (t == Enum.UserInputType.Keyboard and SKILL_KEYS[input.KeyCode]) or t == Enum.UserInputType.MouseButton1 then
						S.windowUntil = math.max(S.windowUntil, tick() + 0.4)
					end
				end

				-- ===== Aim Assist do próprio jogo (sem hook): ajusta o AimAssistSettings que o script de combate já usa =====
				-- O tiro de arma de fogo chama AimAssist.getTargetInfo(); ele escolhe a cabeça de Characters/Enemies dentro
				-- de MaxDistance e do raio em pixels. Aumentando esses limites o próprio jogo mira no alvo.
				local assistCfg, assistOrig
				local function getAssistCfg()
					if assistCfg then return assistCfg end
					local ok, m = pcall(function() return require(ReplicatedStorage.Modules:WaitForChild("AimAssistSettings", 2)) end)
					if ok and type(m) == "table" and type(m.Profiles) == "table" then assistCfg = m end
					return assistCfg
				end
				local function applyAssist(on)
					local cfgT = getAssistCfg()
					if not cfgT then return false end
					if on then
						if not assistOrig then
							assistOrig = {}
							for name, prof in pairs(cfgT.Profiles) do
								if type(prof) == "table" and not assistOrig[prof] then
									assistOrig[prof] = {Enabled = prof.Enabled, MaxDistance = prof.MaxDistance,
										AssistRadiusPixels = prof.AssistRadiusPixels, InnerRadiusPixels = prof.InnerRadiusPixels}
								end
							end
						end
						local radius = S.fov > 0 and S.fov or 4000
						for _, prof in pairs(cfgT.Profiles) do
							if type(prof) == "table" then
								prof.Enabled = true
								prof.MaxDistance = S.range
								prof.AssistRadiusPixels = radius
								prof.InnerRadiusPixels = radius
							end
						end
					elseif assistOrig then
						for prof, o in pairs(assistOrig) do
							for k, v in pairs(o) do prof[k] = v end
						end
						assistOrig = nil
					end
					return true
				end

				local function installHooks()
					if S.hooked then return true end
					if not (hookmetamethod and newcclosure and getnamecallmethod) then return false end
					local checker = checkcaller or function() return false end
					local ok = pcall(function()
						local oldIndex
						oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
							if S.on and S.pos and self == mouse and (S.method == "Default" or S.method == "Full" or S.method == "AssistMouse") and S.active() and not checker() then
								if key == "Hit" then
									return CFrame.new(S.pos)
								elseif key == "Target" then
									return S.tpart
								elseif key == "X" then
									return S.sx
								elseif key == "Y" then
									return S.sy
								elseif key == "UnitRay" then
									local cam = workspace.CurrentCamera
									if cam then
										local o = cam.CFrame.Position
										return Ray.new(o, (S.pos - o).Unit)
									end
								elseif key == "Origin" and S.method == "Full" then
									local cam = workspace.CurrentCamera
									if cam then return CFrame.new(cam.CFrame.Position, S.pos) end
								end
							end
							return oldIndex(self, key)
						end))
						local oldNamecall
						oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
							if S.on and S.pos and (S.method == "Default" or S.method == "Full" or S.method == "AssistMouse" or S.method == "GameRay") and S.active() and not checker() then
								local method = getnamecallmethod()
								if self == UIS and S.method ~= "GameRay" then
									if method == "GetMouseLocation" then
										return Vector2.new(S.sx, S.sy + GuiSvc:GetGuiInset().Y)
									end
								elseif S.method == "GameRay" then
									-- O jogo calcula Mouse.Hit/Target (ReplicatedStorage.Mouse e WrapMouse) com um raio longo que sai da câmera
									-- (FindPartOnRay*). Apontando esse raio para o alvo, o próprio jogo monta Hit e Target no alvo.
									if self == workspace and (method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "FindPartOnRay") then
										local args = {...}
										local ray = args[1]
										local cam = workspace.CurrentCamera
										if typeof(ray) == "Ray" and cam and ray.Direction.Magnitude >= 500 and (ray.Origin - cam.CFrame.Position).Magnitude < 8 then
											local o = ray.Origin
											local d = S.pos - o
											args[1] = Ray.new(o, d.Unit * (d.Magnitude + 1.5))
											return oldNamecall(self, table.unpack(args, 1, select("#", ...)))
										end
									end
								elseif S.method == "Full" then
									if self == workspace.CurrentCamera and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
										local o = self.CFrame.Position
										return Ray.new(o, (S.pos - o).Unit)
									elseif self == workspace and method == "Raycast" then
										local args = {...}
										local origin, dir = args[1], args[2]
										if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" and dir.Magnitude > 50 then
											args[2] = (S.pos - origin).Unit * dir.Magnitude
											return oldNamecall(self, table.unpack(args, 1, select("#", ...)))
										end
									end
								end
							end
							return oldNamecall(self, ...)
						end))
					end)
					S.hooked = ok
					return ok
				end

				local function aimPoint()
					local cam = workspace.CurrentCamera
					if UIS:GetLastInputType() == Enum.UserInputType.Touch or UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
						return cam and cam.ViewportSize / 2 or Vector2.new(400, 300)
					end
					return UIS:GetMouseLocation()
				end

				local function isAllowed(plr)
					if S.friends then
						local ok, f = pcall(function() return player:IsFriendsWith(plr.UserId) end)
						if ok and f then return false end
					end
					if S.allies and aimAllies[plr] then return false end
					return true
				end

				local function pickTarget()
					local cam = workspace.CurrentCamera
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if not cam or not hrp then return nil end
					local center = aimPoint()
					local best, bestScore
					local function consider(model, label)
						local hum = model:FindFirstChildOfClass("Humanoid")
						if not hum or hum.Health <= 0 then return end
						local root = model:FindFirstChild("HumanoidRootPart")
						local part = (S.part == "Head" and model:FindFirstChild("Head")) or root
						if not part or not root then return end
						local dist = (root.Position - hrp.Position).Magnitude
						if dist > S.range then return end
						local v, onScreen = cam:WorldToViewportPoint(part.Position)
						if v.Z <= 0 then return end
						local fovDist = (Vector2.new(v.X, v.Y) - center).Magnitude
						if S.fov > 0 and (fovDist > S.fov or not onScreen) then return end
						local score
						if S.priority == "Mouse" then score = fovDist
						elseif S.priority == "Near" then score = dist
						else score = hum.Health end
						if not bestScore or score < bestScore then
							bestScore = score
							best = {part = part, model = model, name = label, dist = dist, v = v}
						end
					end
					if S.targets ~= "NPC" then
						for _, plr in ipairs(Players:GetPlayers()) do
							if plr ~= player and plr.Character and isAllowed(plr) then consider(plr.Character, plr.Name) end
						end
					end
					if S.targets ~= "Players" then
						local folder = workspace:FindFirstChild("Enemies")
						if folder then
							for _, m in ipairs(folder:GetChildren()) do
								if m:IsA("Model") then consider(m, m.Name) end
							end
						end
					end
					return best
				end

				local function update()
					if tick() - S.last < 0.05 then return end
					S.last = tick()
					local t = pickTarget()
					if t then
						S.target, S.tpart, S.pos = t.model, t.part, t.part.Position
						S.sx, S.sy = t.v.X, t.v.Y - GuiSvc:GetGuiInset().Y
						if S.lead then
							-- mira um pouco à frente do alvo (posição + velocidade x tempo)
							local okv, vel = pcall(function() return t.part.AssemblyLinearVelocity end)
							if okv and vel then
								S.pos = S.pos + vel * S.leadTime
								local cam = workspace.CurrentCamera
								local v2 = cam and cam:WorldToViewportPoint(S.pos)
								if v2 then S.sx, S.sy = v2.X, v2.Y - GuiSvc:GetGuiInset().Y end
							end
						end
						S.name, S.dist = t.name, t.dist
					else
						S.target, S.tpart, S.pos = nil, nil, nil
					end
				end

				local lastStatus = 0
				addToggle(sec, "Silent Aim Universal", function(state)
					S.on = state
					if S.conn then S.conn:Disconnect(); S.conn = nil end
					if S.inputConn then S.inputConn:Disconnect(); S.inputConn = nil end
					if S.inputEnd then S.inputEnd:Disconnect(); S.inputEnd = nil end
					S.target, S.tpart, S.pos = nil, nil, nil
					if not state then
						pcall(applyAssist, false)
						pcall(function() player:SetAttribute("AAIM", nil) end)
						st.Text = "💤 Desligado"
						st.TextColor3 = Color3.fromRGB(150, 150, 180)
						return
					end
					if not installHooks() and S.method ~= "Assist" and S.method ~= "AAIM" then
						S.on = false
						st.Text = "❌ Executor sem hookmetamethod"
						st.TextColor3 = Color3.fromRGB(255, 120, 120)
						note("Seu executor não suporta hookmetamethod", Color3.fromRGB(255, 120, 120))
						return
					end
					S.inputConn = UIS.InputBegan:Connect(function(input) pcall(onInputBegan, input) end)
					S.inputEnd = UIS.InputEnded:Connect(function(input) pcall(onInputEnded, input) end)
					S.conn = RunService.RenderStepped:Connect(function()
						pcall(update)
						if tick() - (S.assistAt or 0) > 0.5 then
							S.assistAt = tick()
							pcall(function()
								local want = (S.method == "AAIM") or nil
								if player:GetAttribute("AAIM") ~= want then player:SetAttribute("AAIM", want) end
							end)
							pcall(applyAssist, S.method == "Assist" or S.method == "AssistMouse" or S.method == "GameRay")
						end
						pcall(function()
							local now = tick()
							local windowOpen = S.pos and S.windowUntil > now and S.exemptUntil <= now
							if S.method == "Camera" and windowOpen then
								local cam = workspace.CurrentCamera
								if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, S.pos) end
							elseif S.method == "Cursor" then
								if windowOpen then
									if not S.cursorSaved then S.cursorSaved = UIS:GetMouseLocation() end
									local x, y = S.sx, S.sy + GuiSvc:GetGuiInset().Y
									if mousemoveabs then
										mousemoveabs(x, y)
									else
										local vim = game:GetService("VirtualInputManager")
										vim:SendMouseMoveEvent(x, y, game)
									end
								elseif S.cursorSaved then
									local c = S.cursorSaved
									S.cursorSaved = nil
									if mousemoveabs then mousemoveabs(c.X, c.Y) end
								end
							end
						end)
						if tick() - lastStatus > 0.3 then
							lastStatus = tick()
							if S.pos then
								st.Text = "🎯 " .. S.name .. " (" .. math.floor(S.dist) .. "m)"
								st.TextColor3 = Color3.fromRGB(110, 255, 160)
							else
								st.Text = "👀 Sem alvo"
								st.TextColor3 = Color3.fromRGB(190, 190, 230)
							end
						end
					end)
				end, false)
				simpleDD(sec, "Alvos: ", {{"Both", "Players e NPCs"}, {"Players", "Só players"}, {"NPC", "Só NPCs"}}, "Both", 3,
					function(v) S.targets = v end, "Silent: alvos", function() return S.targets end)
				simpleDD(sec, "Prioridade: ", {{"Mouse", "Mais perto da mira"}, {"Near", "Mais perto de mim"}, {"Health", "Menor vida"}}, "Mouse", 3,
					function(v) S.priority = v end, "Silent: prioridade", function() return S.priority end)
				addSlider(sec, "FOV (0 = tela toda)", 0, 1000, 300, function(v) S.fov = v; S.assistAt = 0 end, 0, " px")
				addSlider(sec, "Alcance", 50, 3000, 600, function(v) S.range = v; S.assistAt = 0 end, 0, " studs")
				addToggle(sec, "Ignorar amigos do Roblox", function(state) S.friends = state end, true)
				addToggle(sec, "Ignorar aliados do Aim", function(state) S.allies = state end, true)
				screenGui.Destroying:Connect(function() S.on = false; pcall(applyAssist, false); pcall(function() player:SetAttribute("AAIM", nil) end); if S.conn then S.conn:Disconnect() end; if S.inputConn then S.inputConn:Disconnect() end; if S.inputEnd then S.inputEnd:Disconnect() end end)
			end

			-- ===== Anti Stun (aba Combate) =====
			do
				local sec = createSection(pages["Combate"], "Anti Stun", sectionIcons.Physical)
				local st = tiny(sec, "💤 Desligado")
				local A = {conn = nil, clearStun = true, noRagdoll = true, restoreSpeed = true, cleared = 0,
					lastWalk = nil, lastJump = nil, lastTick = 0, freeBusy = true, allowAttack = true, on = false, origCan = nil, combatUtil = nil}
				-- O script de combate do jogo só ataca se CombatUtil:CanAttack(personagem, ferramenta) deixar, e trava ações com
				-- Global.busy. O estado de stun vem como atributos/tags no personagem. Aqui limpamos tudo que tenha cara de stun.
				local KEYS = {"stun", "freez", "frozen", "paraly", "ragdoll", "knock", "busy", "slow"}
				local function badName(n)
					n = tostring(n):lower()
					for _, k in ipairs(KEYS) do
						if n:find(k, 1, true) then return true end
					end
					return false
				end
				local function cleanInst(inst)
					local did = false
					local okA, attrs = pcall(function() return inst:GetAttributes() end)
					if okA then
						for k, v in pairs(attrs) do
							if badName(k) then
								if v == true then pcall(function() inst:SetAttribute(k, false) end); did = true
								elseif type(v) == "number" and v ~= 0 then pcall(function() inst:SetAttribute(k, 0) end); did = true end
							end
						end
					end
					local okT, tags = pcall(function() return inst:GetTags() end)
					if okT then
						for _, t in ipairs(tags) do
							if badName(t) then pcall(function() inst:RemoveTag(t) end); did = true end
						end
					end
					return did
				end
				local function hookCanAttack(on)
					if on then
						if A.origCan then return end
						local ok, cu = pcall(function() return require(game:GetService("ReplicatedStorage").Modules.CombatUtil) end)
						if ok and type(cu) == "table" and type(cu.CanAttack) == "function" then
							A.combatUtil, A.origCan = cu, cu.CanAttack
							cu.CanAttack = function(self, ...)
								local r = A.origCan(self, ...)
								if not r and A.on and A.allowAttack then
									-- só libera se o bloqueio vier de stun/busy (limpamos antes e testamos de novo)
									pcall(function()
										local ch = player.Character
										if ch then
											-- CombatUtil:CanAttack barra se existir Stun (NumberValue > 0) ou Busy (BoolValue true) no personagem
											local sv, bv = ch:FindFirstChild("Stun"), ch:FindFirstChild("Busy")
											if sv and sv:IsA("ValueBase") and (tonumber(sv.Value) or 0) > 0 then sv.Value = 0 end
											if bv and bv:IsA("ValueBase") and bv.Value then bv.Value = false end
											cleanInst(ch)
											local h = ch:FindFirstChildOfClass("Humanoid")
											if h then cleanInst(h) end
										end
									end)
									return A.origCan(self, ...)
								end
								return r
							end
						end
					elseif A.origCan and A.combatUtil then
						A.combatUtil.CanAttack = A.origCan
						A.origCan, A.combatUtil = nil, nil
					end
				end
				local STUN_NAMES = {Stun = true, Stunned = true, Busy = true, Freeze = true, Frozen = true, Slowed = true}
				local BAD_STATES = {Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.PlatformStanding}
				local function stateGuard(hum, enable)
					for _, t in ipairs({Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.FallingDown}) do
						pcall(function() hum:SetStateEnabled(t, enable) end)
					end
				end
				local function step()
					local char = player.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not char or not hum or hum.Health <= 0 then return end
					local hit = false
					if A.clearStun then
						for _, c in ipairs(char:GetChildren()) do
							if STUN_NAMES[c.Name] then
								if c:IsA("NumberValue") or c:IsA("IntValue") then
									if c.Value ~= 0 then c.Value = 0; hit = true end
								elseif c:IsA("BoolValue") then
									if c.Value then c.Value = false; hit = true end
								end
							end
						end
						for name in pairs(STUN_NAMES) do
							local v = char:GetAttribute(name)
							if v == true then pcall(function() char:SetAttribute(name, false) end); hit = true
							elseif type(v) == "number" and v ~= 0 then pcall(function() char:SetAttribute(name, 0) end); hit = true end
						end
					end
					if A.clearStun then
						if cleanInst(char) then hit = true end
						if cleanInst(hum) then hit = true end
						-- KnockbackRenderer: o empurrão visual (rotação do corpo) vem dos atributos LastDetected* do HumanoidRootPart
						local rootp = char:FindFirstChild("HumanoidRootPart")
						if rootp and rootp:GetAttribute("LastDetectedKnockback") then
							pcall(function() rootp:SetAttribute("LastDetectedKnockback", nil) end)
							hit = true
						end
					end
					if A.freeBusy then
						pcall(function()
							local g = require(game:GetService("ReplicatedStorage").Global)
							if g.busy then g.busy = false; hit = true end
						end)
					end
					if A.noRagdoll then
						if hum.PlatformStand then hum.PlatformStand = false; hit = true end
						local cur = hum:GetState()
						for _, bad in ipairs(BAD_STATES) do
							if cur == bad then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end); hit = true break end
						end
					end
					if A.restoreSpeed then
						-- guarda os últimos valores normais e devolve quando o jogo zera (congelamento)
						if hum.WalkSpeed > 0 then A.lastWalk = hum.WalkSpeed elseif A.lastWalk then hum.WalkSpeed = A.lastWalk; hit = true end
						if hum.UseJumpPower then
							if hum.JumpPower > 0 then A.lastJump = hum.JumpPower elseif A.lastJump then hum.JumpPower = A.lastJump; hit = true end
						else
							if hum.JumpHeight > 0 then A.lastJump = hum.JumpHeight elseif A.lastJump then hum.JumpHeight = A.lastJump; hit = true end
						end
					end
					if hit then
						A.cleared = A.cleared + 1
						if tick() - A.lastTick > 0.3 then
							A.lastTick = tick()
							st.Text = "🛡️ Stun removido (" .. A.cleared .. "x)"
							st.TextColor3 = Color3.fromRGB(110, 255, 160)
						end
					end
				end
				addToggle(sec, "Anti Stun", function(state)
					if A.conn then A.conn:Disconnect(); A.conn = nil end
					local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					A.on = state
					pcall(hookCanAttack, state)
					if not state then
						if hum then stateGuard(hum, true) end
						st.Text = "💤 Desligado"
						st.TextColor3 = Color3.fromRGB(150, 150, 180)
						return
					end
					A.cleared = 0
					A.lastWalk, A.lastJump = nil, nil
					st.Text = "🛡️ Protegido"
					st.TextColor3 = Color3.fromRGB(150, 220, 255)
					A.conn = RunService.Heartbeat:Connect(function()
						pcall(step)
					end)
				end, false)
				addToggle(sec, "Limpar Stun/Busy", function(state) A.clearStun = state end, true)
				addToggle(sec, "Liberar ações travadas (busy)", function(state) A.freeBusy = state end, true)
