		}
		local stepTime = 0.34
		task.wait(0.55) -- deixa a entrada em cascata terminar
		for _, step in ipairs(steps) do
			task.spawn(setStatus, step.text, step.animated)
			TweenService:Create(loadBarFill, TweenInfo.new(stepTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(step.progress, 0, 1, 0)
			}):Play()
			task.wait(stepTime)
		end
		task.wait(0.25)

		-- Saída: o card encolhe levemente enquanto tudo some.
		leaving = true
		local fadeOut = TweenInfo.new(0.34, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local fades = {
			{loadScale, {Scale = baseScale * 0.94}},
			{loadWrapper, {BackgroundTransparency = 1}},
			{loadStroke, {Transparency = 1}},
			{trackStroke, {Transparency = 1}},
			{ringStroke, {Transparency = 1}},
			{iconBox, {BackgroundTransparency = 1}},
			{iconBoxStroke, {Transparency = 1}},
			{loadIcon, {TextTransparency = 1}},
			{loadTitle, {TextTransparency = 1}},
			{loadSubtitle, {TextTransparency = 1}},
			{loadStatus, {TextTransparency = 1}},
			{percentLabel, {TextTransparency = 1}},
			{loadFooter, {TextTransparency = 1}},
			{loadBarBg, {BackgroundTransparency = 1}},
			{loadBarFill, {BackgroundTransparency = 1}},
			{shimmer, {BackgroundTransparency = 1}},
			{loadAccent, {BackgroundTransparency = 1}},
			{backdrop, {BackgroundTransparency = 1}},
		}
		for _, fade in ipairs(fades) do
			TweenService:Create(fade[1], fadeOut, fade[2]):Play()
		end
		for _, particle in ipairs(loadingParticles) do
			if particle.Parent then TweenService:Create(particle, fadeOut, {BackgroundTransparency = 1}):Play() end
		end
		if blur then TweenService:Create(blur, fadeOut, {Size = 0}):Play() end
		task.wait(0.36)
		loadWrapper:Destroy()
		backdrop:Destroy()
		if blur then blur:Destroy() end
		if screenGui.Parent then showMainPanel() end
	end)
end

