		function Q.questEnemies()
			local list = {}
			local folder = workspace:FindFirstChild("Enemies")
			if not folder then return list end
			for _, obj in ipairs(folder:GetChildren()) do
				if obj:IsA("Model") then
					local hum = obj:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 and (not Q.taskType or obj.Name:lower():find(Q.taskType:lower(), 1, true)) then
						local part = obj:FindFirstChild("Head") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("HumanoidRootPart")
						if part then table.insert(list, {model = obj, part = part, hum = hum}) end
					end
				end
			end
			return list
		end

		-- Procura inimigos sem ficar parado: vai até o spawn da missão, se achar; senão vagueia
		function Q.findSpawn(hrp)
			if tick() - (Q.spawnCheckAt or 0) < 3 then return Q.spawnPart end
			Q.spawnCheckAt = tick()
			Q.spawnPart = nil
			pcall(function()
				local origin = workspace:FindFirstChild("_WorldOrigin")
				local folder = origin and origin:FindFirstChild("EnemySpawns")
				if not folder or not Q.taskType then return end
				local key = Q.taskType:lower()
				local bestD = math.huge
				for _, obj in ipairs(folder:GetChildren()) do
					if obj.Name:lower():find(key, 1, true) then
						local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
						if part then
							local d = (part.Position - hrp.Position).Magnitude
							if d < bestD then bestD = d; Q.spawnPart = part end
						end
					end
				end
			end)
			return Q.spawnPart
		end

		function Q.searchMove()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			local spawn = Q.findSpawn(hrp)
			if spawn and spawn.Parent then
				local offset = (spawn.Position + Vector3.new(0, Q.hoverHeight + 4, 0)) - hrp.Position
				if offset.Magnitude > 12 then
					Q.fly(hrp, offset.Unit * Q.flySpeed)
					return
				end
			end
			-- vagueia: troca de direção a cada 2s
			if tick() - Q.wanderAt > 2 then
				Q.wanderAt = tick()
				Q.wanderAngle = math.random() * math.pi * 2
			end
			Q.fly(hrp, Vector3.new(math.cos(Q.wanderAngle), 0, math.sin(Q.wanderAngle)) * Q.flySpeed)
		end

		-- Segura o boneco parado no lugar (zera a velocidade; o BodyVelocity evita cair com o noclip)
		function Q.hold()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			Q.fly(hrp, Vector3.zero)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end

		function Q.step()
			local phase = Q.phase
			if phase == "accepting" then
				Q.updateStatus("📜 " .. tostring(Q.questName) .. "\nAceitando (" .. (Q.method == 1 and "direto" or "diálogo") .. ")...", Color3.fromRGB(255, 200, 100))
				if Q.weapon ~= "Any" then Q.ensureWeapon() end
				-- continua voando (noclip + parado no ar) enquanto aceita, sem cair nem parar de vez
				Q.enableNoclip()
				Q.hold()
				Q.spawnPart, Q.spawnCheckAt = nil, 0 -- esquece o spawn da quest/sessão anterior
				Q.acceptQuest()
				Q.acceptedAt = tick()
				Q.noEnemySince = 0
				Q.searchSince = 0
				Q.completed = false
				Q.engaged = false
				Q.clearCompletedFlag()
				Q.phase = "flying"
				Q.updateStatus("🕊️ Voando...", Color3.fromRGB(150, 200, 255))

			elseif phase == "flying" then
				local enemies = Q.questEnemies()
				if #enemies == 0 then
					if Q.isComplete() then
						Q.phase = "returning"
						Q.updateStatus("🏃 Quest completa!\nEntregando...", Color3.fromRGB(100, 200, 255))
					else
						if Q.searchSince == 0 then Q.searchSince = tick() end
						local searched = tick() - Q.searchSince
						Q.updateStatus("🔍 " .. tostring(Q.questName) .. "\nProcurando inimigos... " .. math.floor(searched) .. "s", Color3.fromRGB(200, 200, 100))
						Q.searchMove()
					end
				else
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if not hrp then return end
					Q.searchSince = 0
					local nearest, nd = nil, math.huge
					for _, e in ipairs(enemies) do
						local d = (e.part.Position - hrp.Position).Magnitude
						if d < nd then nd = d; nearest = e end
					end
					Q.updateStatus("🕊️ Voando até " .. tostring(Q.taskType or "?") .. "\nDist: " .. math.floor(nd), Color3.fromRGB(150, 200, 255))
					if nd <= Q.hoverHeight + 4 then
						Q.stopFly()
						Q.engaged = true
						Q.phase = "farming"
						Q.updateStatus("⚔️ Atacando...", Color3.fromRGB(255, 100, 200))
					else
						Q.fly(hrp, (nearest.part.Position - hrp.Position).Unit * Q.flySpeed)
					end
				end

			elseif phase == "farming" then
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				local enemies = Q.questEnemies()

				if Q.isComplete() then
					Q.hold()
					Q.updateStatus("✅ Completa!\nCompletando...", Color3.fromRGB(100, 255, 100))
					Q.completeQuest()
					task.wait(0.8)
					Q.fallback = nil
					Q.updateSelection()
					Q.updateStatus("🔄 Reaceitando...", Color3.fromRGB(180, 255, 200))
					Q.acceptQuest()
					Q.completed = false
					Q.engaged = false
					Q.spawnPart, Q.spawnCheckAt = nil, 0
					Q.noEnemySince = 0
					Q.acceptedAt = tick()
					Q.clearCompletedFlag()
					Q.enableNoclip()
					Q.phase = "flying"
					Q.updateStatus("🕊️ Voando de novo...", Color3.fromRGB(150, 200, 255))
					return
				end

				if #enemies == 0 then
					if Q.noEnemySince == 0 then Q.noEnemySince = tick() end
					local waited = tick() - Q.noEnemySince
					if waited > 15 then
						Q.updateStatus("🔍 Procurando\noutro canto...", Color3.fromRGB(200, 180, 100))
						Q.phase = "flying"
						Q.noEnemySince = 0
						return
					end
					Q.hold()
					Q.updateStatus("⏳ " .. tostring(Q.questName) .. "\nRespawn " .. math.floor(waited) .. "s...", Color3.fromRGB(200, 200, 100))
					task.wait(0.3)
					return
				end

				if Q.weapon ~= "Any" then Q.ensureWeapon() end
				Q.noEnemySince = 0
				local nearest, nd = nil, math.huge
				for _, e in ipairs(enemies) do
					local d = (e.part.Position - hrp.Position).Magnitude
					if d < nd then nd = d; nearest = e end
				end
				if nearest then
					local offset = (nearest.part.Position + Vector3.new(0, Q.hoverHeight, 0)) - hrp.Position
					if offset.Magnitude > 2 then
						Q.fly(hrp, offset.Unit * math.min(Q.flySpeed, offset.Magnitude * 5))
					elseif Q.bv then
						Q.bv.Velocity = Vector3.zero
					end
					for _, e in ipairs(enemies) do
						if e.hum and e.hum.Health > 0 and (e.part.Position - hrp.Position).Magnitude <= Q.aoeRange then
							pcall(function() e.hum:MoveTo(hrp.Position) end)
						end
					end
					Q.aoeHit()
					Q.updateStatus("⚔️ " .. tostring(Q.questName) .. "\n" .. #enemies .. " " .. tostring(Q.taskType or "?") .. " | #" .. Q.questIndex, Color3.fromRGB(255, 150, 100))
				end

			elseif phase == "returning" then
				Q.enableNoclip()
				Q.hold()
				Q.updateStatus("🏃 Entregando...", Color3.fromRGB(100, 200, 255))
				Q.completeQuest()
				task.wait(1)
				Q.fallback = nil
				Q.updateSelection()
				Q.completed = false
				Q.acceptedAt = 0
				Q.noEnemySince = 0
				Q.clearCompletedFlag()
				Q.phase = "accepting"
			end
		end

		-- Aura (Buso): enquanto o Auto Farm Level estiver ligado, confere a cada 0.2s e liga a aura
		-- se ela não estiver ativa (também religa depois de morrer). Ao desligar o farm, desliga o laço.
		function Q.startAura()
			Q.auraToken = (Q.auraToken or 0) + 1
			local token = Q.auraToken
			task.spawn(function()
				while Q.auraToken == token and screenGui.Parent do
					local char = player.Character
					if Q.commF and char and char.Parent and not char:FindFirstChild("HasBuso") then
						pcall(function() Q.commF:InvokeServer("Buso") end)
					end
					task.wait(0.2)
				end
			end)
		end

		function Q.stopAura()
			Q.auraToken = (Q.auraToken or 0) + 1 -- invalida o laço atual
		end

		function Q.start()
			if not Q.init() then
				Q.updateStatus("❌ Módulos não encontrados\n(veja o F9)", Color3.fromRGB(255, 120, 120))
				return
			end
			Q.stop()
			Q.enabled = true
			Q.startAura()
			Q.fallback = nil
			Q.searchSince = 0
			Q.updateSelection()
			Q.completed = false
			Q.engaged = false
			Q.spawnPart, Q.spawnCheckAt = nil, 0
			Q.phase = "accepting"
			Q.acceptedAt = 0
			Q.noEnemySince = 0
			Q.updateLevelInfo()
			Q.conn = RunService.Heartbeat:Connect(function()
				if not screenGui.Parent then Q.stop() return end
				if not Q.enabled or Q.busy then return end
				Q.busy = true -- evita rodar duas etapas ao mesmo tempo (várias têm task.wait)
				local ok, err = pcall(Q.step)
				if not ok then warn("[Aetheris] Auto Farm Level:", err) end
				Q.busy = false
			end)
			task.spawn(function()
				while Q.enabled and screenGui.Parent do
					task.wait(2)
					if Q.enabled then
						Q.updateLevelInfo()
						local oldCat = Q.questCat
						Q.updateSelection()
						if oldCat ~= Q.questCat then
							Q.updateStatus("🆙 Level up! " .. tostring(Q.questName), Color3.fromRGB(150, 255, 200))
							Q.updateLevelInfo()
							Q.phase = "accepting"
						end
					end
				end
			end)
		end

		function Q.stop()
			Q.enabled = false
			Q.stopAura()
			if Q.conn then Q.conn:Disconnect(); Q.conn = nil end
			Q.stopFly()
			Q.disableNoclip()
			Q.phase = "idle"
			Q.busy = false
		end

		function Q.debug()
			print("=== 🔍 DEBUG Auto Farm Level ===")
			print("Método:", Q.method == 1 and "Direto" or "Diálogo", "| Arma:", Q.weapon)
			print("Categoria:", Q.questCat, "| Nome:", Q.questName, "#" .. Q.questIndex, "| Fase:", Q.phase)
			print("questCompleted:", Q.completed, "| desde accept:", math.floor(tick() - Q.acceptedAt) .. "s")
			local char = player.Character
			if char then
				for _, t in ipairs(char:GetChildren()) do
					if t:IsA("Tool") then print("  [EQUIPADA]", t.Name, "tipo:", tostring(Q.toolType(t))) end
				end
			end
			local bp = player:FindFirstChild("Backpack")
			if bp then
				for _, t in ipairs(bp:GetChildren()) do
					if t:IsA("Tool") then print("  [BACKPACK]", t.Name, "tipo:", tostring(Q.toolType(t))) end
				end
			end
			print("=== FIM ===")
		end

		-- Reaplica noclip/voo ao renascer
		player.CharacterAdded:Connect(function()
			if Q.enabled then
				Q.stopFly()
				table.clear(Q.origCollision)
				if Q.noclipConn then Q.noclipConn:Disconnect(); Q.noclipConn = nil end
				if Q.phase ~= "accepting" then Q.phase = "flying" end
				task.wait(1)
				if Q.enabled and Q.phase == "flying" then Q.enableNoclip() end
			end
		end)

		-- ===== CONFIGURAÇÕES NA INTERFACE =====
		addToggle(secAFL, "Auto  Farm  Level", function(state)
			if state then Q.start() else
				Q.stop()
				Q.updateStatus("💤 Desligado", Color3.fromRGB(150, 150, 180))
			end
		end, false)

		local weaponWarn = nil
		local weaponLabels = {Melee = "Punho", Fruit = "Fruta", Sword = "Espada"}
		local weaponIcons = {
			Melee = {Image = "rbxassetid://7733955664"}, -- mão de combate
			Fruit = {Image = "rbxassetid://16898612629", Offset = Vector2.new(563, 869), RectSize = Vector2.new(48, 48)}, -- fruta
			Sword = {Image = "rbxassetid://16898613777", Offset = Vector2.new(967, 759), RectSize = Vector2.new(48, 48)}, -- espadas
		}
		local function applyWeapon(v)
			Q.weapon = v
			if weaponWarn then weaponWarn.Visible = (v == "Fruit") end
			Q.updateLevelInfo()
		end
		local weaponDD = AetherisDropdown(secAFL, {
			prefix = "Arma para farmar: ",
			label = weaponLabels.Melee,
			icon = weaponIcons.Melee,
			value = "Melee",
			maxRows = 3,
			getOptions = function()
				return {
					{label = weaponLabels.Melee, value = "Melee", icon = weaponIcons.Melee},
					{label = weaponLabels.Fruit, value = "Fruit", icon = weaponIcons.Fruit},
					{label = weaponLabels.Sword, value = "Sword", icon = weaponIcons.Sword},
				}
			end,
			onSelect = applyWeapon,
		})
		-- aviso logo abaixo do dropdown (só aparece com Fruta selecionada)
		weaponWarn = makeInfoBox(40, "⚠️ Para usar a Fruta, ela precisa ter CLICK (a habilidade de clique/ataque básico). Fruta sem click não ataca.")
		weaponWarn.TextColor3 = Color3.fromRGB(255, 205, 110)
		weaponWarn.TextSize = 9
		weaponWarn.BackgroundColor3 = Color3.fromRGB(60, 46, 16)
		weaponWarn.Visible = false

			registerConfigBinding(secAFL, "Farm Level: arma", function() return Q.weapon end, function(v)
					if v == "Any" then v = "Melee" end -- migra presets antigos da opção removida
					if weaponLabels[v] then weaponDD.setValue(v, weaponLabels[v], weaponIcons[v]); applyWeapon(v) end
			end)

		addSlider(secAFL, "Ataque Range", 10, 300, 80, function(val) Q.aoeRange = val end, 0, " studs")
		addSlider(secAFL, "Velocidade de voo", 10, 300, 120, function(val) Q.flySpeed = val end, 0)
		addSlider(secAFL, "Altura sobre o inimigo", 2, 30, 6, function(val) Q.hoverHeight = val end, 0, " studs")

		task.spawn(function()
			task.wait(1)
			if screenGui.Parent then
				pcall(function()
					if Q.init() then Q.updateLevelInfo() end
				end)
			end
		end)

		screenGui.Destroying:Connect(Q.stop)
	end

	-----------------------------------------------------------------
	-- AUTO ATTACK (ataca automaticamente quem estiver ao redor)
	-----------------------------------------------------------------
	do
		local secAutoAttack = createSection(aimLockPage, "Atacar Automáticamente", sectionIcons.AutoAttack)
		local AA = {
			enabled = false, players = true, npcs = true, range = 25, delay = 0.15,
			lastAttack = 0, conn = nil, loaded = false
		}
		-- Input falso para armas à distância (usam o mouse.Hit internamente)
		local fakeInput = {
			UserInputType = Enum.UserInputType.MouseButton1,
			UserInputState = Enum.UserInputState.Begin,
			Position = Vector3.zero,
			Delta = Vector3.zero,
			KeyCode = Enum.KeyCode.Unknown,
		}

		local function loadModules()
			if AA.loaded then return true end
			local okCC, CC = pcall(function() return require(ReplicatedStorage.Controllers.CombatController) end)
			if not okCC or not CC then
				warn("[Aetheris] Auto Attack: CombatController indisponível")
				return false
			end
			local okCU, CU = pcall(function() return require(ReplicatedStorage.Modules.CombatUtil) end)
			AA.CC = CC
			AA.CU = okCU and CU or nil
			AA.loaded = true
			return true
		end

		local function getEquippedTool()
			local char = player.Character
			if not char then return nil end
			local tool = char:FindFirstChildOfClass("Tool")
			if not tool or not tool:FindFirstChild("LocalEquippedWeaponPointer") then return nil end
			return tool
		end

		local function isValidTarget(obj)
			if not obj or not obj.Parent then return false end
			local myChar = player.Character
			if not myChar or obj == myChar then return false end
			local hum = obj:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then return false end
			local summoner = obj:FindFirstChild("Summoner")
			if summoner and summoner.Value == player then return false end
			local myHRP = myChar:FindFirstChild("HumanoidRootPart")
			local tHRP = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
			if not myHRP or not tHRP then return false end
			if (tHRP.Position - myHRP.Position).Magnitude > AA.range then return false end
			return true, tHRP, hum
		end

		local function findTarget()
			local myChar = player.Character
			local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not myHRP then return nil end
			local best, bestDist = nil, math.huge
			local function scan(folder)
				if not folder then return end
				for _, obj in ipairs(folder:GetChildren()) do
					local ok, hrp = isValidTarget(obj)
					if ok then
						local d = (hrp.Position - myHRP.Position).Magnitude
						if d < bestDist then
							bestDist = d
							best = {char = obj, hrp = hrp, dist = d}
						end
					end
				end
			end
			if AA.players then scan(workspace:FindFirstChild("Characters")) end
			if AA.npcs then scan(workspace:FindFirstChild("Enemies")) end
			return best
		end

		local function faceTarget(targetHRP)
			local char = player.Character
			local myHRP = char and char:FindFirstChild("HumanoidRootPart")
			if not myHRP then return end
			local pos, tp = myHRP.Position, targetHRP.Position
			myHRP.CFrame = CFrame.lookAt(pos, Vector3.new(tp.X, pos.Y, tp.Z))
		end

		local function tryAttack()
			if tick() - AA.lastAttack < AA.delay then return end
			local tool = getEquippedTool()
			if not tool then return end
			local char = player.Character
			if AA.CU then
				local okData, wdata = pcall(function()
					return AA.CU:GetWeaponData(AA.CU:GetWeaponName(tool))
				end)
				if not okData or not wdata then return end
				local okCan, canAttack = pcall(function() return AA.CU:CanAttack(char, wdata.WeaponType) end)
				if okCan and not canAttack then return end
			end
			AA.lastAttack = tick()
			local ok = pcall(function() AA.CC:Attack(tool, fakeInput) end)
			if not ok then pcall(function() tool:Activate() end) end
		end

		local function stopAutoAttack()
			AA.enabled = false
			if AA.conn then AA.conn:Disconnect(); AA.conn = nil end
		end

		local function startAutoAttack()
			if not loadModules() then return end
			if AA.conn then AA.conn:Disconnect() end
			AA.enabled = true
			AA.conn = RunService.Heartbeat:Connect(function()
				if not screenGui.Parent then stopAutoAttack() return end
				if not AA.enabled then return end
				local target = findTarget()
				if target then
					faceTarget(target.hrp)
					tryAttack()
				end
			end)
		end

		addToggle(secAutoAttack, "Atacar Automáticamente", function(state)
			if state then startAutoAttack() else stopAutoAttack() end
		end, false)
		addToggle(secAutoAttack, "Atacar Players", function(state) AA.players = state end, true)
		addToggle(secAutoAttack, "Atacar NPCs", function(state) AA.npcs = state end, true)
		addSlider(secAutoAttack, "Alcance", 5, 150, 25, function(val) AA.range = val end, 0, " studs")
		addSlider(secAutoAttack, "Delay entre ataques", 0.05, 1, 0.15, function(val) AA.delay = math.max(0.05, val) end, 2, "s")

		screenGui.Destroying:Connect(stopAutoAttack)
	end

	-----------------------------------------------------------------
	-- VELOCIDADE DE ATAQUE (aba Combate)
	-----------------------------------------------------------------
	do
		local secAttackSpeed = createSection(aimLockPage, "Velocidade de Ataque", sectionIcons.AttackSpeed)
		local AS = {enabled = false, mult = 1.5, conn = nil, charConn = nil, loaded = false, orig = {}}

		local function loadModules()
			if AS.loaded then return true end
			local okCU, CU = pcall(function() return require(ReplicatedStorage.Modules.CombatUtil) end)
			local okG, G = pcall(function() return require(ReplicatedStorage.Global) end)
			AS.CU = okCU and CU or nil
			AS.G = okG and G or nil
			if not AS.CU and not AS.G then
				warn("[Aetheris] Velocidade de Ataque: módulos do jogo indisponíveis")
				return false
			end
			-- guarda as funções originais (uma única vez)
			if AS.CU then
				AS.orig.padding = AS.CU.GetComboPaddingTime
				AS.orig.cancel = AS.CU.GetAttackCancelMultiplier
				AS.orig.aoe = AS.CU.GetDefaultAOEDelay
			end
			AS.loaded = true
			return true
		end

		local function applyHooks()
			local CU = AS.CU
			if not CU then return end
			CU.GetComboPaddingTime = function() return 0.05 end
			CU.GetAttackCancelMultiplier = function() return 0.3 end
			CU.GetDefaultAOEDelay = function() return 0.05 end
		end

		local function removeHooks()
			local CU = AS.CU
			if not CU then return end
			if AS.orig.padding then CU.GetComboPaddingTime = AS.orig.padding end
			if AS.orig.cancel then CU.GetAttackCancelMultiplier = AS.orig.cancel end
			if AS.orig.aoe then CU.GetDefaultAOEDelay = AS.orig.aoe end
		end

		local function applySpeedAttr()
			local char = player.Character
			if char then char:SetAttribute("AttackSpeedMultiplier", AS.mult) end
		end

		local function clearSpeedAttr()
			local char = player.Character
			if char then char:SetAttribute("AttackSpeedMultiplier", nil) end
		end

		local function stopAttackSpeed()
			AS.enabled = false
			if AS.conn then AS.conn:Disconnect(); AS.conn = nil end
			if AS.charConn then AS.charConn:Disconnect(); AS.charConn = nil end
			if AS.loaded then
				if AS.G then AS.G.tapCooldown = 0 end
				removeHooks()
			end
			clearSpeedAttr()
		end

		local function startAttackSpeed()
			if not loadModules() then return end
			AS.enabled = true
			applyHooks()
			applySpeedAttr()
			if AS.conn then AS.conn:Disconnect() end
			AS.conn = RunService.Heartbeat:Connect(function()
				if not screenGui.Parent then stopAttackSpeed() return end
				if not AS.enabled then return end
				applySpeedAttr()
				if AS.G then AS.G.tapCooldown = 0 end
			end)
			-- reaplica ao renascer
			if AS.charConn then AS.charConn:Disconnect() end
			AS.charConn = player.CharacterAdded:Connect(function()
				if AS.enabled then
					task.wait(0.5)
					applySpeedAttr()
				end
			end)
		end

		addToggle(secAttackSpeed, "Velocidade de Ataque", function(state)
			if state then startAttackSpeed() else stopAttackSpeed() end
		end, false)
