			modal.BackgroundTransparency = 1
			modal.BorderSizePixel = 0
			modal.GroupTransparency = 1
			modal.Visible = false
			modal.Active = true
			modal.ZIndex = 200
			modal.Parent = screenGui
			Instance.new("UICorner", modal).CornerRadius = UDim.new(0, 10)
			u.modal = modal

			local modalStroke = Instance.new("UIStroke")
			modalStroke.Color = currentThemeColor
			modalStroke.Transparency = 0.3
			modalStroke.Thickness = 1.4
			modalStroke.Parent = modal
			table.insert(themeSections, modalStroke)

			local scale = Instance.new("UIScale")
			scale.Scale = u.baseScale
			scale.Parent = modal
			u.scale = scale

			local bg = Instance.new("Frame")
			bg.Size = UDim2.new(1, 0, 1, 0)
			bg.BackgroundColor3 = Color3.new(1, 1, 1)
			bg.BorderSizePixel = 0
			bg.Parent = modal
			Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 10)
			local bgGradient = Instance.new("UIGradient")
			bgGradient.Rotation = 90
			bgGradient.Color = ColorSequence.new(Color3.fromRGB(30, 30, 45), Color3.fromRGB(14, 14, 22))
			bgGradient.Parent = bg

			-- Cabecalho
			local titleLabel = Instance.new("TextLabel")
			titleLabel.Size = UDim2.new(1, -44, 0, 14)
			titleLabel.Position = UDim2.new(0, 12, 0, 8)
			titleLabel.BackgroundTransparency = 1
			titleLabel.Font = Enum.Font.GothamBold
			titleLabel.Text = title
			titleLabel.TextColor3 = currentThemeColor
			titleLabel.TextSize = 10
			titleLabel.TextXAlignment = Enum.TextXAlignment.Left
			titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
			titleLabel.Parent = modal
			table.insert(themeTexts, titleLabel)

			local closeX = Instance.new("TextButton")
			closeX.Name = "ColorPickerClose"
			closeX.Size = UDim2.fromOffset(28, 22)
			closeX.Position = UDim2.new(1, -34, 0, 3)
			closeX.ZIndex = 20
			closeX.Active = true
			closeX.AutoButtonColor = false
			closeX.BackgroundTransparency = 1
			closeX.Font = Enum.Font.GothamBold
			closeX.Text = "×"
			closeX.TextColor3 = Color3.fromRGB(160, 160, 180)
			closeX.TextSize = 16
			closeX.Parent = modal
			u.closeX = closeX
			closeX.MouseEnter:Connect(function() ColorPicker.tween(closeX, 0.12, {TextColor3 = Color3.fromRGB(255, 100, 110)}) end)
			closeX.MouseLeave:Connect(function() ColorPicker.tween(closeX, 0.12, {TextColor3 = Color3.fromRGB(160, 160, 180)}) end)
			closeX.MouseButton1Down:Connect(markControl)
			closeX.MouseButton1Click:Connect(function() picker.close() end)

			-- Linha de destaque com brilho deslizante
			local line = Instance.new("Frame")
			line.Size = UDim2.new(1, -24, 0, 2)
			line.Position = UDim2.new(0, 12, 0, 26)
			line.BackgroundColor3 = currentThemeColor
			line.BorderSizePixel = 0
			line.ClipsDescendants = true
			line.Parent = modal
			table.insert(themeSliders, line)
			local lineGradient = Instance.new("UIGradient")
			lineGradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0.15),
				NumberSequenceKeypoint.new(0.8, 0.15),
				NumberSequenceKeypoint.new(1, 1)
			})
			lineGradient.Parent = line
			local sweep = Instance.new("Frame")
			sweep.Size = UDim2.new(0.3, 0, 1, 0)
			sweep.Position = UDim2.new(-0.3, 0, 0, 0)
			sweep.BackgroundColor3 = Color3.new(1, 1, 1)
			sweep.BackgroundTransparency = 0.3
			sweep.BorderSizePixel = 0
			sweep.Parent = line
			local sweepGradient = Instance.new("UIGradient")
			sweepGradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 1)
			})
			sweepGradient.Parent = sweep
			u.sweep = sweep

			-- Quadro saturacao / brilho
			local canvas = Instance.new("Frame")
			canvas.Name = "SaturationValue"
			canvas.Size = UDim2.fromOffset(148, 104)
			canvas.Position = UDim2.fromOffset(12, 34)
			canvas.BackgroundColor3 = Color3.fromHSV(state.h, 1, 1)
			canvas.BorderSizePixel = 0
			canvas.Active = true
			canvas.Parent = modal
			Instance.new("UICorner", canvas).CornerRadius = UDim.new(0, 6)
			local canvasStroke = Instance.new("UIStroke")
			canvasStroke.Color = grayLine
			canvasStroke.Transparency = 0.3
			canvasStroke.Parent = canvas
			u.canvas = canvas

			local whiteLayer = Instance.new("Frame")
			whiteLayer.Size = UDim2.new(1, 0, 1, 0)
			whiteLayer.BackgroundColor3 = Color3.new(1, 1, 1)
			whiteLayer.BorderSizePixel = 0
			whiteLayer.ZIndex = 2
			whiteLayer.Parent = canvas
			Instance.new("UICorner", whiteLayer).CornerRadius = UDim.new(0, 6)
			local whiteGradient = Instance.new("UIGradient")
			whiteGradient.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
			whiteGradient.Parent = whiteLayer

			local blackLayer = Instance.new("Frame")
			blackLayer.Size = UDim2.new(1, 0, 1, 0)
			blackLayer.BackgroundColor3 = Color3.new(0, 0, 0)
			blackLayer.BorderSizePixel = 0
			blackLayer.ZIndex = 3
			blackLayer.Parent = canvas
			Instance.new("UICorner", blackLayer).CornerRadius = UDim.new(0, 6)
			local blackGradient = Instance.new("UIGradient")
			blackGradient.Rotation = 90
			blackGradient.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})
			blackGradient.Parent = blackLayer

			local cursorShadow = Instance.new("Frame")
			cursorShadow.Size = UDim2.fromOffset(20, 20)
			cursorShadow.AnchorPoint = Vector2.new(0.5, 0.5)
			cursorShadow.Position = UDim2.new(state.s, 0, 1 - state.v, 0)
			cursorShadow.BackgroundColor3 = Color3.new(0, 0, 0)
			cursorShadow.BackgroundTransparency = 0.65
			cursorShadow.BorderSizePixel = 0
			cursorShadow.ZIndex = 4
			cursorShadow.Parent = canvas
			Instance.new("UICorner", cursorShadow).CornerRadius = UDim.new(1, 0)
			local cursorFill = Instance.new("Frame")
			cursorFill.Size = UDim2.fromOffset(12, 12)
			cursorFill.AnchorPoint = Vector2.new(0.5, 0.5)
			cursorFill.Position = UDim2.new(0.5, 0, 0.5, 0)
			cursorFill.BackgroundColor3 = currentColor()
			cursorFill.BorderSizePixel = 0
			cursorFill.ZIndex = 5
			cursorFill.Parent = cursorShadow
			Instance.new("UICorner", cursorFill).CornerRadius = UDim.new(1, 0)
			local cursorStroke = Instance.new("UIStroke")
			cursorStroke.Color = Color3.new(1, 1, 1)
			cursorStroke.Thickness = 2
			cursorStroke.Parent = cursorFill
			u.cursorShadow, u.cursorFill = cursorShadow, cursorFill

			-- Barra de matiz
			local hueBar = Instance.new("Frame")
			hueBar.Name = "Hue"
			hueBar.Size = UDim2.fromOffset(16, 104)
			hueBar.Position = UDim2.fromOffset(168, 34)
			hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
			hueBar.BorderSizePixel = 0
			hueBar.Active = true
			hueBar.Parent = modal
			Instance.new("UICorner", hueBar).CornerRadius = UDim.new(0, 6)
			local hueStroke = Instance.new("UIStroke")
			hueStroke.Color = grayLine
			hueStroke.Transparency = 0.3
			hueStroke.Parent = hueBar
			local hueGradient = Instance.new("UIGradient")
			hueGradient.Rotation = 90
			hueGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
			})
			hueGradient.Parent = hueBar
			local hueThumb = Instance.new("Frame")
			hueThumb.Size = UDim2.fromOffset(22, 9)
			hueThumb.AnchorPoint = Vector2.new(0.5, 0.5)
			hueThumb.Position = UDim2.new(0.5, 0, state.h, 0)
			hueThumb.BackgroundColor3 = Color3.fromHSV(state.h, 1, 1)
			hueThumb.BorderSizePixel = 0
			hueThumb.ZIndex = 3
			hueThumb.Parent = hueBar
			Instance.new("UICorner", hueThumb).CornerRadius = UDim.new(0, 4)
			local thumbStroke = Instance.new("UIStroke")
			thumbStroke.Color = Color3.new(1, 1, 1)
			thumbStroke.Thickness = 2
			thumbStroke.Parent = hueThumb
			u.hueBar, u.hueThumb = hueBar, hueThumb

			-- Linha 2: pre-visualizacao | HEX | desfazer
			local preview = Instance.new("CanvasGroup")
			preview.Size = UDim2.fromOffset(34, 24)
			preview.Position = UDim2.fromOffset(12, 146)
			preview.BackgroundTransparency = 1
			preview.Parent = modal
			Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 6)
			local oldHalf = Instance.new("Frame")
			oldHalf.Size = UDim2.new(0.5, 0, 1, 0)
			oldHalf.BackgroundColor3 = state.original
			oldHalf.BorderSizePixel = 0
			oldHalf.Parent = preview
			local newHalf = Instance.new("Frame")
			newHalf.Size = UDim2.new(0.5, 0, 1, 0)
			newHalf.Position = UDim2.new(0.5, 0, 0, 0)
			newHalf.BackgroundColor3 = currentColor()
			newHalf.BorderSizePixel = 0
			newHalf.Parent = preview
			u.oldHalf, u.newHalf = oldHalf, newHalf

			local hexBox = Instance.new("TextBox")
			hexBox.Size = UDim2.fromOffset(132, 24)
			hexBox.Position = UDim2.fromOffset(52, 146)
			hexBox.BackgroundColor3 = Color3.fromRGB(26, 26, 38)
			hexBox.BorderSizePixel = 0
			hexBox.ClearTextOnFocus = false
			hexBox.Font = Enum.Font.GothamBold
			hexBox.PlaceholderText = "#RRGGBB"
			hexBox.PlaceholderColor3 = Color3.fromRGB(110, 110, 130)
			hexBox.Text = ColorPicker.toHex(currentColor())
			hexBox.TextColor3 = Color3.fromRGB(235, 235, 245)
			hexBox.TextSize = 10
			hexBox.Parent = modal
			Instance.new("UICorner", hexBox).CornerRadius = UDim.new(0, 6)
			local hexStroke = Instance.new("UIStroke")
			hexStroke.Color = grayLine
			hexStroke.Transparency = 0.4
			hexStroke.Parent = hexBox
			u.hexBox = hexBox
			hexBox.Focused:Connect(markControl)
			hexBox.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then markControl() end
			end)
			hexBox.Focused:Connect(function()
				ColorPicker.tween(hexStroke, 0.15, {Color = currentThemeColor, Transparency = 0.05})
			end)
			hexBox.FocusLost:Connect(function()
				ColorPicker.tween(hexStroke, 0.2, {Color = grayLine, Transparency = 0.4})
				local parsed = ColorPicker.parseHex(hexBox.Text)
				if parsed then
					picker.animateTo(parsed)
				else
					hexBox.Text = ColorPicker.toHex(currentColor())
					hexStroke.Color = Color3.fromRGB(255, 90, 90)
					hexStroke.Transparency = 0
					ColorPicker.tween(hexStroke, 0.5, {Color = grayLine, Transparency = 0.4})
				end
			end)



			return u
		end

		function picker.open()
			if state.open then return end
			if ColorPicker.active and ColorPicker.active ~= picker then ColorPicker.active.close() end
			ColorPicker.active = picker
			if not ui then ui = build() end
			state.open = true
			state.original = currentColor()
			ui.oldHalf.BackgroundColor3 = state.original
			applyVisuals()

			ui.modal.Visible = true
			ui.modal.GroupTransparency = 1
			ui.scale.Scale = ui.baseScale * 0.86
			reposition()
			ColorPicker.tween(ui.scale, 0.28, {Scale = ui.baseScale}, Enum.EasingStyle.Back)
			ColorPicker.tween(ui.modal, 0.18, {GroupTransparency = 0})

			btnStroke.Color = currentThemeColor
			pulseTween = TweenService:Create(btnStroke, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Transparency = 0.05, Thickness = 2})
			pulseTween:Play()
			ui.sweep.Position = UDim2.new(-0.3, 0, 0, 0)
			sweepTween = TweenService:Create(ui.sweep, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, 0.3), {Position = UDim2.new(1, 0, 0, 0)})
			sweepTween:Play()

			table.insert(conns, UserInputService.InputChanged:Connect(function(input)
				if dragMode and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromInput(input.Position)
				end
			end))
			table.insert(conns, UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					pressActive = false
					if dragMode then setDragging(nil) end
				end
			end))
			-- clicar fora fecha
			table.insert(conns, UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					pressActive = true
					local pos = input.Position
					task.spawn(function()
						RunService.Heartbeat:Wait() -- deixa os botões do picker marcarem o clique antes
						if not state.open then return end
						local mode, offset, inside = findInputTarget(pos)
						-- clique no X: fecha mesmo que o evento do botão não dispare
						if mode == "close" then picker.close() return end
						if os.clock() - controlStamp < 0.3 then return end
						if mode then
							inputOffset = offset
							setDragging(mode)
							updateFromInput(pos)
							if not pressActive then setDragging(nil) end
						elseif not inside then
							picker.close()
						end
					end)
				end
			end))
			-- acompanha o botao (painel arrastado / pagina rolando) e fecha se o hub sumir
			table.insert(conns, RunService.RenderStepped:Connect(function()
				if not screenGui.Parent or not colorBtn:IsDescendantOf(screenGui) or not mainPanel.Visible then
					picker.close()
					return
				end
				reposition()
			end))
		end

		function picker.close()
			if not state.open then return end
			state.open = false
			if ColorPicker.active == picker then ColorPicker.active = nil end
			for i = #conns, 1, -1 do
				local conn = conns[i]
				if conn then conn:Disconnect() end
				conns[i] = nil
			end
			if pulseTween then pulseTween:Cancel(); pulseTween = nil end
			if sweepTween then sweepTween:Cancel(); sweepTween = nil end
			ColorPicker.tween(btnStroke, 0.2, {Transparency = 0.75, Thickness = 1, Color = Color3.new(1, 1, 1)})
			if ui then
				dragMode = nil
				inputOffset = Vector2.new(0, 0)
				ColorPicker.tween(ui.scale, 0.15, {Scale = ui.baseScale * 0.9}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				ColorPicker.tween(ui.modal, 0.15, {GroupTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.17, function()
					if ui and not state.open then ui.modal.Visible = false end
				end)
			end
		end

		colorBtn.MouseEnter:Connect(function()
			if not state.open then ColorPicker.tween(btnStroke, 0.12, {Transparency = 0.2}) end
		end)
		colorBtn.MouseLeave:Connect(function()
			if not state.open then ColorPicker.tween(btnStroke, 0.15, {Transparency = 0.75}) end
		end)
		colorBtn.MouseButton1Click:Connect(function()
			if state.open then picker.close() else picker.open() end
		end)

		screenGui.Destroying:Connect(function()
			for _, conn in ipairs(conns) do conn:Disconnect() end
		end)

		return picker
