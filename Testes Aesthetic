-- Estilo único dos botões de ação (grandes e pequenos): cinza bem escuro (não preto), borda fina, cantos 6, hover suave.
AetherisBtnStyle = function(b, small)
	task.defer(function()
		if not b or not b.Parent then return end
		local BG, BG_HOVER, EDGE, EDGE_HOVER = Color3.fromRGB(26, 27, 34), Color3.fromRGB(36, 37, 48), Color3.fromRGB(52, 54, 70), Color3.fromRGB(96, 102, 140)
		b.BackgroundColor3 = BG
		b.BackgroundTransparency = 0
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.Font = Enum.Font.GothamMedium
		b.TextColor3 = Color3.fromRGB(204, 208, 224)
		local c = b:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = b
		local st = b:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
		st.Color = EDGE
		st.Transparency = 0
		st.Thickness = 1
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = b
		b.MouseEnter:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = BG_HOVER}):Play()
			TweenService:Create(st, TweenInfo.new(0.12), {Color = EDGE_HOVER}):Play()
		end)
		b.MouseLeave:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = BG}):Play()
			TweenService:Create(st, TweenInfo.new(0.12), {Color = EDGE}):Play()
		end)
		b.MouseButton1Down:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.06), {BackgroundColor3 = Color3.fromRGB(20, 21, 27)}):Play()
		end)
		b.MouseButton1Up:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = BG_HOVER}):Play()
		end)
	end)
end

