-- O painel de estoque agora fica fixo no topo da aba Fruta, sem seção em volta, sem botão de fechar
-- e sem poder arrastar (o botão do header foi removido).
task.spawn(function()
    local hub = PG:WaitForChild("AetherisHub", 30)
    if not hub then warn("[FV] hub não encontrado"); return end
    while hub:FindFirstChild("LoadingCard") do task.wait(0.1) end
    local page
    for _, descendant in ipairs(hub:GetDescendants()) do
        if descendant:IsA("ScrollingFrame") and descendant:GetAttribute("AetherisPage") == "Fruta" then page = descendant break end
    end
    if not page then warn("[FV] aba Fruta não encontrada"); return end
    local holder = Instance.new("Frame")
    holder.Name = "FruitStockHolder"
    holder.Size = UDim2.new(1, -4, 0, PH)
    holder.BackgroundTransparency = 1
    holder.LayoutOrder = -1000
    holder.Parent = page
    closeB.Visible = false
    dragH.Visible = false
    dragging = false
    panel.AnchorPoint = Vector2.new(0, 0)
    panel.Position = UDim2.new(0, 0, 0, 0)
    panel.Size = UDim2.new(1, 0, 1, 0)
    panel.Parent = holder
    panel.Visible = true
    hub.Destroying:Connect(function() sg:Destroy() end)
end)
