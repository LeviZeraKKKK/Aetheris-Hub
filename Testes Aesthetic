	-- VERIFICA SE A FRUTA ESTÁ COM ALGUÉM (NA MÃO, BACKPACK OU INVENTÁRIO DE JOGADORES)
	local function isHeldByPlayer(tool)
		local parent = tool.Parent
		if not parent or parent == workspace then return false end
		
		-- Se o parent for o personagem de algum player
		if Players:GetPlayerFromCharacter(parent) then return true end
		
		-- Se estiver no inventário (Backpack) de um jogador
		if parent.Name == "Backpack" and parent.Parent and parent.Parent:IsA("Player") then
			return true
		end
		
		-- Checa ascendentes (caso esteja em algum container interno de player)
		local ancestor = parent
		while ancestor and ancestor ~= workspace do
			if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
				return true
			end
			ancestor = ancestor.Parent
		end
		return false
	end

	local function isFruit(obj)
		return obj:IsA("Tool") and string.find(obj.Name:lower(), "fruit", 1, true) ~= nil
	end

	local function removeFruitESP(tool)
		local data = fruitEspObjects[tool]
		if not data then return end
		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
		if data.ancestryConn then data.ancestryConn:Disconnect() end
		fruitEspObjects[tool] = nil
		
		for i = #fruitList, 1, -1 do
			if fruitList[i] == tool then
				table.remove(fruitList, i)
				break
			end
		end
		for i = #fruitCache, 1, -1 do
			if fruitCache[i] == tool then
				table.remove(fruitCache, i)
				break
			end
		end
	end

	local function setFruitHeldState(data, held)
		local state = held and "held" or "normal"
		if data.lastState == state then return end
		data.lastState = state
		data.isHeld = held

		if held then
			data.highlight.FillColor    = fruitConfig.HeldColor
			data.highlight.OutlineColor = Color3.new(1, 0.3, 0.3)
			data.label.TextColor3       = fruitConfig.HeldColor
			data.label.TextStrokeColor3 = Color3.new(0.3, 0, 0)
		else
			data.highlight.FillColor    = _G_ColorFruitChams
			data.highlight.OutlineColor = Color3.new(1, 1, 1)
			data.label.TextColor3       = _G_ColorFruitName
			data.label.TextStrokeColor3 = Color3.new(0, 0, 0)
		end
	end

