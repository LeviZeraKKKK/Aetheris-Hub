local currentThemeColor = Color3.fromRGB(138, 43, 226)
local panelTransparencyValue = 0.2

-- Tabelas para rastrear elementos dinâmicos e atualizá-los em tempo real
local themeToggles = {}
local themeSections = {}
local themeTexts = {}
local tabIndicators = {}

local function updateGlobalTheme(newColor)
	currentThemeColor = newColor
	
	-- Atualiza todos os toggles ativos instantaneamente
	for _, data in pairs(themeToggles) do
		if data.isToggled and data.circle and data.button and data.led then
			TweenService:Create(data.circle, TweenInfo.new(0.18), {Position = UDim2.new(1, -14, 0.5, -6)}):Play()
			TweenService:Create(data.button, TweenInfo.new(0.18), {BackgroundColor3 = newColor}):Play()
			TweenService:Create(data.led, TweenInfo.new(0.18), {BackgroundColor3 = newColor}):Play()
		end
	end

	-- Atualiza as bordas das seções
	for _, secStroke in pairs(themeSections) do
		secStroke.Color = newColor
	end

	-- Atualiza os textos e ícones temáticos
	for _, obj in pairs(themeTexts) do
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			obj.TextColor3 = newColor
		elseif obj:IsA("UIStroke") then
			obj.Color = newColor
		end
	end

	-- Atualiza os indicadores das abas ativas
	for _, ind in pairs(tabIndicators) do
		ind.BackgroundColor3 = newColor
	end
end

