				empty.Size = UDim2.new(1, -6, 0, ROW - 2)
				empty.BackgroundTransparency = 1
				empty.Font = currentGlobalFont
				empty.Text = total == 0 and "Nenhuma opção encontrada." or "Nada encontrado."
				empty.TextColor3 = Color3.fromRGB(150, 150, 170)
				empty.TextSize = 10
				empty.ZIndex = 62
				empty.Parent = list
			end
			list.CanvasSize = UDim2.new(0, 0, 0, math.max(shownCount, 1) * ROW)
			local noun = total == 1 and "opção" or "opções"
			if query == "" then
				countLabel.Text = total .. " " .. noun
			else
				countLabel.Text = shownCount .. " de " .. total .. " " .. noun
			end
		end
		pop.populate = populate
		populate()
		search:GetPropertyChangedSignal("Text"):Connect(populate)

		TweenService:Create(gui, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(popW, popH)}):Play()

		-- se a caixa sair do lugar (rolagem) ou da tela (aba trocada, painel minimizado), fecha
		pop.startPos = boxPos
		pop.watch = RunService.Heartbeat:Connect(function()
			if not box.Parent or not isShown(box) or (box.AbsolutePosition - pop.startPos).Magnitude > 3 then
				close()
			end
		end)
		state.popup = pop
	end

	local function closePopup()
		local pop = state.popup
		state.popup = nil
		if not pop then return end
		if pop.watch then pop.watch:Disconnect() end
		if pop.backdrop then pop.backdrop:Destroy() end
		if pop.gui then pop.gui:Destroy() end
	end

	local function setOpen(open)
		if state.open == open then return end
		state.open = open
		TweenService:Create(arrow, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {Rotation = open and 180 or 0}):Play()
		TweenService:Create(frameStroke, TweenInfo.new(0.2), {
			Color = open and currentThemeColor or GRAYSTROKE, Transparency = open and 0.2 or 0.55
		}):Play()
		if open then openPopup() else closePopup() end
	end
	close = function() if state.open then setOpen(false) end end

	header.MouseEnter:Connect(function()
		TweenService:Create(box, TweenInfo.new(0.12), {BackgroundTransparency = split and 0.25 or 0.15}):Play()
	end)
	header.MouseLeave:Connect(function()
		TweenService:Create(box, TweenInfo.new(0.15), {BackgroundTransparency = split and 0 or 0.35}):Play()
	end)
	header.MouseButton1Click:Connect(function() setOpen(not state.open) end)
	frame.Destroying:Connect(closePopup)
	table.insert(AetherisThemeHooks, function(color)
		if not frame.Parent then return end
		local pop = state.popup
		if pop then
			pop.stroke.Color = color
			pop.list.ScrollBarImageColor3 = color
			pop.populate()
		end
	end)

	return {
		frame = frame,
		close = close,
			setValue = function(value, text, icon)
				state.value = value
				state.label = text
				applyHeaderIcon(icon)
				setLabelText()
		end,
	}
end

local configBindings = {}
local configBindingCounts = {}
local function registerConfigBinding(parent, name, getter, setter)
    local section = parent and parent.Parent or nil
    local sectionTitle = "Geral"
    local keySection = parent and parent.GetAttribute and parent:GetAttribute("AetherisKeySection") or nil
    if section and not keySection then
        for _, child in ipairs(section:GetChildren()) do
            if child:IsA("TextLabel") then
                sectionTitle = (AetherisI18n and AetherisI18n.orig[child]) or child.Text
                break
            end
        end
    end
	local page = section and section.Parent or nil
	local pageName = page and page.Name or "Page"
	-- Seções movidas para as abas Automático e Mundo: mantenha as chaves antigas dos presets.
	if pageName == "Auto" then
		pageName = "Player"
	elseif pageName == "Mundo" or pageName == "Misc" then
		pageName = (sectionTitle == "Viajar para Ilhas") and "Player" or "Visual"
	end
	if keySection then
		pageName = "Visual"
		sectionTitle = keySection
	end
	-- O título visível mudou para Baú; mantenha as chaves antigas dos presets.
	if pageName == "Farming" and sectionTitle == "Baú" then
		sectionTitle = "Automação"
	end
	-- A seção "Design" juntou "Tema do Hub" e "Customização de Textos": mantenha as chaves antigas dos presets.
	if pageName == "Config" and sectionTitle == "Design" then
		sectionTitle = (name == "Fonte do Hub") and "Customização de Textos" or "Tema do Hub"
	end
	local baseKey = pageName .. "|" .. sectionTitle .. "|" .. name
    configBindingCounts[baseKey] = (configBindingCounts[baseKey] or 0) + 1
    local key = baseKey
    if configBindingCounts[baseKey] > 1 then
        key = baseKey .. " #" .. tostring(configBindingCounts[baseKey])
    end
    table.insert(configBindings, {key = key, getter = getter, setter = setter})
    return key
end

local function updateGlobalTheme(newColor)
	currentThemeColor = newColor
	
	for _, data in pairs(themeToggles) do
		if data.isToggled and data.circle and data.button and data.led then
			TweenService:Create(data.circle, TweenInfo.new(0.18), {Position = UDim2.new(1, -14, 0.5, -6)}):Play()
			TweenService:Create(data.button, TweenInfo.new(0.18), {BackgroundColor3 = newColor}):Play()
			TweenService:Create(data.led, TweenInfo.new(0.18), {BackgroundColor3 = accentBlue}):Play()
		end
	end

	for _, secStroke in pairs(themeSections) do
		secStroke.Color = newColor
	end

	for _, themedText in pairs(themeTexts) do
		if themedText and themedText.Parent then
			themedText.TextColor3 = newColor
		end
	end

	for _, themedImage in pairs(themeImages) do
		if themedImage and themedImage.Parent then
			themedImage.ImageColor3 = newColor
		end
	end

	for _, fill in pairs(themeSliders) do
		fill.BackgroundColor3 = newColor
	end

	for _, line in pairs(resizeSymbolsLines) do
		line.BackgroundColor3 = newColor
	end

	for _, subLabel in pairs(headerSubtitles) do
		subLabel.TextColor3 = newColor
	end

	for _, ind in pairs(tabIndicators) do
		ind.BackgroundColor3 = newColor
	end

	for _, part in pairs(themeParticles) do
		if part and part.Parent then
			part.BackgroundColor3 = newColor
		end
	end

	for _, hook in pairs(AetherisThemeHooks) do
		pcall(hook, newColor)
	end
end

