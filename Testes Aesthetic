						BackgroundColor3 = Color3.fromRGB(56, 132, 255), BackgroundTransparency = 0.8, BorderSizePixel = 0, AutoButtonColor = false,
						Font = currentGlobalFont, Text = "🔔 Avisar: não", TextColor3 = WHITET, TextSize = 8,
					}, evBlock)
					round(annBtn, 4)
					annBtn.MouseButton1Click:Connect(function()
						announce = not announce
