				local y = math.clamp((input.Position.Y - canvas.AbsolutePosition.Y) / canvas.AbsoluteSize.Y, 0, 1)
				cursor.Position = UDim2.new(x, 0, y, 0)
				currentS = x
				currentV = 1 - y
				updateColor()
			end
		end)

		updateColor()
		return colorBtn
	end

