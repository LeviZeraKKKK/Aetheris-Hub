				tx.TextTransparency = 1
				tx.Text = text
				tx.ZIndex = 302
				tx.Parent = t

				-- contador bem pequeno (segundos restantes), fora do tradutor
				local timerLbl = Instance.new("TextLabel")
				timerLbl.Name = "ToastTimer"
				timerLbl.LayoutOrder = 2
				timerLbl.Size = UDim2.new(0, 0, 1, 0)
				timerLbl.AutomaticSize = Enum.AutomaticSize.X
				timerLbl.BackgroundTransparency = 1
				timerLbl.Font = Enum.Font.GothamMedium
				timerLbl.TextSize = 8
				timerLbl.TextColor3 = Color3.fromRGB(120, 120, 120)
				timerLbl.TextTransparency = 1
				timerLbl.Text = math.ceil(duration) .. "s"
				timerLbl.ZIndex = 302
				timerLbl.Parent = t
				if AetherisI18n and AetherisI18n.hooked then AetherisI18n.hooked[timerLbl] = true end

				TweenService:Create(t, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
				TweenService:Create(tx, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
				TweenService:Create(timerLbl, TweenInfo.new(0.2), {TextTransparency = 0}):Play()

				local startedAt = os.clock()
				task.spawn(function()
					while t.Parent do
						local left = duration - (os.clock() - startedAt)
						if left <= 0 then break end
						timerLbl.Text = math.ceil(left) .. "s"
						task.wait(0.25)
					end
