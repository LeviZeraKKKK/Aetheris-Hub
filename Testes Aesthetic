						annBtn.BackgroundTransparency = announce and 0.5 or 0.8
					end)
					local grid = mk("Frame", {Position = UDim2.new(0, 5, 0, 17), Size = UDim2.new(1, -10, 1, -20), BackgroundTransparency = 1, BorderSizePixel = 0}, evBlock)
					mk("UIGridLayout", {CellSize = UDim2.new(0.25, -3, 0.5, -2), CellPadding = UDim2.new(0, 3, 0, 3), SortOrder = Enum.SortOrder.LayoutOrder}, grid)
