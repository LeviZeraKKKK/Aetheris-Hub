		local sessionStart = os.clock()
		local function fmtSession(t)
			t = math.floor(t)
			if t >= 3600 then return string.format("%dh %02dm", t // 3600, (t % 3600) // 60) end
			if t >= 60 then return string.format("%dm %02ds", t // 60, t % 60) end
			return t .. "s"
		end
		local function fpsColor(v) return v >= 50 and GOOD or (v >= 30 and WARN or BAD) end

		local fpsFrames, fpsElapsed = 0, 0
		local infoPerfConnection = RunService.RenderStepped:Connect(function(dt)
			fpsFrames += 1
			fpsElapsed += dt
			if fpsElapsed >= 1 then
				local fps = math.floor(fpsFrames / fpsElapsed + 0.5)
				fpsFrames, fpsElapsed = 0, 0
				fpsLabel.Text = tostring(fps)
				fpsLabel.TextColor3 = fpsColor(fps)

				table.remove(fpsHistory, 1)
				table.insert(fpsHistory, fps)
				for i = 1, BARS do
					local v = fpsHistory[i]
					local bar = bars[i]
					bar.Size = UDim2.new(1 / BARS, -2, math.clamp(v / 60, 0.1, 1), 0)
					if i == BARS then
						bar.BackgroundColor3 = fpsColor(v)
					elseif v > 0 and v < 30 then
						bar.BackgroundColor3 = Color3.fromRGB(150, 70, 80)
					else
						bar.BackgroundColor3 = BAR_IDLE
					end
				end

				local count = #Players:GetPlayers()
				playerCount.Text = tostring(count) .. " / " .. tostring(Players.MaxPlayers)
				gameSub.Text = (creatorName ~= "" and ("por " .. creatorName .. "  •  ") or "") .. tostring(count) .. "/" .. tostring(Players.MaxPlayers) .. " jogadores"
				sessionLabel.Text = fmtSession(os.clock() - sessionStart)

				local pingValue
				pcall(function()
					local item = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]
					pingValue = item and item:GetValue()
				end)
				if pingValue then
