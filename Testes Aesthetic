					p.Visible = false
				end
			end

			page.Visible = true
			page.Position = UDim2.new(1, 0, 0, 4)
			TweenService:Create(page, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 4, 0, 4)}):Play()

			for _, ind in pairs(tabIndicators) do
				TweenService:Create(ind, TweenInfo.new(0.15), {Size = UDim2.new(0, 2, 0, 0)}):Play()
			end

			TweenService:Create(indicator, TweenInfo.new(0.15), {Size = UDim2.new(0, 2, 0, 16)}):Play()

			activePage = page
		end)

		if i == 1 then
			page.Visible = true
