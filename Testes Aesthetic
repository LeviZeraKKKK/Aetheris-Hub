local mainLoopState = {
	staleCleaned = false,
	jumpApplied = false,
	savedUseJump = true,
	savedJump = 50,
	noclipParts = setmetatable({}, {__mode = "k"}),
}

RunService.RenderStepped:Connect(function()
	-- Se o hub foi recarregado, esta execução antiga fica inerte. Antes ela continuava
	-- rodando e brigava com a nova (forçava JumpPower 50, CanCollide true e apagava os chams).
	if not screenGui.Parent then
		if not mainLoopState.staleCleaned then
			mainLoopState.staleCleaned = true
			for _, cache in pairs(espDrawings) do
				if type(cache) == "table" then
					for _, drawingObj in pairs(cache) do
						pcall(function() drawingObj:Remove() end)
					end
				end
			end
			table.clear(espDrawings)
			levelEsp.clearAll()
			if fovCircleDrawing then pcall(function() fovCircleDrawing:Remove() end) end
		end
		return
	end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		if _G_WalkSpeedEnabled then hum.WalkSpeed = _G_WalkSpeedValue end

		-- JumpPower: só mexe enquanto ligado; ao desligar, devolve o valor que o jogo tinha.
		if _G_JumpPowerEnabled then
			if not mainLoopState.jumpApplied then
				mainLoopState.jumpApplied = true
				mainLoopState.savedUseJump = hum.UseJumpPower
				mainLoopState.savedJump = hum.JumpPower
			end
			hum.UseJumpPower = true
			hum.JumpPower = _G_JumpPowerValue
		elseif mainLoopState.jumpApplied then
			mainLoopState.jumpApplied = false
			hum.UseJumpPower = mainLoopState.savedUseJump
			hum.JumpPower = mainLoopState.savedJump
		end
	end

	-- Noclip: só mexe enquanto ligado; guarda o CanCollide original de cada parte e devolve ao desligar.
	if char then
		if _G_NoclipEnabled then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if mainLoopState.noclipParts[part] == nil then
						mainLoopState.noclipParts[part] = part.CanCollide
					end
					part.CanCollide = false
				end
			end
		elseif next(mainLoopState.noclipParts) ~= nil then
			for part, originalValue in pairs(mainLoopState.noclipParts) do
				if part.Parent then part.CanCollide = originalValue end
			end
			table.clear(mainLoopState.noclipParts)
		end
