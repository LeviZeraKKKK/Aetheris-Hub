	local function disableTravelNoclip()
		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end
		for part, originalValue in pairs(originalCollision) do
			if part and part.Parent then
				part.CanCollide = originalValue
			end
		end
		table.clear(originalCollision)
	end

	local function enableTravelNoclip(character)
		disableTravelNoclip()
		local function processPart(part)
			if not part:IsA("BasePart") then return end
			if originalCollision[part] == nil then
				originalCollision[part] = part.CanCollide
			end
			part.CanCollide = false
		end
		for _, part in ipairs(character:GetDescendants()) do processPart(part) end
		noclipConnection = RunService.Stepped:Connect(function()
			if not travelling or not character.Parent then return end
			for _, part in ipairs(character:GetDescendants()) do processPart(part) end
		end)
	end

	local function stopTravel()
		travelling = false
		if moveConnection then moveConnection:Disconnect(); moveConnection = nil end
		if activeVelocity then activeVelocity:Destroy(); activeVelocity = nil end
		if activeGyro then activeGyro:Destroy(); activeGyro = nil end
		disableTravelNoclip()
	end

	local function startTravel()
		if not selectedIsland or not selectedIsland.Parent then
			refreshIslands()
		end
		if not selectedIsland then return end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root then return end

		travelling = true
		enableTravelNoclip(character)

		activeVelocity = Instance.new("BodyVelocity")
		activeVelocity.Name = "TravelVelocity"
		activeVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		activeVelocity.P = 15000
		activeVelocity.Velocity = Vector3.zero
		activeVelocity.Parent = root

		activeGyro = Instance.new("BodyGyro")
		activeGyro.Name = "TravelGyro"
		activeGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
		activeGyro.P = 10000
		activeGyro.CFrame = root.CFrame
		activeGyro.Parent = root

		moveConnection = RunService.Heartbeat:Connect(function()
			if not travelling then return end
			if not character.Parent or not root.Parent or not selectedIsland.Parent then
				stopTravel()
				return
			end

			local destination = selectedIsland:GetPivot().Position + Vector3.new(0, travelHeight, 0)
			local difference = destination - root.Position
			local distance = difference.Magnitude

			if distance <= travelArrivalDist then
				stopTravel()
				return
			end

			activeVelocity.Velocity = difference.Unit * travelSpeed
			local horizontal = Vector3.new(difference.X, 0, difference.Z)
			if horizontal.Magnitude > 0.1 then
				activeGyro.CFrame = CFrame.lookAt(root.Position, root.Position + horizontal)
			end
		end)
	end

