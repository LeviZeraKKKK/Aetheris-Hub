													G.lastTry[t] = tick() + 30
													if tick() - (G.warned.full or 0) > 60 then
														G.warned.full = tick()
														AetherisNotify("Inventário de frutas cheio (" .. info.count .. "/" .. info.cap .. ")", Color3.fromRGB(255, 160, 120), 3)
													end
												else
													pcall(function() comm:InvokeServer("StoreFruit", name, t) end)
