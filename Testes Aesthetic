							end
							task.wait(0.1)
						end
					end)
				end, false)
				addToggle(sec, "Kitsune: coletar chamas e interagir", function(s) run(EV.kitsune, s) end, false)
				addToggle(sec, "Pré-histórica: coletar ovos e ossos", function(s) run(EV.prehist, s) end, false)
				addToggle(sec, "Interagir com qualquer objeto da ilha", function(s)
					for _, e in pairs(EV) do e.any = s end
				end, false)
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 26)
				row.BackgroundTransparency = 1
				row.Parent = sec
				local btn = Instance.new("TextButton")
				AetherisBtnStyle(btn)
				btn.Size = UDim2.new(1, 0, 1, 0)
				btn.BackgroundColor3 = Color3.fromRGB(32, 34, 52)
				btn.Font = currentGlobalFont
				btn.Text = "Copiar objetos da ilha"
				btn.TextColor3 = currentTextColor
				btn.TextSize = 10
				btn.Parent = row
				local bc = Instance.new("UICorner")
				bc.CornerRadius = UDim.new(0, 5)
				bc.Parent = btn
				table.insert(allTextLabels, btn)
				btn.MouseButton1Click:Connect(function()
					local lines = {}
					for _, ev in pairs(EV) do
						local isl = island(ev)
						if isl then
							table.insert(lines, "== " .. ev.island)
							for _, d in ipairs(isl:GetDescendants()) do
								if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("TouchTransmitter") then
									table.insert(lines, d.ClassName .. " | " .. d:GetFullName())
								end
							end
						end
					end
					if #lines == 0 then note("Nenhuma ilha de evento no servidor agora.", Color3.fromRGB(255, 200, 120)) return end
					local txt = table.concat(lines, "\n")
					local fn = setclipboard or toclipboard
					if fn then pcall(fn, txt); note("Lista copiada (" .. #lines .. " linhas). Cole aqui no chat.", Color3.fromRGB(150, 255, 170))
					else note("Sem clipboard no executor.", Color3.fromRGB(255, 120, 120)) end
				end)
				screenGui.Destroying:Connect(function()
					for _, e in pairs(EV) do e.token = e.token + 1 end
					moonTok = moonTok + 1
				end)
			end

