local function getBeli()
    local ok, value = pcall(function()
        return beliVal and tonumber(beliVal.Value) or 0
    end)
    return ok and math.max(0, math.floor(value or 0)) or 0
end

local function formatBeli(value)
    local number = math.max(0, math.floor(tonumber(value) or 0))
    local reversed = tostring(number):reverse():gsub("(%d%d%d)", "%1,")
    return reversed:reverse():gsub("^,", "")
end

local function getFruitPrice(fruit)
    if type(fruit) ~= "table" or type(fruit.Name) ~= "string" then return nil end
    local price = tonumber(fruit.Price)
    if not price and type(FruitData) == "table" then
        local fruitInfo = FruitData[fruit.Name]
        if type(fruitInfo) == "table" then price = tonumber(fruitInfo.Price) end
    end
    return price and math.max(0, price) or nil
end

