	local function isLetter(b) return b ~= nil and ((b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b >= 128) end
	local function replaceAll(s, a, b)
		local out, pos = {}, 1
		local firstLetter, lastLetter = isLetter(string.byte(a, 1)), isLetter(string.byte(a, #a))
		while true do
			local i, j = string.find(s, a, pos, true)
			if not i then break end
			local okL = not (firstLetter and i > 1 and isLetter(string.byte(s, i - 1)))
			local okR = not (lastLetter and j < #s and isLetter(string.byte(s, j + 1)))
			if okL and okR then out[#out + 1] = string.sub(s, pos, i - 1) .. b else out[#out + 1] = string.sub(s, pos, j) end
			pos = j + 1
		end
		out[#out + 1] = string.sub(s, pos)
		return table.concat(out)
	end

	local function tr(s)
		if s == "" or not string.find(s, "%a") then return s end
		local cached = I.memo[s]
		if cached then return cached end
		local result = s
		for _, p in ipairs(I.pairs) do
			if string.find(result, p[1], 1, true) then result = replaceAll(result, p[1], p[2]) end
		end
		if I.memoCount > 4000 then I.memo, I.memoCount = {}, 0 end
		I.memo[s] = result
		I.memoCount = I.memoCount + 1
		return result
	end
	-- texto para busca/comparação: já no idioma atual
	function I.translate(s) return I.lang == "en" and tr(s) or s end

	local function refresh(obj)
		if obj:IsA("TextBox") then
			local o = I.origPh[obj]
			if o == nil then return end
			local want = I.lang == "en" and tr(o) or o
			if obj.PlaceholderText ~= want then I.shownPh[obj] = want; obj.PlaceholderText = want end
		else
			local o = I.orig[obj]
			if o == nil then return end
			local want = I.lang == "en" and tr(o) or o
			if obj.Text ~= want then I.shown[obj] = want; obj.Text = want end
		end
	end

	function I.hook(obj)
		if I.hooked[obj] then return end
		if obj:IsA("TextBox") then
			I.hooked[obj] = true
			I.origPh[obj] = obj.PlaceholderText
			obj:GetPropertyChangedSignal("PlaceholderText"):Connect(function()
				if obj.PlaceholderText == I.shownPh[obj] then return end
				I.origPh[obj] = obj.PlaceholderText
				refresh(obj)
			end)
			refresh(obj)
		elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
			I.hooked[obj] = true
			I.orig[obj] = obj.Text
			obj:GetPropertyChangedSignal("Text"):Connect(function()
				if obj.Text == I.shown[obj] then return end
				I.orig[obj] = obj.Text
				refresh(obj)
			end)
			refresh(obj)
		end
	end

	function I.set(lang)
		if lang ~= "en" and lang ~= "pt" then return end
		I.lang = lang
		for obj in pairs(I.hooked) do
			if obj.Parent then refresh(obj) end
		end
	end

	-- observa uma ScreenGui inteira (o painel de estoque de frutas tem a sua própria)
	function I.watch(gui)
		for _, d in ipairs(gui:GetDescendants()) do I.hook(d) end
		gui.DescendantAdded:Connect(function(d) task.defer(I.hook, d) end)
	end
	I.watch(screenGui)
end

