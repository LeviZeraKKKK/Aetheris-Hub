-- GERENCIADOR DE CONFIGURAÇÕES (CONFIG SAVING SYSTEM)
-----------------------------------------------------------------
local configFileName = "AetherisHub_Config.json"

local function saveConfig()
	local configData = {
		ThemeColorR = currentThemeColor.R,
		ThemeColorG = currentThemeColor.G,
		ThemeColorB = currentThemeColor.B,
		PanelTransparency = panelTransparencyValue,
		HideKeybind = tostring(hideKeybindKey)
	}
	pcall(function()
		if writefile then
			writefile(configFileName, HttpService:JSONEncode(configData))
		end
	end)
end

local function loadConfig()
	pcall(function()
		if readfile and isfile and isfile(configFileName) then
			local content = readfile(configFileName)
			local data = HttpService:JSONDecode(content)
			if data then
				if data.ThemeColorR then
					currentThemeColor = Color3.new(data.ThemeColorR, data.ThemeColorG, data.ThemeColorB)
				end
				if data.PanelTransparency then
					panelTransparencyValue = data.PanelTransparency
				end
			end
		end
	end)
end
loadConfig()

