	local function ensureGachaRemote()
		if gachaRemoteFunction then return true end
		local loaded, remoteOrError = pcall(function()
			local modules = ReplicatedStorage:WaitForChild("Modules", 10)
			if not modules then error("Modules não encontrado") end
			local netModule = modules:WaitForChild("Net", 10)
			if not netModule or not netModule:IsA("ModuleScript") then error("Módulo Net não encontrado") end
			local net = require(netModule)
			if type(net) ~= "table" or type(net.RemoteFunction) ~= "function" then error("API Net incompatível") end
			local remote = net:RemoteFunction("GachaNetworkRF")
			if not remote then error("GachaNetworkRF indisponível") end
			return remote
		end)
		if not loaded or not remoteOrError then
			return false, tostring(remoteOrError)
		end
		gachaRemoteFunction = remoteOrError
		return true
	end

	local function performFruitRoll()
		if fruitRollState.Spinning then return false, "Uma roletagem já está em andamento" end
		fruitRollState.Spinning = true
		setFruitRollStatus("Status: tentando roletar...", Color3.fromRGB(230, 190, 100))
		local succeeded = false
		local resultMessage = "Falha na roletagem"

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			resultMessage = "Personagem indisponível ou morto"
		else
			local remoteReady, remoteError = ensureGachaRemote()
			if not remoteReady then
				resultMessage = "Remote indisponível: " .. tostring(remoteError)
			else
				local invoked, response, errorInfo = pcall(function()
					return gachaRemoteFunction:InvokeServer({
						Context = "Purchase",
						BoxName = fruitRollBoxName,
					})
				end)
				if not invoked then
					resultMessage = tostring(response)
				elseif response then
					resultMessage = "Roletagem concluída"
					succeeded = true
				else
					local message = (type(errorInfo) == "table" and errorInfo.ErrorMessage)
						or (type(response) == "table" and response.ErrorMessage)
						or errorInfo or "Compra recusada"
					resultMessage = tostring(message)
				end
			end
		end

		fruitRollState.Spinning = false
		fruitRollState.LastResult = resultMessage
		local statusPrefix = succeeded and "Sucesso: " or "Falha: "
		local statusColor = succeeded and Color3.fromRGB(105, 220, 145) or Color3.fromRGB(255, 125, 125)
		setFruitRollStatus(statusPrefix .. tostring(resultMessage), statusColor)
		return succeeded, resultMessage
	end

	local function setAutoFruitRoll(state)
		fruitRollState.Auto = state
		autoRollGeneration += 1
		local thisGeneration = autoRollGeneration
		if state then
