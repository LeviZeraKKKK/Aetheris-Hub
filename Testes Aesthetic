					"fudd10_v2", "LIGHTNINGABUSE",
				}
				-- Códigos que devolvem os pontos de status (resetam seus stats) — só entram se você ativar a opção
				local RESET = {"KITT_RESET", "SUB2GAMERROBOT_RESET1", "Sub2UncleKizaru"}
				local C = {busy = false, reset = false, showed = false}
				local row = Instance.new("Frame")
