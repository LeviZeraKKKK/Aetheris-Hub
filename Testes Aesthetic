				addToggle(sec, "Restaurar velocidade e pulo congelados", function(state) A.restoreSpeed = state end, true)
				screenGui.Destroying:Connect(function() if A.conn then A.conn:Disconnect() end; A.on = false; pcall(hookCanAttack, false) end)
			end

