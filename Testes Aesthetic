					local vPlayer = kvBlock(r1, 1 / 3, 1 / 3, "Jogador", {"Nível", "Beli", "Fragmentos", "Raça", "Bounty/Honra"})
					local vSess = kvBlock(r1, 2 / 3, 1 / 3, "Sessão", {"Tempo de uso", "Auto Farm Level", "Auto Kill Boss", "Tarefa extra"})

					-- Linha 2: Eventos (chips em grade, com Ir)
