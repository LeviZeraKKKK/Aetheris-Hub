			-- Procura na ilha do evento (Workspace.Map.<Ilha>) os objetos certos (por nome), vai até eles e interage
			-- (ProximityPrompt / ClickDetector / toque). Os nomes são palpites: use "Copiar objetos da ilha" para me mandar a lista real.
			do
				local sec = createSection(pages["Misc"], "Auto Eventos", sectionIcons.Physical)
				local EV = {
					mirage = {island = "MysticIsland", label = "Ilha Mirage", words = {"gear", "blue", "chest", "fragment"}, token = 0, any = false},
					kitsune = {island = "KitsuneIsland", label = "Ilha Kitsune", words = {"ember", "flame", "azure", "shrine", "kitsune"}, token = 0, any = false},
					prehist = {island = "PrehistoricIsland", label = "Ilha Pré-histórica", words = {"egg", "bone", "fossil", "dino", "dragon"}, token = 0, any = false},
				}
				local hasMoon = true
				local function island(ev)
					local map = workspace:FindFirstChild("Map")
					return map and map:FindFirstChild(ev.island)
				end
				local function hrpNow()
					return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				end
				local function nameMatch(ev, inst)
					if ev.any then return true end
					local n = string.lower(inst.Name)
					local p = inst.Parent and string.lower(inst.Parent.Name) or ""
					for _, w in ipairs(ev.words) do
						if string.find(n, w, 1, true) or string.find(p, w, 1, true) then return true end
					end
					return false
				end
				local function basePart(inst)
					if inst:IsA("BasePart") then return inst end
					local a = inst.Parent
					while a and a ~= workspace do
						if a:IsA("BasePart") then return a end
						if a:IsA("Model") then
							local p = a.PrimaryPart or a:FindFirstChildWhichIsA("BasePart", true)
							if p then return p end
						end
						a = a.Parent
					end
				end
				local function interact(inst, part)
					local hrp = hrpNow()
					if inst:IsA("ProximityPrompt") then
						pcall(function() inst.HoldDuration = 0 end)
						if fireproximityprompt then pcall(fireproximityprompt, inst) end
					elseif inst:IsA("ClickDetector") then
						if fireclickdetector then pcall(fireclickdetector, inst) end
					elseif inst:IsA("TouchTransmitter") or inst:FindFirstChildOfClass("TouchTransmitter") then
						if firetouchinterest and hrp then
							pcall(function() firetouchinterest(hrp, part, 0); task.wait(0.05); firetouchinterest(hrp, part, 1) end)
						end
					end
				end
				local function targets(ev)
					local isl = island(ev)
					local out = {}
					if not isl then return out end
					for _, d in ipairs(isl:GetDescendants()) do
						if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("TouchTransmitter") then
							local part = basePart(d)
							if part and nameMatch(ev, d.Parent or d) then table.insert(out, {d, part}) end
						end
					end
					return out
				end
				local function run(ev, state)
					ev.token = ev.token + 1
					if not state then return end
					local my = ev.token
					task.spawn(function()
						local told = false
						while ev.token == my and screenGui.Parent do
							local isl = island(ev)
							if not isl then
								told = false
							else
								local list = targets(ev)
								if #list == 0 and not told then
									told = true
									note(ev.label .. ": nada para pegar (use \"Copiar objetos da ilha\")", Color3.fromRGB(255, 200, 120))
								end
								for _, t in ipairs(list) do
									if ev.token ~= my then break end
									local hrp = hrpNow()
									if not hrp or not t[2].Parent then continue end
									pcall(function() hrp.CFrame = t[2].CFrame * CFrame.new(0, 3, 0) end)
									task.wait(0.35)
									interact(t[1], t[2])
									task.wait(0.35)
								end
							end
							local w = 0
							while w < 3 and ev.token == my do task.wait(0.5); w = w + 0.5 end
						end
					end)
				end
				-- Mirage: olhar para a lua (necessário para o buff de raça/engrenagem)
				local lookMoon = false
				local moonTok = 0
				addToggle(sec, "Mirage: pegar objetos da ilha", function(s) run(EV.mirage, s) end, false)
				addToggle(sec, "Mirage: olhar para a lua", function(s)
