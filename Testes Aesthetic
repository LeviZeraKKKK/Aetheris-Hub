		gui.Size = UDim2.fromOffset(popW, 0)
		gui.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
		gui.BackgroundTransparency = 0
		gui.BorderSizePixel = 0
		gui.ClipsDescendants = true
		gui.ZIndex = 60
		gui.Parent = screenGui
		pop.gui = gui
