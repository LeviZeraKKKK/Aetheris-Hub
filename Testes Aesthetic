			function F.register(key, section, origin, applyVisual)
				F.order = F.order + 1
				section.LayoutOrder = F.order
				local e = {key = key, section = section, origin = origin, fav = F.saved[key] == true, apply = applyVisual}
				table.insert(F.entries, e)
				F.byKey[key] = e
				applyVisual(e.fav, false)
				updateBadge(false)
				return e
			end
			function F.toggle(e)
				e.fav = not e.fav
				e.apply(e.fav, true)
				saveFavorites()
				updateBadge(true)
				if F.viewOpen then layoutView(); setTitle(true) end
				if AetherisNotify then
					local en = AetherisI18n and AetherisI18n.lang == "en"
					AetherisNotify(e.fav and (en and "★ Added to favorites" or "★ Adicionada aos favoritos") or (en and "☆ Removed from favorites" or "☆ Removida dos favoritos"), YELLOW)
				end
			end
			clearBtn.MouseButton1Click:Connect(function()
				for _, e in ipairs(F.entries) do
