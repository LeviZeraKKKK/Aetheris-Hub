local espDrawings = {}

Players.PlayerRemoving:Connect(function(leavingPlayer)
	if espDrawings[leavingPlayer] then
		pcall(function()
			for _, drawingObj in pairs(espDrawings[leavingPlayer]) do
				if typeof(drawingObj) == "table" and drawingObj.Remove then
					drawingObj:Remove()
				end
			end
		end)
		espDrawings[leavingPlayer] = nil
	end
	selectedManualTargets[leavingPlayer] = nil
end)

local function getAdvancedTarget()
	local bestTarget = nil
	local bestScore = math.huge
	local myChar = player.Character

	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	
	if _G_FilterHoldingItem then
		local holdingTool = false
		for _, item in ipairs(myChar:GetChildren()) do
			if item:IsA("Tool") then
				holdingTool = true
				break
			end
		end
		if not holdingTool then return nil end
	end

	local myPos = myChar.HumanoidRootPart.Position
	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

	if _G_LockOnPlayers then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") then
				local hum = p.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					local hrp = p.Character.HumanoidRootPart
					local dist = (hrp.Position - myPos).Magnitude

					if not _G_FilterDistanceEnabled or dist <= _G_FilterDistanceMax then
						local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
						if onScreen then
							local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
							
							if not _G_FovVisible or screenDist <= _G_FovRadius then
								local score = dist
								if _G_FilterClosest then score = dist end
								if _G_FilterLowestHP then score = hum.Health end
								if _G_FilterCrosshair then score = screenDist end

								if score < bestScore then
									bestScore = score
									bestTarget = p.Character.Head
								end
							end
						end
					end
				end
			end
		end
	end

	if _G_LockOnEnemies and ENEMIES then
		for _, enemyModel in ipairs(ENEMIES:GetChildren()) do
			if enemyModel:IsA("Model") then
				local hum = enemyModel:FindFirstChildOfClass("Humanoid")
				local head = enemyModel:FindFirstChild("Head") or getEnemyRoot(enemyModel)
				if hum and hum.Health > 0 and head then
					local dist = (head.Position - myPos).Magnitude

					if not _G_FilterDistanceEnabled or dist <= _G_FilterDistanceMax then
						local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
						if onScreen then
							local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude

							if not _G_FovVisible or screenDist <= _G_FovRadius then
								local score = dist
								if _G_FilterClosest then score = dist end
								if _G_FilterLowestHP then score = hum.Health end
								if _G_FilterCrosshair then score = screenDist end

								if score < bestScore then
									bestScore = score
									bestTarget = head
								end
							end
						end
					end
				end
			end
		end
	end

	return bestTarget
end

local function getManualTarget()
	local bestTarget = nil
	local shortestDist = math.huge
	local myChar = player.Character

	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = myChar.HumanoidRootPart.Position

	for p, isSelected in pairs(selectedManualTargets) do
		if isSelected and p and p.Character and p.Character:FindFirstChild("Head") then
			local hum = p.Character:FindFirstChild("Humanoid")
			if hum and hum.Health > 0 then
				local headPos = p.Character.Head.Position
				local dist = (headPos - myPos).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					bestTarget = p.Character.Head
				end
			end
		end
	end

	return bestTarget
end

RunService.RenderStepped:Connect(function()
	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		local hum = char.Humanoid
		
		if _G_WalkSpeedEnabled then 
			hum.WalkSpeed = _G_WalkSpeedValue 
		end
		
		if _G_JumpPowerEnabled then 
			hum.UseJumpPower = true
			hum.JumpPower = _G_JumpPowerValue 
		else
			hum.UseJumpPower = true
			hum.JumpPower = 50
		end
	end

	if char then
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = not _G_NoclipEnabled
			end
		end
	end

	if _G_EnergyEnabled and char then
		if char:GetAttribute("Energy") then char:SetAttribute("Energy", 999999) end
		if char:GetAttribute("Stamina") then char:SetAttribute("Stamina", 999999) end

		local energyObj = char:FindFirstChild("Energy") or (player:FindFirstChild("Data") and player.Data:FindFirstChild("Energy"))
		if energyObj and energyObj:IsA("ValueBase") then energyObj.Value = 999999 end
		
		local stats = player:FindFirstChild("Stats")
		if stats then
			local statEnergy = stats:FindFirstChild("Energy") or stats:FindFirstChild("Stamina")
			if statEnergy and statEnergy:IsA("ValueBase") then statEnergy.Value = 999999 end
		end
	end

	if _G_FovVisible and fovCircleDrawing then
		pcall(function()
			fovCircleDrawing.Visible = true
			fovCircleDrawing.Radius = _G_FovRadius
			fovCircleDrawing.Thickness = _G_FovThickness
			fovCircleDrawing.Transparency = _G_FovTransparency
			fovCircleDrawing.Color = _G_ColorFov
			fovCircleDrawing.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
			fovCircleDrawing.Filled = false
		end)
	elseif fovCircleDrawing then
		pcall(function() fovCircleDrawing.Visible = false end)
	end

	if isLockOnEnabled then
		local targetHeadToLock = nil
		if lockOnMode == "Nearest" then
			targetHeadToLock = getAdvancedTarget()
		elseif lockOnMode == "Manual" then
			targetHeadToLock = getManualTarget()
		end

		if targetHeadToLock and targetHeadToLock:IsA("BasePart") then
			camera.CFrame = CFrame.new(camera.CFrame.Position, targetHeadToLock.Position)
		end
	end

	for _, targetPlayer in pairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			local tChar = targetPlayer.Character
			if _G_EspMaster and tChar and tChar:FindFirstChild("HumanoidRootPart") and tChar:FindFirstChild("Humanoid") and tChar.Humanoid.Health > 0 then
				local hrp = tChar.HumanoidRootPart
				local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)

				if not espDrawings[targetPlayer] then
					pcall(function()
						espDrawings[targetPlayer] = {
							Box = Drawing.new("Square"),
							Line = Drawing.new("Line"),
							NameText = Drawing.new("Text"),
							DistText = Drawing.new("Text"),
							HeadDot = Drawing.new("Circle"),
							HealthBarBg = Drawing.new("Square"),
							HealthBarFill = Drawing.new("Square")
						}
					end)
				end

				local cache = espDrawings[targetPlayer]
				if cache then
					local head = tChar:FindFirstChild("Head")

					if _G_EspBox and onScreen then
						local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
						local legPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
						local height = math.abs(headPos.Y - legPos.Y)
						local width = height / 1.8

						cache.Box.Size = Vector2.new(width, height)
						cache.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
						cache.Box.Color = _G_ColorBox
						cache.Box.Thickness = 1
						cache.Box.Visible = true
					else
						cache.Box.Visible = false
					end

					if _G_EspLine and onScreen then
						local originY = camera.ViewportSize.Y
						if _G_TracerOrigin == "Top" then
							originY = 0
						elseif _G_TracerOrigin == "Center" then
							originY = camera.ViewportSize.Y / 2
						else
							originY = camera.ViewportSize.Y
						end

						cache.Line.From = Vector2.new(camera.ViewportSize.X / 2, originY)
						cache.Line.To = Vector2.new(pos.X, pos.Y)
						cache.Line.Color = _G_ColorLine
						cache.Line.Thickness = 1
						cache.Line.Visible = true
					else
						cache.Line.Visible = false
					end

					local highlight = tChar:FindFirstChild("AetherisHighlight")
					if _G_EspChams then
						if not highlight then
							highlight = Instance.new("Highlight")
							highlight.Name = "AetherisHighlight"
							highlight.Parent = tChar
						end
						highlight.FillColor = _G_ColorChams
						highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
						highlight.Enabled = true
					elseif highlight then
						highlight.Enabled = false
					end

					if _G_EspHealth and onScreen then
						local hum = tChar.Humanoid
						local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
						local legPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
						local height = math.abs(headPos.Y - legPos.Y)
						local width = height / 1.8

						local barHeight = height
						local currentHealthHeight = barHeight * (hum.Health / hum.MaxHealth)

						cache.HealthBarBg.Size = Vector2.new(3, barHeight)
						cache.HealthBarBg.Position = Vector2.new(pos.X - width / 2 - 6, pos.Y - height / 2)
						cache.HealthBarBg.Color = Color3.fromRGB(20, 20, 20)
						cache.HealthBarBg.Filled = true
						cache.HealthBarBg.Visible = true

						cache.HealthBarFill.Size = Vector2.new(1, currentHealthHeight)
						cache.HealthBarFill.Position = Vector2.new(pos.X - width / 2 - 5, pos.Y - height / 2 + (barHeight - currentHealthHeight))
						cache.HealthBarFill.Color = _G_ColorHealth
						cache.HealthBarFill.Filled = true
						cache.HealthBarFill.Visible = true
					else
						cache.HealthBarBg.Visible = false
						cache.HealthBarFill.Visible = false
					end

					if _G_EspName and onScreen and hrp then
						cache.NameText.Text = targetPlayer.Name
						cache.NameText.Size = 12
						cache.NameText.Center = true
						cache.NameText.Outline = true
						cache.NameText.Color = _G_ColorName
						cache.NameText.Position = Vector2.new(pos.X, pos.Y - 35)
						cache.NameText.Visible = true
					else
						cache.NameText.Visible = false
					end

					if _G_EspDistance and onScreen then
						local dist = math.floor((camera.CFrame.Position - hrp.Position).Magnitude)
						cache.DistText.Text = "[" .. dist .. "m]"
						cache.DistText.Size = 11
						cache.DistText.Center = true
						cache.DistText.Outline = true
						cache.DistText.Color = _G_ColorDistance
						cache.DistText.Position = Vector2.new(pos.X, pos.Y + 25)
						cache.DistText.Visible = true
					else
						cache.DistText.Visible = false
					end

					if _G_EspHead and head and onScreen then
						local headPos = camera:WorldToViewportPoint(head.Position)
						cache.HeadDot.Radius = 4
						cache.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
						cache.HeadDot.Color = _G_ColorHead
						cache.HeadDot.Filled = true
						cache.HeadDot.Visible = true
					else
						cache.HeadDot.Visible = false
					end
				end
			else
				if espDrawings[targetPlayer] then
					pcall(function()
						espDrawings[targetPlayer].Box.Visible = false
						espDrawings[targetPlayer].Line.Visible = false
						espDrawings[targetPlayer].NameText.Visible = false
						espDrawings[targetPlayer].DistText.Visible = false
						espDrawings[targetPlayer].HeadDot.Visible = false
						espDrawings[targetPlayer].HealthBarBg.Visible = false
						espDrawings[targetPlayer].HealthBarFill.Visible = false
					end)
				end
				local hl = tChar and tChar:FindFirstChild("AetherisHighlight")
				if hl then hl.Enabled = false end
			end
		end
	end

	if _G_EnemyEspMaster then
		local myRoot = char and char:FindFirstChild("HumanoidRootPart")
		if myRoot then
			for enemy, data in pairs(enemyObjects) do
				local root = getEnemyRoot(enemy)
				local humanoid = enemy:FindFirstChildOfClass("Humanoid")
				if enemy.Parent and root and humanoid and humanoid.Health > 0 then
					local dist = (root.Position - myRoot.Position).Magnitude
					data.highlight.Enabled = _G_EnemyEspChams
					data.highlight.FillColor = _G_ColorEnemyChams
					data.nameLabel.Visible = _G_EnemyEspName
					data.nameLabel.TextColor3 = _G_ColorEnemyName
					data.distanceLabel.Visible = _G_EnemyEspDistance
					data.distanceLabel.TextColor3 = _G_ColorEnemyDist
					data.billboard.Enabled = (_G_EnemyEspName or _G_EnemyEspDistance)
					data.nameLabel.Text = enemy.Name
					data.distanceLabel.Text = string.format("%.0f studs", dist)
				else
					data.highlight.Enabled = false
					data.billboard.Enabled = false
				end
			end
		end
	else
		for _, data in pairs(enemyObjects) do
			if data.highlight then data.highlight.Enabled = false end
			if data.billboard then data.billboard.Enabled = false end
		end
	end
end)