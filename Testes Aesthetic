				end)

				if animateIn then
					row.BackgroundTransparency = 1
					nameLabel.TextTransparency = 1
					task.delay(index * 0.03, function()
						if not row.Parent then return end
						TweenService:Create(row, TweenInfo.new(0.25), {BackgroundTransparency = 0.2}):Play()
