		local function findInputTarget(position)
			local raw = Vector2.new(position.X, position.Y)
			local inset = guiService:GetGuiInset()
			local points = {raw, raw + inset, raw - inset}
			for _, point in ipairs(points) do
				if ui.closeX and isInside(ui.closeX, point) then return "close", nil, true end
			end
			for _, point in ipairs(points) do
				if isInside(ui.canvas, point) then return "sv", point - raw, true end
				if isInside(ui.hueBar, point) then return "hue", point - raw, true end
			end
			for _, point in ipairs(points) do
				if isInside(ui.modal, point) or isInside(colorBtn, point) then return nil, nil, true end
			end
			return nil, nil, false
		end

