	local function createPage(name)
		local page = Instance.new("ScrollingFrame")
		page.Size = UDim2.new(1, -8, 1, -8)
		page.Position = UDim2.new(1, 0, 0, 4)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.CanvasSize = UDim2.new(0, 0, 0, 0)
		page.ScrollBarThickness = 2
		page.Visible = false
		page:SetAttribute("AetherisPage", name) -- o Name da página não é definido (os presets dependem disso)
		page.Parent = contentContainer

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 4)
		layout.Parent = page

		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			page.CanvasSize = UDim2.new(0, 0, 0, AetherisLayoutHeight(layout) + 10)
		end)

		-- Duas colunas com uma linha vertical no meio (a aba Info tem layout próprio).
		if name ~= "Info" and name ~= "Information" then
			local holder = Instance.new("Frame")
			holder.Name = "Columns"
			holder.Size = UDim2.new(1, -4, 0, 0)
			holder.BackgroundTransparency = 1
			holder.BorderSizePixel = 0
			holder.LayoutOrder = -1
			holder.Parent = page

			local function makeColumn(x)
				-- O nome da coluna é o da página: o sistema de presets usa esse nome para as chaves.
				local col = Instance.new("Frame")
				col.Name = name
				col.Size = UDim2.new(0.5, -7, 1, 0)
				col.Position = UDim2.new(x, x == 0 and 0 or 7, 0, 0)
				col.BackgroundTransparency = 1
				col.BorderSizePixel = 0
				col.Parent = holder
				local cl = Instance.new("UIListLayout")
				cl.SortOrder = Enum.SortOrder.LayoutOrder
				cl.Padding = UDim.new(0, 4)
				cl.Parent = col
				return col, cl
			end
			local leftCol, leftLayout = makeColumn(0)
			local rightCol, rightLayout = makeColumn(0.5)

			local divider = Instance.new("Frame")
			divider.Name = "ColumnDivider"
			divider.AnchorPoint = Vector2.new(0.5, 0)
			divider.Position = UDim2.new(0.5, 0, 0, 2)
			divider.Size = UDim2.new(0, 1, 1, -4)
			divider.BackgroundColor3 = Color3.fromRGB(58, 70, 100)
			divider.BorderSizePixel = 0
			divider.Active = false
			divider.Parent = holder
			local dg = Instance.new("UIGradient")
			dg.Rotation = 90
			dg.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.08, 0.3),
				NumberSequenceKeypoint.new(0.92, 0.3),
				NumberSequenceKeypoint.new(1, 1)
			})
			dg.Parent = divider

			-- Painel estreito: tira a divisória e empilha tudo de cima a baixo (1 coluna).
			local function refreshHolder()
				local hL, hR = AetherisLayoutHeight(leftLayout), AetherisLayoutHeight(rightLayout)
				if contentContainer.AbsoluteSize.X > 0 and contentContainer.AbsoluteSize.X < 310 then
					divider.Visible = false
					leftCol.Size = UDim2.new(1, 0, 0, hL)
					leftCol.Position = UDim2.new(0, 0, 0, 0)
					rightCol.Size = UDim2.new(1, 0, 0, hR)
					rightCol.Position = UDim2.new(0, 0, 0, hL + (hR > 0 and hL > 0 and 6 or 0))
					holder.Size = UDim2.new(1, -4, 0, hL + hR + ((hR > 0 and hL > 0) and 6 or 0))
				else
					divider.Visible = true
					leftCol.Size = UDim2.new(0.5, -7, 1, 0)
					leftCol.Position = UDim2.new(0, 0, 0, 0)
					rightCol.Size = UDim2.new(0.5, -7, 1, 0)
					rightCol.Position = UDim2.new(0.5, 7, 0, 0)
					holder.Size = UDim2.new(1, -4, 0, math.max(hL, hR))
				end
			end
			leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshHolder)
			rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshHolder)
			contentContainer:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshHolder)

			local entry = {left = leftCol, right = rightCol, count = 0}
			pageColumns[page] = entry
			-- createSection também aceita uma coluna como destino (ex.: secFarm.Parent.Parent).
			pageColumns[leftCol] = entry
			pageColumns[rightCol] = entry
		end

		pages[name] = page
		return page
	end

