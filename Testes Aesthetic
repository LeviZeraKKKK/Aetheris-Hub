			local valueType = typeof(value)
			if valueType == "Color3" then
				return {__aetherisType = "Color3", r = value.R, g = value.G, b = value.B}
			elseif valueType == "EnumItem" then
				local enumType = string.match(tostring(value.EnumType), "Enum%.(.+)")
				return {__aetherisType = "EnumItem", enumType = enumType, name = value.Name}
			elseif type(value) == "table" then
				local out = {}
				for key, item in pairs(value) do
					if type(key) == "string" or type(key) == "number" then
						local encoded = manager.encode(item)
						if encoded ~= nil then out[key] = encoded end
					end
				end
				return out
			elseif type(value) == "string" or type(value) == "number" or type(value) == "boolean" then
				return value
			end
			return nil
		end
		manager.decode = function(value)
			if type(value) ~= "table" then return value end
