		local sessionStart = os.clock()
		local function fmtDuration(t)
			t = math.floor(t)
			if t >= 3600 then return string.format("%dh %02dm", t // 3600, (t % 3600) // 60) end
			if t >= 60 then return string.format("%dm %02ds", t // 60, t % 60) end
			return t .. "s"
		end
		local function fmtNum(n)
			if type(n) ~= "number" then return "--" end
			local str = tostring(math.floor(n))
			local r = string.reverse(str):gsub("(%d%d%d)", "%1,")
			r = string.reverse(r):gsub("^,", "")
			return r
		end
