					pageTitle.Text = ((AetherisI18n and AetherisI18n.lang == "en") and "Favorites" or "Favoritos") .. (n > 0 and (" (" .. n .. ")") or "")
				else
					pageTitle.Text = tabTextFor(activeTitleData)
				end
			end
