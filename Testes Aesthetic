			dragStart = input.Position
			startPos = mainPanel.Position
			interactionBlocker.Visible = true
			-- Prévia: só um contorno com marcações nas bordas acompanha o mouse; o painel só muda de lugar ao soltar.
			AetherisGhost = AetherisGhost or {}
			local G = AetherisGhost
			if G.frame then G.frame:Destroy() end
			local ghost = Instance.new("Frame")
			ghost.Name = "PanelDragPreview"
			ghost.AnchorPoint = mainPanel.AnchorPoint
			ghost.Position = startPos
