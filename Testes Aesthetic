	do
		local secAttackDirect = createSection(aimLockPage, "Ataque direto", sectionIcons.AttackDirect)
		local AD = {
			enabled = false, players = true, npcs = true, useAttackEvent = true,
			range = 20, delay = 0.1, lastHit = 0, combo = 1, conn = nil, resolved = false
		}

		-- Procura os remotes só na primeira ativação.
		local function resolveRemotes()
			if AD.resolved then return AD.hitEvent ~= nil end
			pcall(function()
				local net = require(ReplicatedStorage.Modules.Net)
				if net and type(net.RemoteEvent) == "function" then
					AD.hitEvent = net:RemoteEvent("RegisterHit")
					AD.attackEvent = net:RemoteEvent("RegisterAttack")
				end
			end)
			if not AD.hitEvent then
				for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
					if obj:IsA("RemoteEvent") then
						if obj.Name == "RegisterHit" then AD.hitEvent = obj end
						if obj.Name == "RegisterAttack" then AD.attackEvent = obj end
					end
				end
			end
			AD.resolved = AD.hitEvent ~= nil
			if not AD.hitEvent then
				warn("[Aetheris] Attack Direct: RegisterHit não encontrado")
			end
			return AD.hitEvent ~= nil
		end

		local function getTool()
			local char = player.Character
			if not char then return nil end
			local tool = char:FindFirstChildOfClass("Tool")
			if tool and tool:FindFirstChild("LocalEquippedWeaponPointer") then return tool end
			return nil
		end

		local function scanNearby()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return {} end
			local results = {}
			local function scan(folder)
				if not folder then return end
				for _, obj in ipairs(folder:GetChildren()) do
					if obj ~= char then
						local hum = obj:FindFirstChildOfClass("Humanoid")
						local hitPart = obj:FindFirstChild("Head") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("HumanoidRootPart")
						if hum and hum.Health > 0 and hitPart then
							local summoner = obj:FindFirstChild("Summoner")
							if not (summoner and summoner.Value == player) then
								local d = (hitPart.Position - hrp.Position).Magnitude
								if d <= AD.range then
									table.insert(results, {char = obj, part = hitPart, dist = d})
								end
							end
						end
					end
				end
			end
			if AD.players then scan(workspace:FindFirstChild("Characters")) end
			if AD.npcs then scan(workspace:FindFirstChild("Enemies")) end
			table.sort(results, function(a, b) return a.dist < b.dist end)
			return results
		end

		local function doHit()
			if tick() - AD.lastHit < AD.delay then return end
			if not getTool() then return end
			local targets = scanNearby()
			if #targets == 0 then return end

			AD.lastHit = tick()
			AD.combo = (AD.combo % 4) + 1

			-- atualiza o combo para não ficar preso no 1
			if AD.useAttackEvent and AD.attackEvent then
				pcall(function() AD.attackEvent:FireServer(0.3, AD.combo) end)
			end

			local primary = targets[1]
			local extras = {}
			for i = 2, #targets do
				table.insert(extras, {targets[i].char, targets[i].part})
			end
			pcall(function() AD.hitEvent:FireServer(primary.part, extras) end)
		end

		local function stopAttackDirect()
			AD.enabled = false
			if AD.conn then AD.conn:Disconnect(); AD.conn = nil end
		end

		local function startAttackDirect()
			if not resolveRemotes() then return end
			if AD.conn then AD.conn:Disconnect() end
			AD.enabled = true
			AD.conn = RunService.Heartbeat:Connect(function()
				if not screenGui.Parent then stopAttackDirect() return end
				if AD.enabled then doHit() end
			end)
		end

		addToggle(secAttackDirect, "Ataque direto", function(state)
			if state then startAttackDirect() else stopAttackDirect() end
		end, false)
		addToggle(secAttackDirect, "Atacar Players", function(state) AD.players = state end, true)
		addToggle(secAttackDirect, "Atacar NPCs", function(state) AD.npcs = state end, true)
		addSlider(secAttackDirect, "Raio", 5, 150, 20, function(val) AD.range = val end, 0, " studs")
		addSlider(secAttackDirect, "Delay entre hits", 0.05, 1, 0.1, function(val) AD.delay = math.max(0.05, val) end, 2, "s")

		screenGui.Destroying:Connect(stopAttackDirect)
	end

