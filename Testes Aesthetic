					BackgroundColor3 = Color3.fromRGB(58, 38, 48), BorderSizePixel = 0, AutoButtonColor = false,
					Image = "rbxassetid://7743873772", ImageColor3 = Color3.fromRGB(255, 130, 140), ScaleType = Enum.ScaleType.Fit
				}, row)
				round(delete, 6)
				new("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)}, delete)
				hover(delete, Color3.fromRGB(58, 38, 48))
				row.MouseEnter:Connect(function()
