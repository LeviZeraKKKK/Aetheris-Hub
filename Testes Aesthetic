					end
				end)
				row.MouseLeave:Connect(function()
					if manager.selectedName ~= profileName then
						TweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = CARD}):Play()
					end
				end)
				row.MouseButton1Click:Connect(function()
					manager.setSelected(profileName)
					manager.setListOpen(false)
				end)
				delete.MouseButton1Click:Connect(function()
					manager.showConfirm(profileName)
				end)
				-- entrada em cascata
				row.BackgroundTransparency = 1
				nameLabel.TextTransparency = 1
				task.delay(index * 0.03, function()
					if not row.Parent then return end
					TweenService:Create(row, TweenInfo.new(0.22), {BackgroundTransparency = 0.1}):Play()
					TweenService:Create(nameLabel, TweenInfo.new(0.22), {TextTransparency = 0}):Play()
				end)
			end
		end

