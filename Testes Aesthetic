function FVX.close()
    if not panel.Visible or FVX.closing then return end
    FVX.closing = true
    TweenService:Create(viewScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.88}):Play()
