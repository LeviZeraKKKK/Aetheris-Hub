local function shopRender(colData, fruits, beli)
	local scroll = colData.scroll
	local onSale = {}
	for _, f in ipairs(fruits) do
		if f.OnSale == true then table.insert(onSale, f) end
	end
	table.sort(onSale, function(a, b)
		return shopGetPrice(a.Name, a) < shopGetPrice(b.Name, b)
	end)
	colData.lastFruits = onSale

	local parts = table.create(#onSale)
	for i, f in ipairs(onSale) do
		local p = shopGetPrice(f.Name, f)
		parts[i] = f.Name .. ":" .. p .. ":" .. tostring(beli >= p)
	end
	local sig = table.concat(parts, "|")
	if sig == colData.lastSig then return end
	colData.lastSig = sig

	local pool = colData.pool
	local count = #onSale

	for i = 1, count do
		local f = onSale[i]
		local price = shopGetPrice(f.Name, f)
		local canAfford = beli >= price
		local entry = pool[i]
		if not entry then
			entry = shopCreateRow(scroll)
			pool[i] = entry
		end
		entry.row.Visible = true
		entry.row.Position = UDim2.new(0, 2, 0, (i - 1) * SHOP_ROW_STEP)
		entry.row.BackgroundColor3 = canAfford and SHOP_COLOR_OK_BG or SHOP_COLOR_NO_BG
		shopSetText(entry.name, f.Name .. (f.HasPermanent and " ⭐" or ""))
		entry.price.TextColor3 = canAfford and SHOP_COLOR_POK or SHOP_COLOR_PNO
		shopSetText(entry.price, shopFmt(price))
	end

	for i = count + 1, #pool do
		if pool[i].row.Visible then pool[i].row.Visible = false end
	end

	if count == 0 then
		if not colData.emptyLbl then
			local l = Instance.new("TextLabel")
			l.Size = UDim2.new(1, -4, 0, 16)
			l.Position = UDim2.new(0, 2, 0, 2)
			l.BackgroundTransparency = 1
			l.TextColor3 = Color3.fromRGB(140, 140, 170)
			l.Font = currentGlobalFont
			l.TextSize = 9
			l.Text = "(vazio)"
			l.Parent = scroll
			colData.emptyLbl = l
		end
		colData.emptyLbl.Visible = true
	elseif colData.emptyLbl then
		colData.emptyLbl.Visible = false
	end

	scroll.CanvasSize = UDim2.new(0, 0, 0, count * SHOP_ROW_STEP + 4)
end

