	-- AUTO ATTACK (ataca automaticamente quem estiver ao redor)
	-----------------------------------------------------------------
	do
		local secAutoAttack = createSection(aimLockPage, "Atacar Automáticamente", sectionIcons.AutoAttack)
		local AA = {
			enabled = false, players = true, npcs = true, range = 25, delay = 0.15,
			lastAttack = 0, conn = nil, loaded = false
		}
		-- Input falso para armas à distância (usam o mouse.Hit internamente)
		local fakeInput = {
			UserInputType = Enum.UserInputType.MouseButton1,
			UserInputState = Enum.UserInputState.Begin,
			Position = Vector3.zero,
			Delta = Vector3.zero,
			KeyCode = Enum.KeyCode.Unknown,
		}

		local function loadModules()
			if AA.loaded then return true end
			local okCC, CC = pcall(function() return require(ReplicatedStorage.Controllers.CombatController) end)
			if not okCC or not CC then
				warn("[Aetheris] Auto Attack: CombatController indisponível")
				return false
			end
			local okCU, CU = pcall(function() return require(ReplicatedStorage.Modules.CombatUtil) end)
			AA.CC = CC
			AA.CU = okCU and CU or nil
			AA.loaded = true
			return true
		end

		local function getEquippedTool()
			local char = player.Character
			if not char then return nil end
			local tool = char:FindFirstChildOfClass("Tool")
			if not tool or not tool:FindFirstChild("LocalEquippedWeaponPointer") then return nil end
			return tool
		end

		local function isValidTarget(obj)
			if not obj or not obj.Parent then return false end
			local myChar = player.Character
			if not myChar or obj == myChar then return false end
			local hum = obj:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then return false end
			local summoner = obj:FindFirstChild("Summoner")
			if summoner and summoner.Value == player then return false end
			local myHRP = myChar:FindFirstChild("HumanoidRootPart")
			local tHRP = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
			if not myHRP or not tHRP then return false end
			if (tHRP.Position - myHRP.Position).Magnitude > AA.range then return false end
			return true, tHRP, hum
		end

		local function findTarget()
			local myChar = player.Character
			local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not myHRP then return nil end
			local best, bestDist = nil, math.huge
			local function scan(folder)
				if not folder then return end
				for _, obj in ipairs(folder:GetChildren()) do
					local ok, hrp = isValidTarget(obj)
					if ok then
						local d = (hrp.Position - myHRP.Position).Magnitude
						if d < bestDist then
							bestDist = d
							best = {char = obj, hrp = hrp, dist = d}
						end
					end
				end
			end
			if AA.players then scan(workspace:FindFirstChild("Characters")) end
			if AA.npcs then scan(workspace:FindFirstChild("Enemies")) end
			return best
		end

		local function faceTarget(targetHRP)
			local char = player.Character
			local myHRP = char and char:FindFirstChild("HumanoidRootPart")
			if not myHRP then return end
			local pos, tp = myHRP.Position, targetHRP.Position
			myHRP.CFrame = CFrame.lookAt(pos, Vector3.new(tp.X, pos.Y, tp.Z))
		end

		local function tryAttack()
			if tick() - AA.lastAttack < AA.delay then return end
			local tool = getEquippedTool()
			if not tool then return end
			local char = player.Character
			if AA.CU then
				local okData, wdata = pcall(function()
					return AA.CU:GetWeaponData(AA.CU:GetWeaponName(tool))
				end)
				if not okData or not wdata then return end
				local okCan, canAttack = pcall(function() return AA.CU:CanAttack(char, wdata.WeaponType) end)
				if okCan and not canAttack then return end
			end
			AA.lastAttack = tick()
			local ok = pcall(function() AA.CC:Attack(tool, fakeInput) end)
			if not ok then pcall(function() tool:Activate() end) end
		end

		local function stopAutoAttack()
			AA.enabled = false
			if AA.conn then AA.conn:Disconnect(); AA.conn = nil end
		end

		local function startAutoAttack()
			if not loadModules() then return end
			if AA.conn then AA.conn:Disconnect() end
			AA.enabled = true
			AA.conn = RunService.Heartbeat:Connect(function()
				if not screenGui.Parent then stopAutoAttack() return end
				if not AA.enabled then return end
				local target = findTarget()
				if target then
					faceTarget(target.hrp)
					tryAttack()
				end
			end)
		end

		addToggle(secAutoAttack, "Atacar Automáticamente", function(state)
			if state then startAutoAttack() else stopAutoAttack() end
		end, false)
		addToggle(secAutoAttack, "Atacar Players", function(state) AA.players = state end, true)
		addToggle(secAutoAttack, "Atacar NPCs", function(state) AA.npcs = state end, true)
		addSlider(secAutoAttack, "Alcance", 5, 150, 25, function(val) AA.range = val end, 0, " studs")
		addSlider(secAutoAttack, "Delay entre ataques", 0.05, 1, 0.15, function(val) AA.delay = math.max(0.05, val) end, 2, "s")

		screenGui.Destroying:Connect(stopAutoAttack)
	end

