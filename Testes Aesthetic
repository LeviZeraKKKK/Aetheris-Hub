		-- Módulos e remotes são procurados só na primeira ativação
		function Q.init()
			if Q.ready then return true end
			local RS = ReplicatedStorage
			pcall(function()
				local net = require(RS.Modules.Net)
				Q.hitEvent = net:RemoteEvent("RegisterHit")
				Q.attackEvent = net:RemoteEvent("RegisterAttack")
			end)
			if not Q.hitEvent then
				for _, obj in ipairs(RS:GetDescendants()) do
					if obj:IsA("RemoteEvent") then
						if obj.Name == "RegisterHit" then Q.hitEvent = obj end
						if obj.Name == "RegisterAttack" then Q.attackEvent = obj end
					end
				end
			end
			local remotes = RS:FindFirstChild("Remotes")
			Q.questUpdate = remotes and remotes:FindFirstChild("QuestUpdate") or nil
			Q.commF = remotes and remotes:FindFirstChild("CommF_") or nil
			pcall(function() Q.quests = require(RS.Quests) end)
			pcall(function() Q.questController = require(RS.Controllers.QuestController) end)
			pcall(function()
				local s = RS:FindFirstChild("NPCManager")
				if s then Q.npcManager = require(s) end
			end)
			pcall(function() Q.dialogue = require(RS.DialogueController) end)
			if not Q.hitEvent then warn("[Aetheris] Auto Farm Level: RegisterHit não achado"); return false end
			if not Q.quests then warn("[Aetheris] Auto Farm Level: Quests não achado"); return false end
			if not Q.commF then warn("[Aetheris] Auto Farm Level: CommF_ não achado"); return false end
			if Q.questUpdate then
				Q.questUpdate.OnClientEvent:Connect(function(_, data)
					if data and data.Context == "Complete" then
						if data.InternalQuestName == Q.questCat or data.Name == Q.questName then
							Q.completed = true
						end
					end
				end)
			end
			Q.ready = true
			return true
		end

		function Q.getLevel()
			local data = player:FindFirstChild("Data")
			if data then
				local lvl = data:FindFirstChild("Level")
				if lvl and lvl:IsA("ValueBase") then return lvl.Value end
				for _, c in ipairs(data:GetChildren()) do
					if c.Name:lower():find("level") and c:IsA("ValueBase") then return c.Value end
				end
			end
			local direct = player:FindFirstChild("Level") or player:FindFirstChild("LevelValue")
			if direct and direct:IsA("ValueBase") then return direct.Value end
			local attr = player:GetAttribute("Level")
			if attr then return attr end
			local char = player.Character
			if char then
				local a = char:GetAttribute("Level")
				if a then return a end
			end
			return 0
		end

		function Q.pickBest(ceilExclusive)
			if not Q.quests then return nil end
			local level = Q.getLevel()
			local best = nil
			for catName, entries in pairs(Q.quests) do
				if type(entries) == "table" then
					for idx, q in ipairs(entries) do
						if type(q) == "table" and type(q.LevelReq) == "number" and q.LevelReq <= level
							and (not ceilExclusive or q.LevelReq < ceilExclusive) then
							if not best or q.LevelReq > best.levelReq then
								local taskType = nil
								for t in pairs(q.Task or {}) do taskType = t; break end
								best = {category = catName, questName = q.Name, index = idx, levelReq = q.LevelReq, taskType = taskType}
							end
						end
					end
				end
			end
			return best
		end

		function Q.updateSelection()
			local best = Q.pickBest()
			-- missão anterior ativa: só volta para a melhor quando o level muda de faixa ou ela termina
			if Q.fallback and best and best.levelReq == Q.fallback.bestReq then return best end
			Q.fallback = nil
			if best then
				Q.curLevelReq = best.levelReq
				Q.questCat = best.category
				Q.questName = best.questName
				Q.taskType = best.taskType
				Q.questIndex = best.index
			end
			return best
		end

		function Q.updateLevelInfo()
			if not Q.levelLabel or not Q.levelLabel.Parent then return end
			local lvl = Q.getLevel()
			local best = Q.pickBest()
			local methodTag = Q.method == 1 and "🟢 Dir" or "🔵 Dlg"
			local weaponTag = ({Any = "🎲", Melee = "🥊", Fruit = "🍎", Sword = "⚔️"})[Q.weapon] or "?"
			if best then
				Q.levelLabel.Text = string.format("👤 Lv %d | 🎯 %s (%d) | #%d\n%s %s", lvl, tostring(best.questName), best.levelReq, best.index, methodTag, weaponTag)
			else
				Q.levelLabel.Text = string.format("👤 Lv %d | ❌ Sem quest | %s %s", lvl, methodTag, weaponTag)
			end
		end

		-- Armas
		function Q.toolType(tool)
			if not tool or not tool:IsA("Tool") then return nil end
			local wt = tool:GetAttribute("WeaponType")
			if wt == "Demon Fruit" then return "Fruit" end
			if wt == "Sword" then return "Sword" end
			if wt == "Melee" then return "Melee" end
			if wt == "Gun" then return "Gun" end
			if tool:HasTag("MeleeTool") then return "Melee" end
			if tool:HasTag("GunTool") then return "Gun" end
			local n = tool.Name:lower()
			if n:find("fruit") then return "Fruit" end
			if n:find("sword") or n:find("blade") or n:find("katana") or n:find("saber") then return "Sword" end
			if n:find("fighting") or n:find("karate") or n:find("art") then return "Melee" end
			if tool:GetAttribute("FruitType") then return "Fruit" end
			return nil
		end

		function Q.getTool()
			local char = player.Character
			local tool = char and char:FindFirstChildOfClass("Tool")
			if not tool or not tool:FindFirstChild("LocalEquippedWeaponPointer") then return nil end
			if Q.weapon ~= "Any" and Q.toolType(tool) ~= Q.weapon then return nil end
			return tool
		end

		function Q.equipType(desired)
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hum then return false end
			if desired == "Any" then return char:FindFirstChildOfClass("Tool") ~= nil end
			for _, tool in ipairs(char:GetChildren()) do
				if tool:IsA("Tool") and Q.toolType(tool) == desired then return true end
			end
			local backpack = player:FindFirstChild("Backpack")
			if backpack then
				for _, tool in ipairs(backpack:GetChildren()) do
					if tool:IsA("Tool") and Q.toolType(tool) == desired then
						pcall(function() hum:EquipTool(tool) end)
						task.wait(0.2)
						return true
					end
				end
			end
			return false
		end

		function Q.ensureWeapon()
			if Q.weapon == "Any" then return true end
			if tick() - Q.lastEquip < 1 then return false end
			local char = player.Character
			if not char then return false end
			local equipped = char:FindFirstChildOfClass("Tool")
			if equipped and Q.toolType(equipped) == Q.weapon then return true end
			Q.lastEquip = tick()
			return Q.equipType(Q.weapon)
		end

		-- Combate
		function Q.scanEnemies(range)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local folder = workspace:FindFirstChild("Enemies")
			local results = {}
			if not hrp or not folder then return results end
			for _, obj in ipairs(folder:GetChildren()) do
				if obj:IsA("Model") then
					local hum = obj:FindFirstChildOfClass("Humanoid")
					local part = obj:FindFirstChild("Head") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("HumanoidRootPart")
					if hum and hum.Health > 0 and part then
						local d = (part.Position - hrp.Position).Magnitude
						if d <= range then table.insert(results, {char = obj, part = part, dist = d, hum = hum}) end
					end
				end
			end
			table.sort(results, function(a, b) return a.dist < b.dist end)
			return results
		end

		function Q.aoeHit()
			if tick() - Q.lastHit < Q.hitDelay then return end
			if not Q.getTool() then return end
			local targets = Q.scanEnemies(Q.aoeRange)
			if #targets == 0 then return end
			Q.lastHit = tick()
			Q.combo = (Q.combo % 4) + 1
			if Q.attackEvent then pcall(function() Q.attackEvent:FireServer(0.3, Q.combo) end) end
			local extras = {}
			for i = 2, #targets do table.insert(extras, {targets[i].char, targets[i].part}) end
			pcall(function() Q.hitEvent:FireServer(targets[1].part, extras) end)
		end

		-- Noclip e voo
		function Q.enableNoclip()
			if Q.noclipConn then return end
			table.clear(Q.origCollision)
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						Q.origCollision[part] = part.CanCollide
						part.CanCollide = false
					end
				end
			end
			Q.noclipConn = RunService.Stepped:Connect(function()
				if not Q.enabled then return end
				local c = player.Character
				if not c then return end
				for _, part in ipairs(c:GetDescendants()) do
					if part:IsA("BasePart") then
						if Q.origCollision[part] == nil then Q.origCollision[part] = part.CanCollide end
						part.CanCollide = false
					end
				end
			end)
		end

		function Q.disableNoclip()
			if Q.noclipConn then Q.noclipConn:Disconnect(); Q.noclipConn = nil end
			for part, orig in pairs(Q.origCollision) do
				if part and part.Parent then part.CanCollide = orig end
			end
			table.clear(Q.origCollision)
		end

		function Q.fly(hrp, velocity)
			if not Q.bv or Q.bv.Parent ~= hrp then
				if Q.bv then Q.bv:Destroy() end
				Q.bv = Instance.new("BodyVelocity")
				Q.bv.Name = "AutoQuestFly"
				Q.bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
				Q.bv.P = 15000
				Q.bv.Velocity = Vector3.zero
				Q.bv.Parent = hrp
			end
			Q.bv.Velocity = velocity
		end

		function Q.stopFly()
			if Q.bv then Q.bv:Destroy(); Q.bv = nil end
		end

		-- Aceitar quest: método 1 (direto)
		function Q.acceptDirect()
			if not Q.questCat then return false end
			local cat, name, idx = Q.questCat, Q.questName, Q.questIndex
			local commF = Q.commF
			local attempts = {
				function() return commF:InvokeServer("StartQuest", cat, idx) end,
				function() return commF:InvokeServer("StartQuest", cat, name) end,
				function() return commF:InvokeServer("StartQuest", cat) end,
				function() return commF:InvokeServer("AcceptQuest", cat, idx) end,
				function() return commF:InvokeServer("AcceptQuest", cat) end,
				function() return commF:InvokeServer("QuestStart", cat, idx) end,
				function() return commF:InvokeServer(cat, idx) end,
				function() return commF:InvokeServer("Quest", cat, name) end,
			}
			for _, fn in ipairs(attempts) do
				local ok, result = pcall(fn)
				if ok and result ~= nil then
					if type(result) == "string" and (result:lower():find("start") or result:lower():find("accept") or result:lower():find("good")) then return true end
					if result == true then return true end
					if type(result) == "table" and result.Success then return true end
				end
				task.wait(0.15)
			end
			pcall(function() commF:InvokeServer("AbandonQuest") end)
			task.wait(0.3)
			return (pcall(function() commF:InvokeServer("StartQuest", cat, idx) end))
		end

		-- Aceitar quest: método 2 (diálogo)
		function Q.findGiver()
			local exactName = Q.questCat and Q.npcMap[Q.questCat]
			if not exactName then return nil end
			local function scan(folder)
				if not folder then return nil end
				for _, obj in ipairs(folder:GetChildren()) do
					if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj.Name == exactName then return obj end
				end
				return nil
			end
			return scan(workspace:FindFirstChild("NPCs")) or scan(workspace:FindFirstChild("Map")) or scan(workspace:FindFirstChild("Characters")) or scan(workspace)
		end

		function Q.pickDialogueOption()
			local D = Q.dialogue
			if not D or not D.Active then return false end
			local dl = D.getActiveDialogue()
			local page = dl and dl:getCurrent()
			local options = page and page._options
			if not options or #options == 0 then return false end
			local best = nil
			for _, opt in ipairs(options) do
				if not opt._isCancel and not opt._locked then
					local txt = ""
					pcall(function()
						if type(opt._text) == "string" then txt = opt._text end
						if opt._label and type(opt._label) == "string" then txt = txt .. " " .. opt._label end
					end)
					txt = txt:lower()
					for _, key in ipairs({"accept", "yes", "i'll", "complete", "turn", "ok", "sure", "deal", "start"}) do
						if txt:find(key, 1, true) then best = opt; break end
					end
					if best then break end
				end
			end
			if not best then
				for _, opt in ipairs(options) do
					if not opt._isCancel and not opt._locked then best = opt; break end
				end
			end
			if best then pcall(function() D.select(best) end); return true end
			return false
		end

		function Q.acceptDialog()
			local D, NM = Q.dialogue, Q.npcManager
			if not NM or not D then return false end
			local giver = Q.findGiver()
			if not giver then return false end
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local npcPart = giver:FindFirstChild("HumanoidRootPart") or giver:FindFirstChild("Head") or giver.PrimaryPart
			if hrp and npcPart then
				hrp.CFrame = CFrame.new(npcPart.Position + Vector3.new(4, 0, 4))
				task.wait(0.4)
			end
			pcall(function() if D.Active then D.close() end end)
			task.wait(0.2)
			local instances = NM.getNPCsByName(giver.Name)
			if not instances or #instances == 0 then return false end
			task.spawn(function() pcall(function() NM.startDialogue(instances[1], nil) end) end)
			for _ = 1, 30 do
				task.wait(0.1)
				if D.Active then break end
			end
			if not D.Active then return false end
			task.wait(0.6)
			for _ = 1, 4 do
				if not D.Active then break end
				if not Q.pickDialogueOption() then pcall(function() D.advance() end) end
				task.wait(0.7)
			end
			task.wait(0.3)
			pcall(function() if D.Active then D.close() end end)
			task.wait(0.2)
			return true
		end

		function Q.acceptQuest()
			if Q.method == 1 then return Q.acceptDirect() end
			return Q.acceptDialog()
		end

		function Q.completeQuest()
			for _, cmd in ipairs({"CompleteQuest", "FinishQuest", "TurnInQuest"}) do
				pcall(function() Q.commF:InvokeServer(cmd) end)
				task.wait(0.15)
			end
		end

		function Q.clearCompletedFlag()
			local qc = Q.questController and Q.questController.QuestsCompleted
			if qc and qc[Q.questCat] then qc[Q.questCat][Q.questName] = false end
		end

		function Q.isComplete()
			if tick() - Q.acceptedAt < 4 then return false end
			return Q.completed
		end

		function Q.questEnemies()
			local list = {}
			local folder = workspace:FindFirstChild("Enemies")
			if not folder then return list end
			for _, obj in ipairs(folder:GetChildren()) do
				if obj:IsA("Model") then
					local hum = obj:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 and (not Q.taskType or obj.Name:lower():find(Q.taskType:lower(), 1, true)) then
						local part = obj:FindFirstChild("Head") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("HumanoidRootPart")
						if part then table.insert(list, {model = obj, part = part, hum = hum}) end
					end
				end
			end
			return list
		end

		-- Procura inimigos sem ficar parado: vai até o spawn da missão, se achar; senão vagueia
		function Q.findSpawn(hrp)
			if tick() - (Q.spawnCheckAt or 0) < 3 then return Q.spawnPart end
			Q.spawnCheckAt = tick()
			Q.spawnPart = nil
			pcall(function()
				local origin = workspace:FindFirstChild("_WorldOrigin")
				local folder = origin and origin:FindFirstChild("EnemySpawns")
				if not folder or not Q.taskType then return end
				local key = Q.taskType:lower()
				local bestD = math.huge
				for _, obj in ipairs(folder:GetChildren()) do
					if obj.Name:lower():find(key, 1, true) then
						local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
						if part then
							local d = (part.Position - hrp.Position).Magnitude
							if d < bestD then bestD = d; Q.spawnPart = part end
						end
					end
				end
			end)
			return Q.spawnPart
		end

		function Q.searchMove()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			local spawn = Q.findSpawn(hrp)
			if spawn and spawn.Parent then
				local offset = (spawn.Position + Vector3.new(0, Q.hoverHeight + 4, 0)) - hrp.Position
				if offset.Magnitude > 12 then
					Q.fly(hrp, offset.Unit * Q.flySpeed)
					return
				end
			end
			-- vagueia: troca de direção a cada 2s
			if tick() - Q.wanderAt > 2 then
				Q.wanderAt = tick()
				Q.wanderAngle = math.random() * math.pi * 2
			end
			Q.fly(hrp, Vector3.new(math.cos(Q.wanderAngle), 0, math.sin(Q.wanderAngle)) * Q.flySpeed)
		end

		-- Segura o boneco parado no lugar (zera a velocidade; o BodyVelocity evita cair com o noclip)
		function Q.hold()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			Q.fly(hrp, Vector3.zero)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end

		function Q.step()
			local phase = Q.phase
			if phase == "accepting" then
				Q.updateStatus("📜 " .. tostring(Q.questName) .. "\nAceitando (" .. (Q.method == 1 and "direto" or "diálogo") .. ")...", Color3.fromRGB(255, 200, 100))
				if Q.weapon ~= "Any" then Q.ensureWeapon() end
				Q.acceptQuest()
				Q.acceptedAt = tick()
				Q.noEnemySince = 0
				Q.searchSince = 0
				Q.completed = false
				Q.clearCompletedFlag()
				Q.phase = "flying"
				Q.enableNoclip()
				Q.updateStatus("🕊️ Voando...", Color3.fromRGB(150, 200, 255))

			elseif phase == "flying" then
				local enemies = Q.questEnemies()
				if #enemies == 0 then
					if Q.isComplete() then
						Q.phase = "returning"
						Q.disableNoclip()
						Q.updateStatus("🏃 Quest completa!\nEntregando...", Color3.fromRGB(100, 200, 255))
					else
						if Q.searchSince == 0 then Q.searchSince = tick() end
						local searched = tick() - Q.searchSince
						if searched > 10 then
							-- não achou ninguém em 10s: pega a missão anterior a esta
							local prev = Q.pickBest(Q.curLevelReq)
							Q.searchSince = 0
							if prev then
								local current = Q.pickBest()
								Q.fallback = {bestReq = current and current.levelReq or Q.curLevelReq}
								Q.questCat, Q.questName = prev.category, prev.questName
								Q.taskType, Q.questIndex, Q.curLevelReq = prev.taskType, prev.index, prev.levelReq
								Q.stopFly()
								Q.phase = "accepting"
								Q.updateStatus("↩️ Sem inimigos em 10s\nIndo para: " .. tostring(Q.questName), Color3.fromRGB(255, 200, 120))
								Q.updateLevelInfo()
								return
							end
						end
						Q.updateStatus("🔍 " .. tostring(Q.questName) .. "\nProcurando inimigos... " .. math.floor(searched) .. "s", Color3.fromRGB(200, 200, 100))
						Q.searchMove()
					end
				else
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if not hrp then return end
					Q.searchSince = 0
					local nearest, nd = nil, math.huge
					for _, e in ipairs(enemies) do
						local d = (e.part.Position - hrp.Position).Magnitude
						if d < nd then nd = d; nearest = e end
					end
					Q.updateStatus("🕊️ Voando até " .. tostring(Q.taskType or "?") .. "\nDist: " .. math.floor(nd), Color3.fromRGB(150, 200, 255))
					if nd <= Q.hoverHeight + 4 then
						Q.stopFly()
						Q.phase = "farming"
						Q.updateStatus("⚔️ Atacando...", Color3.fromRGB(255, 100, 200))
					else
						Q.fly(hrp, (nearest.part.Position - hrp.Position).Unit * Q.flySpeed)
					end
				end

			elseif phase == "farming" then
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then return end
				local enemies = Q.questEnemies()

				if Q.isComplete() then
					Q.stopFly()
					Q.updateStatus("✅ Completa!\nCompletando...", Color3.fromRGB(100, 255, 100))
					Q.completeQuest()
					task.wait(0.8)
					Q.fallback = nil
					Q.updateSelection()
					Q.updateStatus("🔄 Reaceitando...", Color3.fromRGB(180, 255, 200))
					Q.acceptQuest()
					Q.completed = false
					Q.noEnemySince = 0
					Q.acceptedAt = tick()
					Q.clearCompletedFlag()
					Q.enableNoclip()
					Q.phase = "flying"
					Q.updateStatus("🕊️ Voando de novo...", Color3.fromRGB(150, 200, 255))
					return
				end

				if #enemies == 0 then
					if Q.noEnemySince == 0 then Q.noEnemySince = tick() end
					local waited = tick() - Q.noEnemySince
					if waited > 15 then
						Q.updateStatus("🔍 Procurando\noutro canto...", Color3.fromRGB(200, 180, 100))
						Q.phase = "flying"
						Q.noEnemySince = 0
						return
					end
					Q.hold()
					Q.updateStatus("⏳ " .. tostring(Q.questName) .. "\nRespawn " .. math.floor(waited) .. "s...", Color3.fromRGB(200, 200, 100))
					task.wait(0.3)
					return
				end

				if Q.weapon ~= "Any" then Q.ensureWeapon() end
				Q.noEnemySince = 0
				local nearest, nd = nil, math.huge
				for _, e in ipairs(enemies) do
					local d = (e.part.Position - hrp.Position).Magnitude
					if d < nd then nd = d; nearest = e end
				end
				if nearest then
					local offset = (nearest.part.Position + Vector3.new(0, Q.hoverHeight, 0)) - hrp.Position
					if offset.Magnitude > 2 then
						Q.fly(hrp, offset.Unit * math.min(Q.flySpeed, offset.Magnitude * 5))
					elseif Q.bv then
						Q.bv.Velocity = Vector3.zero
					end
					for _, e in ipairs(enemies) do
						if e.hum and e.hum.Health > 0 and (e.part.Position - hrp.Position).Magnitude <= Q.aoeRange then
							pcall(function() e.hum:MoveTo(hrp.Position) end)
						end
					end
					Q.aoeHit()
					Q.updateStatus("⚔️ " .. tostring(Q.questName) .. "\n" .. #enemies .. " " .. tostring(Q.taskType or "?") .. " | #" .. Q.questIndex, Color3.fromRGB(255, 150, 100))
				end

			elseif phase == "returning" then
				Q.stopFly()
				Q.updateStatus("🏃 Entregando...", Color3.fromRGB(100, 200, 255))
				Q.completeQuest()
				task.wait(1)
				Q.fallback = nil
				Q.updateSelection()
				Q.completed = false
				Q.acceptedAt = 0
				Q.noEnemySince = 0
				Q.clearCompletedFlag()
				Q.phase = "accepting"
			end
		end

		function Q.start()
			if not Q.init() then
				Q.updateStatus("❌ Módulos não encontrados\n(veja o F9)", Color3.fromRGB(255, 120, 120))
				return
			end
			Q.stop()
			Q.enabled = true
			Q.fallback = nil
			Q.searchSince = 0
			Q.updateSelection()
			Q.completed = false
			Q.phase = "accepting"
			Q.acceptedAt = 0
			Q.noEnemySince = 0
			Q.updateLevelInfo()
			Q.conn = RunService.Heartbeat:Connect(function()
				if not screenGui.Parent then Q.stop() return end
				if not Q.enabled or Q.busy then return end
				Q.busy = true -- evita rodar duas etapas ao mesmo tempo (várias têm task.wait)
				local ok, err = pcall(Q.step)
				if not ok then warn("[Aetheris] Auto Farm Level:", err) end
				Q.busy = false
			end)
			task.spawn(function()
				while Q.enabled and screenGui.Parent do
					task.wait(2)
					if Q.enabled then
						Q.updateLevelInfo()
						local oldCat = Q.questCat
						Q.updateSelection()
						if oldCat ~= Q.questCat then
							Q.updateStatus("🆙 Level up! " .. tostring(Q.questName), Color3.fromRGB(150, 255, 200))
							Q.updateLevelInfo()
							Q.stopFly()
							Q.disableNoclip()
							Q.phase = "accepting"
						end
					end
				end
			end)
		end

		function Q.stop()
			Q.enabled = false
			if Q.conn then Q.conn:Disconnect(); Q.conn = nil end
			Q.stopFly()
			Q.disableNoclip()
			Q.phase = "idle"
			Q.busy = false
		end

		function Q.debug()
			print("=== 🔍 DEBUG Auto Farm Level ===")
