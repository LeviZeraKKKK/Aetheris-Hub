-- SISTEMA DE ESP DE INIMIGOS (NPC)
-----------------------------------------------------------------
local enemyObjects = {}
local ENEMIES = workspace:WaitForChild("Enemies", 5)

local function getEnemyRoot(model)
	if not model:IsA("Model") then return nil end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Head")
	if root and root:IsA("BasePart") then return root end
	return nil
end

local function makeEnemyText(parent, name, size, position, fontSize)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.25
	label.Font = currentGlobalFont
	label.TextSize = fontSize
	label.TextWrapped = false
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = parent
	return label
end

local function createEnemyESP(enemy)
	if enemyObjects[enemy] then return end
	local root = getEnemyRoot(enemy)
	if not root then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "EnemyHighlight"
	highlight.Adornee = enemy
	highlight.FillColor = _G_ColorEnemyChams
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.82
	highlight.OutlineTransparency = 0
	highlight.Enabled = false
	highlight.Parent = screenGui

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EnemyInfo"
	billboard.Adornee = root
	billboard.Size = UDim2.fromOffset(170, 36)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Enabled = false
	billboard.Parent = screenGui

	local nameLabel = makeEnemyText(billboard, "EnemyName", UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 0), 12)
	nameLabel.TextColor3 = _G_ColorEnemyName
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center

	local distanceLabel = makeEnemyText(billboard, "EnemyDistance", UDim2.new(1, 0, 0, 15), UDim2.fromOffset(0, 18), 10)
	distanceLabel.TextColor3 = _G_ColorEnemyDist
	distanceLabel.TextXAlignment = Enum.TextXAlignment.Center

	enemyObjects[enemy] = {
		highlight = highlight,
		billboard = billboard,
		nameLabel = nameLabel,
		distanceLabel = distanceLabel,
	}
end

local function removeEnemyESP(enemy)
	local data = enemyObjects[enemy]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	if data.billboard then data.billboard:Destroy() end
	enemyObjects[enemy] = nil
end

task.spawn(function()
	if not ENEMIES then return end
	while true do
		task.wait(1)
		if _G_EnemyEspMaster then
			local found = {}
			for _, obj in ipairs(ENEMIES:GetDescendants()) do
				if obj:IsA("Model") then
					local hum = obj:FindFirstChildOfClass("Humanoid")
					if hum and getEnemyRoot(obj) then
						found[obj] = true
						if not enemyObjects[obj] then
							createEnemyESP(obj)
						end
					end
				end
			end
			for enemy in pairs(enemyObjects) do
				if not found[enemy] or not enemy.Parent then
					removeEnemyESP(enemy)
				end
			end
		else
			for enemy in pairs(enemyObjects) do
				removeEnemyESP(enemy)
			end
		end
	end
end)

