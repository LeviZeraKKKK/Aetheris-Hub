			-- move as seções favoritas para a aba (e devolve as desmarcadas ao lugar de origem)
			local function layoutView()
				local favs = {}
				for _, e in ipairs(F.entries) do
					if e.fav then table.insert(favs, e) end
				end
				table.sort(favs, function(a, b) return a.section.LayoutOrder < b.section.LayoutOrder end)
				for i, e in ipairs(favs) do
					local target = (i % 2 == 1) and leftCol or rightCol
					if e.section.Parent ~= target then e.section.Parent = target end
					e.section.Visible = true
					-- garante altura: seção de página nunca visitada pode ter ficado com altura 0
					if e.section.Size.Y.Offset < 30 then
						for _, c in ipairs(e.section:GetChildren()) do
							local lay = c:IsA("Frame") and c:FindFirstChildOfClass("UIListLayout")
							if lay then
								e.section.Size = UDim2.new(e.section.Size.X.Scale, e.section.Size.X.Offset, 0, AetherisLayoutHeight(lay) + 34)
								break
							end
						end
					end
				end
				for _, e in ipairs(F.entries) do
					if not e.fav and e.section.Parent ~= e.origin then e.section.Parent = e.origin end
				end
				hint.Visible = (#favs == 0)
				clearBtn.Visible = (#favs > 0)
				local en = AetherisI18n and AetherisI18n.lang == "en"
				if #favs == 0 then
					favSub.Text = en and "Nothing pinned yet" or "Nada fixado ainda"
				elseif #favs == 1 then
					favSub.Text = "1" .. (en and " section pinned" or " seção fixada")
				else
					favSub.Text = #favs .. (en and " sections pinned" or " seções fixadas")
				end
				for _, e in ipairs(F.entries) do setChip(e, e.fav) end
			end
