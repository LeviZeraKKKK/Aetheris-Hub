	floatLetterStroke.Thickness = 0.7
	floatLetterStroke.Parent = floatLetter
	table.insert(themeSections, floatLetterStroke)

	-- Halo pulsante sutil ao redor do ícone.
	local floatGlow = Instance.new("UIStroke")
	floatGlow.Name = "SoftGlow"
	floatGlow.Color = currentThemeColor
	floatGlow.Thickness = 4
	floatGlow.Transparency = 0.78
	floatGlow.Parent = floatingBtn
	table.insert(themeSections, floatGlow)

	-- Pequenas partículas luminosas que orbitam dentro do botão.
	local floatParticles = {}
	for i = 1, 4 do
		local particle = Instance.new("Frame")
		particle.Name = "ThemeParticle"
		particle.Size = UDim2.new(0, 3, 0, 3)
		particle.Position = UDim2.new(0.5, math.cos(i * math.pi / 2) * 13 - 1.5, 0.5, math.sin(i * math.pi / 2) * 13 - 1.5)
		particle.BackgroundColor3 = currentThemeColor
		particle.BackgroundTransparency = 0.22
		particle.BorderSizePixel = 0
		particle.ZIndex = 22
		particle.Parent = floatingBtn
		local particleCorner = Instance.new("UICorner")
		particleCorner.CornerRadius = UDim.new(1, 0)
		particleCorner.Parent = particle
		table.insert(themeParticles, particle)
		table.insert(floatParticles, particle)
	end

	task.spawn(function()
		local glowTween = TweenService:Create(floatGlow, TweenInfo.new(1.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
			Transparency = 0.48, Thickness = 5
		})
		glowTween:Play()
		local angle = 0
		while floatingBtn.Parent do
			angle += 0.035
			for index, particle in ipairs(floatParticles) do
				if particle.Parent then
					local a = angle + (index - 1) * math.pi / 2
					particle.Position = UDim2.new(0.5, math.cos(a) * 13 - 1.5, 0.5, math.sin(a) * 13 - 1.5)
				end
			end
			task.wait(0.03)
		end
	end)

	local floatDragging, floatDragStart, floatStartPos
	floatingBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			floatDragging = true
			floatDragStart = input.Position
			floatStartPos = floatingBtn.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then floatDragging = false end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if floatDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - floatDragStart
			floatingBtn.Position = UDim2.new(
				floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X,
				floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y
			)
		end
	end)

	local dragging, dragStart, startPos
	local function startDragging(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainPanel.Position
			interactionBlocker.Visible = true
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					interactionBlocker.Visible = false
				end
			end)
		end
	end

	dragBar.InputBegan:Connect(startDragging)

	local topBar = Instance.new("Frame")
	topBar.Size = UDim2.new(1, -80, 0, 40)
	topBar.BackgroundTransparency = 1
	topBar.Parent = mainPanel
	topBar.InputBegan:Connect(startDragging)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			mainPanel.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	local function createResizeSymbol(parent, pos)
		local symbolFrame = Instance.new("Frame")
		symbolFrame.Size = UDim2.new(0, 14, 0, 14)
		symbolFrame.Position = pos
		symbolFrame.BackgroundTransparency = 1
		symbolFrame.Parent = parent

		local line1 = Instance.new("Frame")
		line1.Size = UDim2.new(0, 10, 0, 2)
		line1.Position = UDim2.new(0, 2, 0, 3)
		line1.BackgroundColor3 = currentThemeColor
		line1.BorderSizePixel = 0
		line1.Parent = symbolFrame
		table.insert(resizeSymbolsLines, line1)

		local c1 = Instance.new("UICorner")
		c1.CornerRadius = UDim.new(1, 0)
		c1.Parent = line1

		local line2 = Instance.new("Frame")
		line2.Size = UDim2.new(0, 6, 0, 2)
		line2.Position = UDim2.new(0, 6, 0, 8)
		line2.BackgroundColor3 = currentThemeColor
		line2.BorderSizePixel = 0
		line2.Parent = symbolFrame
		table.insert(resizeSymbolsLines, line2)

		local c2 = Instance.new("UICorner")
		c2.CornerRadius = UDim.new(1, 0)
		c2.Parent = line2

		return symbolFrame
	end

	local resizeHandle = Instance.new("TextButton")
	resizeHandle.Size = UDim2.new(0, 20, 0, 20)
	resizeHandle.Position = UDim2.new(1, -20, 1, -20)
	resizeHandle.BackgroundTransparency = 1
	resizeHandle.Text = ""
	resizeHandle.ZIndex = 50
	resizeHandle.Parent = mainPanel
	createResizeSymbol(resizeHandle, UDim2.new(0, 3, 0, 3))

	local resizing, resizeStart, startSize
	resizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
