		local panelToken = 0
		local function closeFogPanel()
			if not panel.Visible then return end
			panelToken = panelToken + 1
			local token = panelToken
			TweenService:Create(settingsButton, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Rotation = 0}):Play()
			TweenService:Create(panelScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.88}):Play()
			task.delay(0.16, function()
				if token == panelToken then panel.Visible = false end
			end)
		end
		local function openFogPanel()
			panelToken = panelToken + 1
			local token = panelToken
			panelScale.Scale = 1
			panel.Visible = true
			positionFogPanel()
			refreshList()
			updateFogStatus()
			panelScale.Scale = 0.85
			TweenService:Create(panelScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
			TweenService:Create(settingsButton, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Rotation = 90}):Play()
			-- brilho pulsante na borda + faixa de luz na linha do título
			task.spawn(function()
				while token == panelToken and panel.Visible and screenGui.Parent do
					TweenService:Create(panelStroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine), {Transparency = 0.6}):Play()
					accentSweep.Position = UDim2.new(-0.25, 0, 0, 0)
					TweenService:Create(accentSweep, TweenInfo.new(1.4, Enum.EasingStyle.Sine), {Position = UDim2.new(1, 0, 0, 0)}):Play()
					task.wait(0.9)
					if token ~= panelToken then break end
					TweenService:Create(panelStroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine), {Transparency = 0.15}):Play()
					task.wait(0.9)
				end
				panelStroke.Transparency = 0.25
			end)
		end
		settingsButton.MouseButton1Click:Connect(function()
			if panel.Visible and panelScale.Scale > 0.95 then closeFogPanel() else openFogPanel() end
		end)
