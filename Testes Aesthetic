			{loadBarBg, {BackgroundTransparency = 1}},
			{loadBarFill, {BackgroundTransparency = 1}},
			{shimmer, {BackgroundTransparency = 1}},
			{loadAccent, {BackgroundTransparency = 1}},
			{backdrop, {BackgroundTransparency = 1}},
		}
		for _, fade in ipairs(fades) do
			TweenService:Create(fade[1], fadeOut, fade[2]):Play()
		end
		for _, particle in ipairs(loadingParticles) do
			if particle.Parent then TweenService:Create(particle, fadeOut, {BackgroundTransparency = 1}):Play() end
		end
		if blur then TweenService:Create(blur, fadeOut, {Size = 0}):Play() end
		task.wait(0.36)
		loadWrapper:Destroy()
		backdrop:Destroy()
		if blur then blur:Destroy() end
		if screenGui.Parent then showMainPanel() end
	end)
end

