				while fruitRollState.Auto and autoRollGeneration == thisGeneration do
					local succeeded = performFruitRoll()
					local waitDuration = succeeded and fruitRollState.Delay or math.max(fruitRollState.Delay, 10)
					local endTime = os.clock() + waitDuration
					repeat
						task.wait(0.1)
					until os.clock() >= endTime or not fruitRollState.Auto or autoRollGeneration ~= thisGeneration
				end
			end)
		end
