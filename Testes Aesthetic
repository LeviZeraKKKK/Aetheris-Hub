-----------------------------------------------------------------
-- LOOP DE RENDERIZAÇÃO DO ESP DE BERRIES (COR POR ATRIBUTO + DISTÂNCIA)
-----------------------------------------------------------------
task.spawn(function()
	while screenGui.Parent do
		task.wait(0.5)
		if _G_BerryEspEnabled then
			local mapFolder = workspace:FindFirstChild("Map")
			if mapFolder then
				local currentFound = {}

				for _, child in ipairs(mapFolder:GetDescendants()) do
					if string.sub(child.Name, 1, 1) == "{" then
						local berriesChild = child:FindFirstChild("Berries")
						
						if berriesChild then
							local attributes = berriesChild:GetAttributes()
							
							for _, attrValue in pairs(attributes) do
								currentFound[child] = true
								local textValue = tostring(attrValue)
								local assignedColor = getBerryColorFromName(textValue)
								
								if not activeAttributeEspItems[child] then
									local partForAdornee = child:IsA("BasePart") and child or (child:IsA("Model") and (child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)))
									
									if partForAdornee then
										local billboard = Instance.new("BillboardGui")
										billboard.Name = "BerryFullEspBillboard"
										billboard.Adornee = partForAdornee
										billboard.Size = UDim2.new(0, 120, 0, 50)
										billboard.StudsOffset = Vector3.new(0, 2.5, 0)
										billboard.AlwaysOnTop = true
										billboard.Parent = screenGui

										local nameLabel = Instance.new("TextLabel")
										nameLabel.Name = "NameLabel"
										nameLabel.Size = UDim2.new(1, 0, 0, 24)
										nameLabel.BackgroundTransparency = 1
										nameLabel.Font = Enum.Font.GothamBold
										nameLabel.Text = textValue
										nameLabel.TextColor3 = assignedColor
										nameLabel.TextSize = 12
										nameLabel.TextStrokeTransparency = 0.2
										nameLabel.Parent = billboard

										local distLabel = Instance.new("TextLabel")
										distLabel.Name = "DistLabel"
										distLabel.Size = UDim2.new(1, 0, 0, 20)
										distLabel.Position = UDim2.new(0, 0, 0, 24)
										distLabel.BackgroundTransparency = 1
										distLabel.Font = Enum.Font.GothamMedium
										distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
										distLabel.TextSize = 10
										distLabel.TextStrokeTransparency = 0.2
										distLabel.Parent = billboard

										activeAttributeEspItems[child] = {
											billboard = billboard,
											part = partForAdornee,
											distLabel = distLabel,
											nameLabel = nameLabel
										}
									end
								else
									local itemData = activeAttributeEspItems[child]
									if itemData and itemData.nameLabel then
										itemData.nameLabel.Text = textValue
										itemData.nameLabel.TextColor3 = assignedColor
									end
								end
								break
							end
						end
					end
				end

				for parentObj, itemData in pairs(activeAttributeEspItems) do
					if not currentFound[parentObj] or not parentObj.Parent then
						if itemData.billboard and itemData.billboard.Parent then
							itemData.billboard:Destroy()
						end
						activeAttributeEspItems[parentObj] = nil
					end
				end
			end
		end

		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			for _, itemData in pairs(activeAttributeEspItems) do
				if itemData.part and itemData.part.Parent and itemData.distLabel then
					itemData.distLabel.Visible = _G_BerryDistanceEnabled
					if _G_BerryDistanceEnabled then
						local dist = math.floor((itemData.part.Position - root.Position).Magnitude)
						itemData.distLabel.Text = "[" .. dist .. " studs]"
					end
				end
			end
		end
	end
end)
