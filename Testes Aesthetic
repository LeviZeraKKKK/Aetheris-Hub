	local fruitAccumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		if not fruitEspMasterEnabled then return end
		fruitAccumulator += dt
		if fruitAccumulator < fruitConfig.TickInterval then return end
		fruitAccumulator = 0

		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root or not root.Parent then return end

		local rootPos    = root.Position
		local maxDistSq  = fruitConfig.MaxDistance  * fruitConfig.MaxDistance
		local cullDistSq = fruitConfig.CullDistance * fruitConfig.CullDistance

		local nameV  = fruitEnabledOptions.Name
		local distV  = fruitEnabledOptions.Distance
		local chamsV = fruitEnabledOptions.Chams

		for i = #fruitList, 1, -1 do
			local tool = fruitList[i]
			local data = fruitEspObjects[tool]

			if not data or not tool.Parent then
				if data then removeFruitESP(tool) end
				continue
			end

			local handle = data.handle
			if not handle or not handle.Parent then
				removeFruitESP(tool)
				continue
			end

			if tool.Parent ~= data.lastParent then
				data.lastParent = tool.Parent
				setFruitHeldState(data, isHeldByPlayer(tool))
			end

			local pos = handle.Position
			local dx = pos.X - rootPos.X
			local dy = pos.Y - rootPos.Y
			local dz = pos.Z - rootPos.Z
			local distSq = dx*dx + dy*dy + dz*dz

			if distSq > cullDistSq then
				if data.highlight.Enabled then data.highlight.Enabled = false end
				if data.billboard.Enabled then data.billboard.Enabled = false end
				continue
			end

			local inRange = distSq <= maxDistSq
			local wantHL = chamsV and inRange
			if data.highlight.Enabled ~= wantHL then data.highlight.Enabled = wantHL end

			local wantBB = inRange and (data.isHeld or nameV or distV)
			if data.billboard.Enabled ~= wantBB then data.billboard.Enabled = wantBB end

			if wantBB then
				local nTxt, dTxt
				if data.isHeld then
					nTxt = fruitConfig.HeldText
					dTxt = ""
				else
					nTxt = nameV and tool.Name or ""
					dTxt = distV and string.format("%.0f studs", math.sqrt(distSq)) or ""
				end

				local newText = nTxt .. "\n" .. dTxt
				if data.lastText ~= newText then
					data.lastText = newText
					data.label.Text = nTxt
					data.label.Visible = nTxt ~= ""
					data.distLabel.Text = dTxt
					data.distLabel.Visible = dTxt ~= ""
					-- Só a distância: sobe para o meio do quadro; com o nome, fica na segunda linha.
					data.distLabel.Position = UDim2.fromOffset(0, nTxt ~= "" and 19 or 11)
				end
			end
		end
	end)

