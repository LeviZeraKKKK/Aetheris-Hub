			function F.closeView()
				if not F.viewOpen then return end
				F.viewOpen = false
				for _, e in ipairs(F.entries) do
					if e.section.Parent ~= e.origin then e.section.Parent = e.origin end
					setChip(e, false)
				end
				favPage.Visible = false
				-- se a aba clicada já era a ativa, ela não se reabre sozinha: reabre aqui
