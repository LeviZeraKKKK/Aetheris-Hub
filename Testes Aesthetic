	local function refreshIslands()
		local oldName = selectedIsland and selectedIsland.Name
		islands = {}

		for _, object in ipairs(map:GetChildren()) do
			if object:IsA("Model") then
				table.insert(islands, object)
			end
		end

		table.sort(islands, function(a, b)
			return a.Name:lower() < b.Name:lower()
		end)

		islandIndex = 1
		if oldName then
			for i, island in ipairs(islands) do
				if island.Name == oldName then
					islandIndex = i
					break
				end
			end
		end

		selectedIsland = islands[islandIndex]
	end
	refreshIslands()

