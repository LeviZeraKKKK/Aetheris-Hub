		function K.handleAction(actionName, inputState, input)
			local om, char, hum = K.om, K.char, K.humanoid
			if not om or not char or not hum then return end
			if not om.active and char:FindFirstChild("KenDisabled") then return end
			if inputState ~= Enum.UserInputState.Begin then return end
			if input and input.UserInputState ~= Enum.UserInputState.Begin then return end
			if hum.Health <= 0 or tick() - K.n1 <= 0.4 then return end
			K.n1 = tick()
			om.radius = 0
			om:setActive(not om.active)
			K.commE:FireServer("Ken", om.active)
