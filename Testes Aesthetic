	-- Entrada em cascata: cada elemento sobe 8px enquanto aparece, com pequeno atraso entre eles.
	local function reveal(obj, delay, goal)
		local finalPosition = obj.Position
		obj.Position = finalPosition + UDim2.new(0, 0, 0, 8)
		goal.Position = finalPosition
		TweenService:Create(obj, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay), goal):Play()
