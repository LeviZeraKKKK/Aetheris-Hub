function FVX.playRows(col)
    for i, entry in ipairs(col.pool) do
        if entry.row.Visible then
            local targetY = (i - 1) * ROW_STEP
            entry.row.Position = UDim2.new(0, 18, 0, targetY)
            entry.row.BackgroundTransparency = 1
            entry.name.TextTransparency = 1
            entry.price.TextTransparency = 1
            entry.pill.BackgroundTransparency = 1
            task.delay((i - 1) * 0.035, function()
                if not entry.row.Parent then return end
                TweenService:Create(entry.row, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(0, 2, 0, targetY), BackgroundTransparency = 0}):Play()
                TweenService:Create(entry.name, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
                TweenService:Create(entry.price, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
                TweenService:Create(entry.pill, TweenInfo.new(0.3), {BackgroundTransparency = 0.86}):Play()
            end)
        end
    end
end

