local configBindings = {}
local configBindingCounts = {}
local function registerConfigBinding(parent, name, getter, setter)
    local section = parent and parent.Parent or nil
    local sectionTitle = "Geral"
    if section then
        for _, child in ipairs(section:GetChildren()) do
            if child:IsA("TextLabel") then
                sectionTitle = (AetherisI18n and AetherisI18n.orig[child]) or child.Text
                break
            end
        end
    end
	local page = section and section.Parent or nil
	local pageName = page and page.Name or "Page"
	-- Seções movidas para as abas Automático e Mundo: mantenha as chaves antigas dos presets.
	if pageName == "Auto" then
		pageName = "Player"
	elseif pageName == "Mundo" then
		pageName = (sectionTitle == "Visual do Mapa") and "Visual" or "Player"
	end
	-- O título visível mudou para Baú; mantenha as chaves antigas dos presets.
	if pageName == "Farming" and sectionTitle == "Baú" then
		sectionTitle = "Automação"
	end
	-- A seção "Design" juntou "Tema do Hub" e "Customização de Textos": mantenha as chaves antigas dos presets.
	if pageName == "Config" and sectionTitle == "Design" then
		sectionTitle = (name == "Fonte do Hub") and "Customização de Textos" or "Tema do Hub"
	end
	local baseKey = pageName .. "|" .. sectionTitle .. "|" .. name
    configBindingCounts[baseKey] = (configBindingCounts[baseKey] or 0) + 1
    local key = baseKey
    if configBindingCounts[baseKey] > 1 then
        key = baseKey .. " #" .. tostring(configBindingCounts[baseKey])
    end
    table.insert(configBindings, {key = key, getter = getter, setter = setter})
    return key
end

