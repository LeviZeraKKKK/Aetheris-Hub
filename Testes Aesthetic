	local frameConn
	frameConn = RunService.RenderStepped:Connect(function(dt)
		if not loadWrapper.Parent then
			frameConn:Disconnect()
			return
		end
		ringGradient.Rotation = (ringGradient.Rotation + dt * 270) % 360
		percentLabel.Text = string.format("%d%%", math.floor(loadBarFill.Size.X.Scale * 100 + 0.5))
	end)

	-- Texto de status com pontinhos animados e troca suave entre as etapas.
	local statusBase = "Iniciando"
	local statusAnimated = true
	task.spawn(function()
		local dots = 0
		while loadWrapper.Parent do
			if statusAnimated then
				dots = (dots % 3) + 1
				loadStatus.Text = statusBase .. string.rep(".", dots)
			else
				loadStatus.Text = statusBase
			end
			task.wait(0.28)
		end
	end)

	local function setStatus(base, animated)
		TweenService:Create(loadStatus, TweenInfo.new(0.1), {TextTransparency = 1}):Play()
		task.wait(0.1)
		statusBase = base
		statusAnimated = animated
		loadStatus.Text = animated and (base .. "...") or base
		TweenService:Create(loadStatus, TweenInfo.new(0.14), {TextTransparency = 0}):Play()
	end

	task.spawn(function()
		local steps = {
			{progress = 0.20, text = "Carregando recursos", animated = true},
			{progress = 0.40, text = "Preparando componentes", animated = true},
