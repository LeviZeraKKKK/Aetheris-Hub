		local function restoreLayer(layer)
			local saved = fog.detached[layer]
			if not saved then return end
			local restored = pcall(function() layer.Parent = saved.parent end)
			if restored then fog.detached[layer] = nil end
		end
		local function applyLayer(layer)
			if fog.enabled and fog.selected[layer] then
				if layer.Parent then
					fog.detached[layer] = {parent = layer.Parent}
					layer.Parent = nil
				end
			else
				restoreLayer(layer)
			end
		end
		local function restoreAll()
			local pending = {}
			for layer in pairs(fog.detached) do table.insert(pending, layer) end
			for _, layer in ipairs(pending) do restoreLayer(layer) end
