	floatingBtnRefs.glowStroke = floatGlowStroke
	floatingBtnRefs.innerStroke = floatInnerStroke
	floatingBtnRefs.ringStroke = floatRingStroke

	-- Spawn de Partículas DENTRO do botão flutuante e espiralando pra fora
	task.spawn(function()
		while floatingBtn and floatingBtn.Parent do
			if not floatingBtn.Visible or floatingBtn.AbsoluteSize.X < 10 then
				task.wait(0.5)
				continue
			end

			for _ = 1, 3 do
				local p = Instance.new("Frame")
				p.Size = UDim2.new(0, 4, 0, 4)
				p.AnchorPoint = Vector2.new(0.5, 0.5)
				p.BackgroundColor3 = currentThemeColor
				p.BackgroundTransparency = 0.1
				p.BorderSizePixel = 0
				p.ZIndex = 105
				p.Parent = floatingBtn
				Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

				local s = Instance.new("UIStroke")
				s.Color = currentThemeColor
				s.Thickness = 1
				s.Transparency = 0.3
				s.Parent = p

				table.insert(floatingBtnRefs.particles, p)

				local angle = math.random() * math.pi * 2
				local startRadius = 0.1
				p.Position = UDim2.new(
					0.5 + math.cos(angle) * startRadius, 0,
					0.5 + math.sin(angle) * startRadius, 0
				)

				local endAngle = angle + (math.random() - 0.5) * math.pi * 2
				local endRadius = 0.8 + math.random() * 0.4

				local tw = TweenService:Create(p, TweenInfo.new(
					math.random(10, 18) / 10,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				), {
					Position = UDim2.new(
						0.5 + math.cos(endAngle) * endRadius, 0,
						0.5 + math.sin(endAngle) * endRadius, 0
					),
					BackgroundTransparency = 1,
					Size = UDim2.new(0, 0, 0, 0),
				})
				tw:Play()
				tw.Completed:Wait()
				p:Destroy()
			end

			task.wait(math.random(2, 5) / 10)
		end
	end)

