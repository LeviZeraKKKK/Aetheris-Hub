	-----------------------------------------------------------------
	-- AIM SILENT GUN (aba Combate)
	-- Ajusta o raio (FOV) e a distância máxima do AimAssist do próprio jogo.
	-- Os valores originais são guardados e devolvidos ao desligar ou ao fechar o hub.
	-----------------------------------------------------------------
	do
		local silentGunEnabled = false
		local silentFovMultiplier = 4.0   -- multiplicador do raio (FOV) padrão do jogo
		local silentDistMultiplier = 2.5  -- multiplicador da distância máxima padrão do jogo

		local aimSettings = nil        -- módulo ReplicatedStorage.Modules.AimAssistSettings
		local aimOriginals = {}        -- [perfil] = {radius = ..., dist = ...}
		local aimBaseFov = 40
		local aimBaseDist = 600
		local aimWarned = false
		local globalStateModule = nil  -- ReplicatedStorage.Global (false = não existe)
		local aimGateOpen = true       -- false = aim assist fechado (o alvo provável é aliado ou não é o foco)
		local lastTouchPosition = nil  -- última posição de toque (mira no celular)
		local guiService = game:GetService("GuiService")

		local function loadAimSettings()
			if aimSettings then return true end
			local ok, result = pcall(function()
				local modules = ReplicatedStorage:FindFirstChild("Modules") or ReplicatedStorage:WaitForChild("Modules", 3)
				local moduleScript = modules and (modules:FindFirstChild("AimAssistSettings") or modules:WaitForChild("AimAssistSettings", 3))
				return moduleScript and require(moduleScript)
			end)
			if ok and type(result) == "table" and type(result.Profiles) == "table" then
				aimSettings = result
				for profileName, profile in pairs(result.Profiles) do
					aimOriginals[profileName] = {radius = profile.AssistRadiusPixels, dist = profile.MaxDistance}
				end
				local defaultProfile = result.Profiles["PC"] or result.Profiles[result.DefaultProfile]
				if defaultProfile then
					aimBaseFov = defaultProfile.AssistRadiusPixels or 40
					aimBaseDist = defaultProfile.MaxDistance or 600
				end
				return true
			end
			return false
		end

		local function applyAimValues()
			if not aimSettings then return end
			-- Com o "portão" fechado o raio cai para 1 pixel, o que na prática desliga o aim assist.
			local radius = aimGateOpen and math.floor(aimBaseFov * silentFovMultiplier) or 1
			local maxDistance = math.floor(aimBaseDist * silentDistMultiplier)
			local ok = pcall(function()
				for _, profile in pairs(aimSettings.Profiles) do
					profile.AssistRadiusPixels = radius
					profile.MaxDistance = maxDistance
				end
			end)
			if not ok and not aimWarned then
				aimWarned = true
				warn("[Aetheris] Não foi possível alterar o AimAssistSettings (tabela protegida).")
			end
		end

		local function restoreAimValues()
			if not aimSettings then return end
			pcall(function()
				for profileName, profile in pairs(aimSettings.Profiles) do
					local original = aimOriginals[profileName]
					if original then
						profile.AssistRadiusPixels = original.radius
						profile.MaxDistance = original.dist
					end
				end
			end)
		end

		-- Ao fechar/recarregar o hub, devolve as configurações originais do jogo.
		screenGui.Destroying:Connect(function()
			silentGunEnabled = false
			restoreAimValues()
		end)

		-- Sincroniza o toque/clique com o wrapper do jogo (usado pelas skills e pelo CombatController).
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then lastTouchPosition = input.Position end
		end)
		UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then lastTouchPosition = input.Position end
			if not silentGunEnabled then return end
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				pcall(function()
					if globalStateModule == nil then
						local ok, result = pcall(function() return require(ReplicatedStorage.Global) end)
						globalStateModule = (ok and type(result) == "table") and result or false
					end
					if globalStateModule then
						globalStateModule.CurrentTouchObjectForMouse = input
					end
				end)
			end
		end)

		-- FOCO / ALIADO: o aim assist do jogo só deve atuar quando o alvo que ele provavelmente
		-- escolheria (o jogador mais perto da mira, dentro do raio e da distância) é permitido.
		-- Aliado = bloqueado. Se houver jogadores em Foco, só eles valem.
		local function getAimPoint()
			if UserInputService:GetLastInputType() == Enum.UserInputType.Touch and lastTouchPosition then
				return Vector2.new(lastTouchPosition.X, lastTouchPosition.Y) + guiService:GetGuiInset()
			end
			if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter and workspace.CurrentCamera then
				return workspace.CurrentCamera.ViewportSize / 2
			end
			return UserInputService:GetMouseLocation()
		end

		-- Lista de foco do Aim Silent Gun: independente da lista do Lock-On.
		local silentFocusTargets = setmetatable({}, {__mode = "k"})

		local function computeAimGate()
			local hasAllies = next(aimAllies) ~= nil
			local hasFocus = false
			for focusedPlayer, selected in pairs(silentFocusTargets) do
				if selected and focusedPlayer.Parent and not aimAllies[focusedPlayer] then
					hasFocus = true
					break
				end
			end
			if not hasAllies and not hasFocus then return true end

			local currentCamera = workspace.CurrentCamera
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not currentCamera or not myRoot then return true end

			local maxDistance = aimBaseDist * silentDistMultiplier
			local radiusPixels = aimBaseFov * silentFovMultiplier
			local aimPoint = getAimPoint()
			local nearestPlayer, nearestPixels = nil, math.huge

			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					local otherChar = other.Character
					local otherRoot = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
					local otherHum = otherChar and otherChar:FindFirstChildOfClass("Humanoid")
					if otherRoot and otherHum and otherHum.Health > 0
						and (otherRoot.Position - myRoot.Position).Magnitude <= maxDistance then
						local screenPos, onScreen = currentCamera:WorldToViewportPoint(otherRoot.Position)
						if onScreen then
							local pixels = (Vector2.new(screenPos.X, screenPos.Y) - aimPoint).Magnitude
							if pixels <= radiusPixels and pixels < nearestPixels then
								nearestPixels = pixels
								nearestPlayer = other
							end
						end
					end
				end
			end

			if not nearestPlayer then return true end
			if aimAllies[nearestPlayer] then return false end
			if hasFocus and not silentFocusTargets[nearestPlayer] then return false end
			return true
		end

		local aimGateConnection
		aimGateConnection = RunService.Heartbeat:Connect(function()
			if not screenGui.Parent then
				aimGateConnection:Disconnect()
				return
			end
			if not silentGunEnabled or not aimSettings then return end
			local open = computeAimGate()
			if open ~= aimGateOpen then
				aimGateOpen = open
				applyAimValues()
			end
		end)

		local secSilentGun = createSection(aimLockPage, "Aim Silent Gun", sectionIcons.SilentGun)

		addToggle(secSilentGun, "Aim Silent Gun", function(state)
			silentGunEnabled = state
			aimGateOpen = true
			task.spawn(function()
