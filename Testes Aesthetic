-- Cores por nome
local function getColorFromName(name)
	local n = string.lower(tostring(name))
	if n:find("green") then return Color3.fromRGB(0, 255, 0)
	elseif n:find("yellow") then return Color3.fromRGB(255, 255, 0)
	elseif n:find("red") then return Color3.fromRGB(255, 0, 0)
	elseif n:find("blue") then return Color3.fromRGB(0, 150, 255)
	elseif n:find("orange") then return Color3.fromRGB(255, 140, 0)
	elseif n:find("purple") then return Color3.fromRGB(180, 50, 255)
	end
	return Color3.fromRGB(255, 255, 255)
end

-- Loop Principal
task.spawn(function()
	while screenGui and screenGui.Parent do
		task.wait(0.3)
		
		if not espNameBerryEnabled then
			task.wait(0.5)
			continue
		end

		local mapFolder = workspace:FindFirstChild("Map")
		if not mapFolder then
			task.wait(0.5)
			continue
		end

		local currentFound = {}
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")

		-- Encontra todas as berries
		for _, descendant in ipairs(mapFolder:GetDescendants()) do
			if descendant:IsA("BasePart") or descendant:IsA("Model") then
				local berriesObj = descendant:FindFirstChild("Berries")
				if berriesObj then
					local attrs = berriesObj:GetAttributes()
					for _, berryName in pairs(attrs) do
						if type(berryName) == "string" and berryName ~= "" then
							currentFound[descendant] = true
							local color = getColorFromName(berryName)

							-- Cria ESP se não existe
							if not activeEspItems[descendant] then
								local adornee = descendant:IsA("BasePart") and descendant 
									or (descendant:IsA("Model") and (descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart", true)))
								
								if adornee then
									local billboard = Instance.new("BillboardGui")
									billboard.Adornee = adornee
									billboard.Size = UDim2.new(0, 140, 0, 50)
									billboard.StudsOffset = Vector3.new(0, 3, 0)
									billboard.AlwaysOnTop = true
									billboard.Parent = screenGui

									local nameLabel = Instance.new("TextLabel")
									nameLabel.Size = UDim2.new(1, 0, 0, 24)
									nameLabel.BackgroundTransparency = 1
									nameLabel.Font = Enum.Font.GothamBold
									nameLabel.Text = berryName
									nameLabel.TextColor3 = color
									nameLabel.TextSize = 12
									nameLabel.TextStrokeTransparency = 0.15
									nameLabel.Parent = billboard

									local distLabel = Instance.new("TextLabel")
									distLabel.Size = UDim2.new(1, 0, 0, 20)
									distLabel.Position = UDim2.new(0, 0, 0, 24)
									distLabel.BackgroundTransparency = 1
									distLabel.Font = Enum.Font.GothamMedium
									distLabel.Text = ""
									distLabel.TextColor3 = Color3.fromRGB(210, 210, 210)
									distLabel.TextSize = 10
									distLabel.TextStrokeTransparency = 0.15
									distLabel.Visible = false
									distLabel.Parent = billboard

									activeEspItems[descendant] = {
										billboard = billboard,
										part = adornee,
										nameLabel = nameLabel,
										distLabel = distLabel
									}
								end
							else
								-- Atualiza nome e cor
								local data = activeEspItems[descendant]
								data.nameLabel.Text = berryName
								data.nameLabel.TextColor3 = color
							end
							break
						end
					end
				end
			end
		end

		-- Remove itens que sumiram
		for obj, data in pairs(activeEspItems) do
			if not currentFound[obj] or not obj:IsDescendantOf(workspace) then
				if data.billboard then data.billboard:Destroy() end
				activeEspItems[obj] = nil
			end
		end

		-- Atualiza distância
		if root then
			for _, data in pairs(activeEspItems) do
				if data.part and data.part.Parent then
					data.distLabel.Visible = espDistanceEnabled
					if espDistanceEnabled then
						local dist = math.floor((data.part.Position - root.Position).Magnitude + 0.5)
						data.distLabel.Text = `Distância: {dist} studs`
					end
				end
			end
		end
	end
end)
