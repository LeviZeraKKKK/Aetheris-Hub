			function Q.acceptDirect(cat, name, idx)
				local commF = Q.commF
				local attempts = {
					function() return commF:InvokeServer("StartQuest", cat, idx) end,
					function() return commF:InvokeServer("StartQuest", cat, name) end,
					function() return commF:InvokeServer("StartQuest", cat) end,
					function() return commF:InvokeServer("AcceptQuest", cat, idx) end,
					function() return commF:InvokeServer("AcceptQuest", cat) end,
				}
				for _, fn in ipairs(attempts) do
					local ok = pcall(fn)
					if ok then return true end
					task.wait(0.1)
				end
				return false
			end

			function Q.takeQuest(rawName)
				if not Q.quests or not Q.commF then return false end
				local name = cleanBossName(rawName)
				local lname, level = name, Q.getLevel()

				local bestCat, bestQ, bestIdx, bestScore = nil, nil, nil, 0
				for catName, entries in pairs(Q.quests) do
					if type(entries) == "table" then
						for idx, q in ipairs(entries) do
							if type(q) == "table" and type(q.LevelReq) == "number" and q.LevelReq <= level and type(q.Task) == "table" then
								for t in pairs(q.Task) do
									if type(t) == "string" then
										local lt = cleanBossName(t)
										local score = 0
										if lt == lname then
											score = 10000
										elseif lname:find(lt, 1, true) then
											score = 5000 + #lt
										elseif lt:find(lname, 1, true) then
											score = 3000 + #lname
										end
										if score > 0 then score = score + q.LevelReq end
										if score > bestScore then
											bestCat, bestQ, bestIdx, bestScore = catName, q, idx, score
										end
									end
								end
							end
						end
					end
				end

				if not bestQ then return false end

				local accepted = Q.acceptDirect(bestCat, bestQ.Name, bestIdx)
				if not accepted then return false end

				task.wait(0.15)
				if Q.questController then
					local qc = Q.questController.QuestsCompleted
					if qc and qc[bestCat] and qc[bestCat][bestQ.Name] == false then
						return true
					end
				end
				return true
			end

			-- Escolhe para onde ir: o spawn do boss escolhido, ou (modo "Todos") o spawn mais perto que não foi pulado
			function Q.pickSpawn(hrp)
				if Q.target ~= "Todos" then
					local pos = Q.spawnPos(Q.target)
					if pos then return Q.target, pos end
					return nil, nil
				end
				local now = tick()
				local best, bestPos, bestD
				local function search(useSkip)
					for _, e in ipairs(Q.scanSpawns()) do
						if not (useSkip and (Q.skip[e.name] or 0) > now) then
							local d = (e.pos - hrp.Position).Magnitude
							if not bestD or d < bestD then best, bestPos, bestD = e.name, e.pos, d end
						end
					end
				end
				search(true)
				if not best then
					-- todos os spawns já foram visitados: espera os bosses respawnarem em vez de ficar trocando
					Q.allSkipped = true
					return nil, nil
				end
				Q.allSkipped = false
				return best, bestPos
			end

			-- Só chamada depois de CHEGAR no spawn (sp). Só aceita inimigos perto do spawn.
			function Q.find(hrp, sp)
				local folder = workspace:FindFirstChild("Enemies")
				if not folder then return nil end

				local allModels = {}
				for _, obj in ipairs(folder:GetChildren()) do
					if obj:IsA("Model") then
						local hum = obj:FindFirstChildOfClass("Humanoid")
						local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj.PrimaryPart
						if hum and part then
							table.insert(allModels, {
								model = obj,
								hum = hum,
								part = part,
								cleanName = cleanBossName(obj.Name),
								alive = hum.Health > 0,
							})
						end
					end
				end
				if #allModels == 0 then return nil end

				local best, bestDist = nil, math.huge
				local function consider(entry, dist)
					if not entry.alive then return end
					if sp and (entry.part.Position - sp).Magnitude > Q.spawnRadius then return end -- longe do spawn: ignora
					if dist < bestDist then
						best, bestDist = {
							model = entry.model,
							part = entry.part,
							hum = entry.hum,
							name = entry.model.Name,
						}, dist
					end
				end

				local names = {}
				if Q.target ~= "Todos" then
					table.insert(names, cleanBossName(Q.target))
				else
					for _, n in ipairs(Q.currentList()) do
						table.insert(names, cleanBossName(n))
					end
				end

				for _, entry in ipairs(allModels) do
					for _, ln in ipairs(names) do
						if ln ~= "" and entry.cleanName ~= "" then
							local match = entry.cleanName == ln or entry.cleanName:find(ln, 1, true)
							-- o nome do boss contido no nome do inimigo só vale perto do spawn (evita mob aleatório no caminho)
							if not match and sp then match = ln:find(entry.cleanName, 1, true) end
							if match then
								consider(entry, (entry.part.Position - hrp.Position).Magnitude)
								break
							end
						end
					end
				end
				if best then return best end

				-- parecido pela inicial do nome: só dentro do raio do spawn
				if sp and Q.target ~= "Todos" then
					local targetAlpha = cleanBossName(Q.target):gsub("[^%a]", "")
					local targetFirst = targetAlpha:sub(1, 1)
					local targetFirst2 = targetAlpha:sub(1, 2)
					for _, entry in ipairs(allModels) do
						if entry.alive then
							local entryAlpha = entry.cleanName:gsub("[^%a]", "")
							local initialMatch = (targetFirst ~= "" and entryAlpha:sub(1, 1) == targetFirst)
								or (targetFirst2 ~= "" and entryAlpha:sub(1, 2) == targetFirst2)
							if initialMatch and (entry.part.Position - sp).Magnitude <= 80 then
								consider(entry, (entry.part.Position - sp).Magnitude)
							end
						end
					end
				end

				return best
			end

			function Q.release()
				Q.bossBusy = false; AetherisBossBusy = false
				Q.stopFly()
			end

			-- STEP com guard inicial
			function Q.step()
				if not Q.enabled then return end
				AetherisBossBusy = true -- boss ligado: o Auto Farm Level fica parado (não ataca inimigos no caminho)
				if Q.retreat() then return end
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then return end

				local targetValid = false
				local ct = Q.currentTarget

				if ct and ct.model and ct.model.Parent then
					local freshHum = ct.model:FindFirstChildOfClass("Humanoid")
					local freshPart = ct.model:FindFirstChild("HumanoidRootPart")
						or ct.model:FindFirstChild("Head")
						or ct.model:FindFirstChildWhichIsA("BasePart", true)
						or ct.model.PrimaryPart

					if freshHum and freshPart then
						ct.hum = freshHum
						ct.part = freshPart
						Q.currentTargetPos = freshPart.Position
						Q.currentTargetGoneAt = nil
						Q.currentTargetLastSeen = tick()

						if freshHum.Health > 0 then
							targetValid = true
							Q.currentTargetZeroAt = nil
						else
							if not Q.currentTargetZeroAt then
								Q.currentTargetZeroAt = tick()
							end
							if tick() - Q.currentTargetZeroAt < 15 then
								targetValid = true
							else
								Q.currentTarget = nil
								Q.currentTargetZeroAt = nil
								Q.currentTargetGoneAt = nil
							end
						end
					else
						if not Q.currentTargetGoneAt then
							Q.currentTargetGoneAt = tick()
						end
						if tick() - Q.currentTargetGoneAt < 10 then
							targetValid = true
						else
							Q.currentTarget = nil
							Q.currentTargetZeroAt = nil
							Q.currentTargetGoneAt = nil
						end
					end
				elseif ct then
					if not Q.currentTargetGoneAt then
						Q.currentTargetGoneAt = tick()
					end
					if tick() - Q.currentTargetGoneAt < 10 then
						targetValid = true
					else
						Q.currentTarget = nil
						Q.currentTargetZeroAt = nil
						Q.currentTargetGoneAt = nil
					end
				end

				if not targetValid then
					Q.currentTarget = nil
					Q.currentTargetZeroAt = nil
					Q.currentTargetGoneAt = nil

					-- 1) vai até o spawn SEM procurar inimigos no caminho
					-- boss que acabou de ser morto/sumiu: marca o spawn dele como visitado
					if Q.engagedSpawn then
						Q.skip[Q.engagedSpawn] = tick() + 150
						Q.engagedSpawn = nil
					end
					local spName, sp = Q.pickSpawn(hrp)
					if not sp and Q.target == "Todos" and Q.allSkipped then
						Q.hold()
						setStatus("⏳ Bosses mortos — aguardando respawn...", Color3.fromRGB(255, 200, 100))
						task.wait(0.5)
						return
					end
					if not sp and #Q.scanSpawns() > 0 then
						-- há spawns, mas o do boss escolhido não foi achado: não procura nada em Enemies
						Q.hold()
						setStatus("🔍 Spawn do boss não encontrado", Color3.fromRGB(255, 160, 120))
						task.wait(0.3)
						return
					end
					local arrived = true
					if sp then
						local flat = Vector3.new(sp.X - hrp.Position.X, 0, sp.Z - hrp.Position.Z).Magnitude
						arrived = flat <= Q.arriveDist
					end

					if not arrived then
						Q.arrivedAt = nil
						Q.enableNoclip()
						flyTo(hrp, sp + Vector3.new(0, Q.height, 0))
						setStatus("👹 Indo ao spawn de " .. tostring(spName), Color3.fromRGB(200, 180, 120))
						return
					end

					-- 2) chegou no spawn: agora sim procura o boss em Enemies (só perto do spawn)
					local boss = Q.find(hrp, sp)
					if boss then
						Q.arrivedAt = nil
						Q.engagedSpawn = spName
						Q.currentTarget = boss
						Q.currentTargetPos = boss.part.Position
						Q.currentTargetLastSeen = tick()
					elseif sp then
						-- no spawn mas o boss ainda não nasceu: espera ali (no modo "Todos" tenta o próximo spawn depois de 4s)
						Q.arrivedAt = Q.arrivedAt or tick()
						if Q.target == "Todos" and tick() - Q.arrivedAt > 8 then
							Q.skip[spName] = tick() + 150
							Q.arrivedAt = nil
						end
						Q.enableNoclip()
						flyTo(hrp, sp + Vector3.new(0, Q.height, 0))
						setStatus("⏳ Esperando o boss nascer no spawn...", Color3.fromRGB(255, 200, 100))
						return
					end
				end

				local boss = Q.currentTarget

				if not boss then
					if Q.lastBoss and Q.lastBoss.model and Q.lastBoss.model.Parent and (tick() - Q.lastBossSeenAt) < 15 then
						Q.enableNoclip()
						if Q.lastBoss.part and Q.lastBoss.part.Parent then
							flyTo(hrp, Q.lastBoss.part.Position + Vector3.new(0, Q.height, 0))
						else
							Q.hold()
						end
						setStatus("⏳ Aguardando boss...", Color3.fromRGB(255, 200, 100))
						return
					end

					Q.hold()
					setStatus("🔍 Procurando boss...", Color3.fromRGB(200, 180, 120))
					task.wait(0.2)
					return
				end

				Q.bossBusy = true; AetherisBossBusy = true
				Q.lastBoss = boss
				Q.lastBossSeenAt = tick()
				Q.enableNoclip()
				Q.ensureWeapon()

				if Q.wantQuest and not Q.quested[boss.model] then
					local retryAt = Q.questRetryAt[boss.model] or 0
					if tick() > retryAt then
						if Q.takeQuest(boss.name) then
							Q.quested[boss.model] = true
						else
							Q.questRetryAt[boss.model] = tick() + 5
						end
					end
				end

				if Q.commF and tick() - Q.lastBuso > 2 then
					Q.lastBuso = tick()
					if not char:FindFirstChild("HasBuso") then pcall(function() Q.commF:InvokeServer("Buso") end) end
				end

				local aimPos
				if boss.part and boss.part.Parent then
					aimPos = boss.part.Position
				elseif Q.currentTargetPos then
					aimPos = Q.currentTargetPos
				else
					Q.hold()
					return
				end

				flyTo(hrp, aimPos + Vector3.new(0, Q.height, 0))
				Q.aoeHit()

				local hpText
				if boss.hum and boss.hum.Parent and boss.hum.Health > 0 then
					hpText = math.floor(boss.hum.Health) .. " HP"
				else
					hpText = "aguardando..."
				end
				setStatus("⚔️ " .. boss.name .. " — " .. hpText, Color3.fromRGB(255, 140, 120))
			end

			-- START com Q.stop() antes de tudo pra limpar estado anterior
			function Q.start()
				if not Q.init() then
					setStatus("❌ Módulos não encontrados (veja o F9)", Color3.fromRGB(255, 120, 120))
					return false
				end
				Q.stop()
				Q.token = Q.token + 1
				local token = Q.token
				Q.enabled = true
				Q.currentTarget = nil
				Q.currentTargetZeroAt = nil
				Q.currentTargetGoneAt = nil
				Q.currentTargetPos = nil
				Q.currentTargetLastSeen = 0
				Q.lastBoss = nil
				Q.lastBossSeenAt = 0
				Q.arrivedAt = nil
				table.clear(Q.skip); Q.engagedSpawn = nil; Q.allSkipped = false
				Q.enableNoclip()
				task.spawn(function()
					while Q.enabled and Q.token == token and screenGui.Parent do
						RunService.Heartbeat:Wait()
						if not Q.enabled or Q.token ~= token then break end
						local ok, err = pcall(Q.step)
						if not ok then warn("[Aetheris Boss]", err); task.wait(1) end
					end
					-- cleanup final: só roda se essa thread foi a última e não tem novo start
					if Q.token == token and not Q.enabled then
						Q.stopFly()
						Q.disableNoclip()
					end
				end)
				return true
			end

			-- STOP: enabled=false PRIMEIRO, depois cleanup
			function Q.stop()
				Q.enabled = false
				Q.token = Q.token + 1
				Q.stopFly()
				Q.disableNoclip()
				Q.bossBusy = false; AetherisBossBusy = false
				Q.currentTarget = nil
				Q.currentTargetZeroAt = nil
				Q.currentTargetGoneAt = nil
				Q.currentTargetPos = nil
				Q.lastBoss = nil
				Q.lastBossSeenAt = 0
				setStatus("💤 Desligado", Color3.fromRGB(150, 150, 180))
			end

			screenGui.Destroying:Connect(function()
				Q.stop()
				if charConn then charConn:Disconnect() end
			end)

			return Q
		end)()

