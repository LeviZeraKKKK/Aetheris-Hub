		-- laço que atualiza o alcance/visão do Observation (um por personagem)
		function K.radiusLoop(char, hum, token)
			while K.radiusToken == token and K.ready and char:IsDescendantOf(workspace) and hum.Health > 0 do
				task.wait(0.3)
				if K.radiusToken ~= token or not char:IsDescendantOf(workspace) or hum.Health <= 0 then break end
				local om = K.om
				if om then
					pcall(function()
						om.radius = math.clamp(om.radius + K.visionRadius.Value * 0.2, 0, K.visionRadius.Value)
						om:refresh()
						if om.active and char:FindFirstChild("KenDisabled") then om:setActive(false) end
					end)
				end
			end
		end

		function K.setupCharacter(char)
			if not K.ready then return end
