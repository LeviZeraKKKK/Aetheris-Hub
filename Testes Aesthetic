	local function pickFruit()
		local now = tick()
		local count = #fruitCache
		if count == 0 then return nil, nil end

		for offset = 0, count - 1 do
			local i = ((lastFruitIdx - 1 + offset) % count) + 1
			local fruit = fruitCache[i]

			if fruit and fruit.Parent and not isHeldByPlayer(fruit) then
				local lastHandle = handled[fruit]
				if not lastHandle or (now - lastHandle) >= 3 then
					local handle = fruit:FindFirstChild("Handle")
					if handle and handle:IsA("BasePart") then
						lastFruitIdx = i
						return fruit, handle
					end
				end
			end
		end
		return nil, nil
	end

