		S.gen = 0
		function S.scheduleRebind()
			S.gen = S.gen + 1
			local gen = S.gen
			S.selecting = false
			task.spawn(function()
				for _, delay in ipairs({0.3, 0.7, 1.5, 2.5, 4}) do
					task.wait(delay)
					if gen ~= S.gen or not S.enabled then return end
					local char = player.Character
					if char and char:HasTag("Soru") then bindSoru() end
				end
			end)
		end

		local function setupFlashstep()
			if not S.loaded then
				local ok, err = pcall(function()
					local RS = ReplicatedStorage
					S.effect = require(RS:WaitForChild("Effect", 5))
					S.util = require(RS:WaitForChild("Util", 5))
					S.mobile = require(RS.Controllers.UI.MobileUIController)
					local shared = RS.EffectContainer:FindFirstChild("Shared")
					S.soruEffect = (shared and shared:FindFirstChild("Soru")) and S.effect.new("Shared.Soru") or nil
				end)
				if not ok then
					warn("[Aetheris] Flashstep: falha ao carregar módulos do jogo: " .. tostring(err))
					return
				end
				S.loaded = true
				S.signal = game:GetService("CollectionService"):GetInstanceAddedSignal("Soru"):Connect(function(inst)
					if inst == player.Character then S.scheduleRebind() end
				end)
				S.charSignal = player.CharacterAdded:Connect(function()
					S.scheduleRebind()
				end)
			end
			local char = player.Character
			if char and char:HasTag("Soru") then
				bindSoru()
			end
		end

