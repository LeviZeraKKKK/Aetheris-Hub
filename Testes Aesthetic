			function Q.scanSpawns()
				local now = tick()
				if Q.spawnCache and now - Q.spawnCacheAt < 2 then return Q.spawnCache end
				local result = {}
				local origin = workspace:FindFirstChild("_WorldOrigin")
				local folder = origin and origin:FindFirstChild("EnemySpawns")
				if folder then
					local counts, first = {}, {}
					for _, sp in ipairs(folder:GetChildren()) do
						counts[sp.Name] = (counts[sp.Name] or 0) + 1
						first[sp.Name] = sp
					end
					for name, c in pairs(counts) do
						if c == 1 then
							local ok, pos = pcall(function() return first[name]:GetPivot().Position end)
							if ok then
