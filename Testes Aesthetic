					TweenService:Create(p, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = UDim2.new(-1, 0, 0, 4)}):Play()
					task.wait(0.15)
					p.Visible = false
				end
			end

			page.Visible = true
			page.Position = UDim2.new(1, 0, 0, 4)
			TweenService:Create(page, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 4, 0, 4)}):Play()

			for _, tData in ipairs(tabButtonsList) do
				TweenService:Create(tData.Indicator, TweenInfo.new(0.15), {Size = UDim2.new(0, 2, 0, 0)}):Play()
				TweenService:Create(tData.Label, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(180, 180, 180)}):Play()
			end

			TweenService:Create(indicator, TweenInfo.new(0.15), {Size = UDim2.new(0, 2, 0, 16)}):Play()
			TweenService:Create(tabNameLabel, TweenInfo.new(0.15), {TextColor3 = currentTextColor}):Play()

			activePage = page
		end)

		if i == 1 then
			page.Visible = true
			page.Position = UDim2.new(0, 4, 0, 4)
			activePage = page
			indicator.Size = UDim2.new(0, 2, 0, 16)
			tabNameLabel.TextColor3 = currentTextColor
		end
