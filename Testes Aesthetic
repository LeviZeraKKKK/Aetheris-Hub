				for _, c in ipairs(K.charConns) do c:Disconnect() end
			end
			K.charConns = {}
			if K.om then pcall(function() K.om:destroy() end) end
			K.om = K.observationManager.new(player)
			K.global.OM = K.om
			local hum = K.humanoid
			table.insert(K.charConns, hum.Died:Connect(function()
				if K.om then pcall(function() K.om:destroy() end) end
