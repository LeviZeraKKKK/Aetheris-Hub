		manager.fileIO = type(readfile) == "function" and type(writefile) == "function"
		manager.encode = function(value)
			local valueType = typeof(value)
			if valueType == "Color3" then
				return {__aetherisType = "Color3", r = value.R, g = value.G, b = value.B}
			elseif valueType == "EnumItem" then
				local enumType = string.match(tostring(value.EnumType), "Enum%.(.+)")
				return {__aetherisType = "EnumItem", enumType = enumType, name = value.Name}
			elseif type(value) == "table" then
				local out = {}
				for key, item in pairs(value) do
					if type(key) == "string" or type(key) == "number" then
						local encoded = manager.encode(item)
						if encoded ~= nil then out[key] = encoded end
					end
				end
				return out
			elseif type(value) == "string" or type(value) == "number" or type(value) == "boolean" then
				return value
			end
			return nil
		end
		manager.decode = function(value)
			if type(value) ~= "table" then return value end
			if value.__aetherisType == "Color3" then
				if type(value.r) == "number" and type(value.g) == "number" and type(value.b) == "number" then
					return Color3.new(value.r, value.g, value.b)
				end
				return nil
			elseif value.__aetherisType == "EnumItem" then
				local enumContainer = value.enumType and Enum[value.enumType]
				if enumContainer and type(value.name) == "string" then
					local ok, enumValue = pcall(function() return enumContainer[value.name] end)
					if ok then return enumValue end
				end
				return nil
			end
			local out = {}
			for key, item in pairs(value) do out[key] = manager.decode(item) end
			return out
		end
		manager.persist = function()
			if not manager.fileIO then return true end
			local ok, encoded = pcall(function() return HttpService:JSONEncode(manager.profiles) end)
			if not ok then return false end
			local wrote = pcall(function() writefile(manager.fileName, encoded) end)
			return wrote
		end
		if manager.fileIO then
			local readOk, content = pcall(function() return readfile(manager.fileName) end)
			if readOk and type(content) == "string" and content ~= "" then
