		TweenService:Create(floatingBtn, TweenInfo.new(0.2), {TextSize = 24}):Play()
		TweenService:Create(floatGlowStroke, TweenInfo.new(0.2), {Transparency = 0.15, Thickness = 3.5}):Play()
		TweenService:Create(floatInnerStroke, TweenInfo.new(0.2), {Transparency = 0.0}):Play()
	end)

