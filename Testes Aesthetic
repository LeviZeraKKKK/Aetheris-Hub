			print("Categoria:", Q.questCat, "| Nome:", Q.questName, "#" .. Q.questIndex, "| Fase:", Q.phase)
			print("questCompleted:", Q.completed, "| desde accept:", math.floor(tick() - Q.acceptedAt) .. "s")
			local char = player.Character
			if char then
