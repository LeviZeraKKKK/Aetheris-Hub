			local spinGrad = Instance.new("UIGradient")
			spinGrad.Color = ColorSequence.new(Color3.fromRGB(110, 190, 255), Color3.fromRGB(56, 132, 255))
			spinGrad.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
