local function updateGlobalTheme(newColor)
	currentThemeColor = newColor
	
	for _, data in pairs(themeToggles) do
		if data.isToggled and data.circle and data.button and data.led then
			TweenService:Create(data.circle, TweenInfo.new(0.18), {Position = UDim2.new(1, -14, 0.5, -6)}):Play()
			TweenService:Create(data.button, TweenInfo.new(0.18), {BackgroundColor3 = newColor}):Play()
			TweenService:Create(data.led, TweenInfo.new(0.18), {BackgroundColor3 = newColor}):Play()
		end
	end

	for _, secStroke in pairs(themeSections) do
		secStroke.Color = newColor
	end

	for _, fill in pairs(themeSliders) do
		fill.BackgroundColor3 = newColor
	end

	for _, line in pairs(resizeSymbolsLines) do
		line.BackgroundColor3 = newColor
	end

	for _, subLabel in pairs(headerSubtitles) do
		subLabel.TextColor3 = newColor
	end

	for _, ind in pairs(tabIndicators) do
		ind.BackgroundColor3 = newColor
	end

	for _, part in pairs(themeParticles) do
		if part and part.Parent then
			part.BackgroundColor3 = newColor
		end
	end

	if floatingBtnRefs.btn and floatingBtnRefs.btn.Parent then
		TweenService:Create(floatingBtnRefs.btn, TweenInfo.new(0.2), {TextColor3 = newColor}):Play()
	end
	if floatingBtnRefs.glowStroke then floatingBtnRefs.glowStroke.Color = newColor end
	if floatingBtnRefs.innerStroke then floatingBtnRefs.innerStroke.Color = newColor end
	if floatingBtnRefs.ringStroke then floatingBtnRefs.ringStroke.Color = newColor end
	for _, fp in pairs(floatingBtnRefs.particles) do
		if fp and fp.Parent then
			fp.BackgroundColor3 = newColor
			local s = fp:FindFirstChildOfClass("UIStroke")
			if s then s.Color = newColor end
		end
	end
end

local function updateGlobalTextFont(newFont)
	currentGlobalFont = newFont
	for _, txtObj in pairs(allTextLabels) do
		if txtObj and txtObj.Parent then
			pcall(function()
				txtObj.Font = newFont
			end)
		end
	end
end

local function updateGlobalTextColor(newColor)
	currentTextColor = newColor
	for _, txtObj in pairs(allTextLabels) do
		if txtObj and txtObj.Parent and (txtObj:IsA("TextLabel") or txtObj:IsA("TextButton") or txtObj:IsA("TextBox")) then
			pcall(function()
				txtObj.TextColor3 = newColor
			end)
		end
	end
end

