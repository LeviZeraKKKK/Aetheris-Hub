				known = {}, have = nil, lastCount = 0, lastRaidTry = 0, wasRaid = false,
				cfg = {
					material = {weapon = "Melee", height = 12, speed = 270},
					raid = {weapon = "Melee", height = 12, speed = 270},
					travel = {weapon = "Melee", height = 25, speed = 270},
					mastery = {weapon = "Melee", height = 12, speed = 270},
				},
				masteryGoal = 0, masterySilent = true, masteryRange = 800,
				masteryNoBoss = true,
				masteryQueue = {Melee = false, Fruit = false, Sword = false, Gun = false}, masteryUseQueue = false, masteryQMin = 0,
				qIdx = 1, qStart = 0, qDone = {}, masteryPrio = "near", masteryMinHP = 0,
				skillGap = 1.2, skillDist = 60, skillHold = 0.1, skillKeys = {Z = true, X = true, C = true, V = true}, masteryNow = nil, masteryAt = 0, masterySkills = true, skillAt = 0, skillIdx = 1,
				material = nil, goal = 0, chip = "Flame", pay = "Beli", autoRaid = true, gotoFn = nil, gotoName = "",
			}
			local say = {}
			local setters = {}
			local function note(text, color)
				if AetherisNotify then pcall(AetherisNotify, text, color or Color3.fromRGB(150, 190, 255), 3) end
			end
			local function cfg() return E.cfg[E.mode or "material"] end

			-- ===== remotes =====
			local function init()
				if E.ready then return true end
				pcall(function()
					local net = require(ReplicatedStorage.Modules.Net)
					E.hit = net:RemoteEvent("RegisterHit")
					E.atk = net:RemoteEvent("RegisterAttack")
				end)
				if not E.hit then
					for _, o in ipairs(ReplicatedStorage:GetDescendants()) do
						if o:IsA("RemoteEvent") then
							if o.Name == "RegisterHit" then E.hit = o elseif o.Name == "RegisterAttack" then E.atk = o end
						end
					end
				end
				local r = ReplicatedStorage:FindFirstChild("Remotes")
				E.comm = r and r:FindFirstChild("CommF_") or nil
				E.ready = (E.hit ~= nil and E.comm ~= nil)
				return E.ready
			end

			-- ===== arma / ataque =====
			local function toolType(tool)
				if not tool or not tool:IsA("Tool") then return nil end
				local wt = tool:GetAttribute("WeaponType")
				if wt == "Demon Fruit" then return "Fruit" end
				if wt == "Sword" or wt == "Melee" or wt == "Gun" then return wt end
				if tool:HasTag("MeleeTool") then return "Melee" end
				if tool:HasTag("GunTool") then return "Gun" end
				local n = tool.Name:lower()
				if n:find("fruit") then return "Fruit" end
				if n:find("sword") or n:find("blade") or n:find("katana") or n:find("saber") then return "Sword" end
				if n:find("fighting") or n:find("karate") or n:find("combat") then return "Melee" end
				if tool:GetAttribute("FruitType") then return "Fruit" end
				return nil
			end
			local function equip()
				if tick() - E.lastEquip < 1 then return end
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not hum then return end
				local want = cfg().weapon
				local cur = char:FindFirstChildOfClass("Tool")
				if cur and toolType(cur) == want then return end
				E.lastEquip = tick()
				local bp = player:FindFirstChild("Backpack")
				if bp then
					for _, tool in ipairs(bp:GetChildren()) do
						if tool:IsA("Tool") and toolType(tool) == want then
							pcall(function() hum:EquipTool(tool) end)
							return
						end
					end
				end
			end
			local function buso()
				if tick() - E.lastBuso < 4 then return end
				E.lastBuso = tick()
				local char = player.Character
				if char and not char:FindFirstChild("HasBuso") and E.comm then
					pcall(function() E.comm:InvokeServer("Buso") end)
				end
			end
			local function hit(range)
				if tick() - E.lastHit < 0.05 then return end
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local tool = char and char:FindFirstChildOfClass("Tool")
				local folder = workspace:FindFirstChild("Enemies")
				if not hrp or not tool or not folder or not E.hit then return end
				if not tool:FindFirstChild("LocalEquippedWeaponPointer") then return end
				local list = {}
				for _, obj in ipairs(folder:GetChildren()) do
					if obj:IsA("Model") then
						local hum = obj:FindFirstChildOfClass("Humanoid")
						local part = obj:FindFirstChild("Head") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("HumanoidRootPart")
						if hum and hum.Health > 0 and part and (part.Position - hrp.Position).Magnitude <= range then
							table.insert(list, {obj, part})
						end
					end
				end
				if #list == 0 then return end
				E.lastHit = tick()
				E.combo = (E.combo % 4) + 1
				if E.atk then pcall(function() E.atk:FireServer(0.3, E.combo) end) end
				local extras = {}
				for i = 2, #list do table.insert(extras, list[i]) end
				pcall(function() E.hit:FireServer(list[1][2], extras) end)
			end

			-- ===== noclip / voo =====
			local function noclipOn()
				if E.noclipConn then return end
				table.clear(E.orig)
				E.noclipConn = RunService.Stepped:Connect(function()
					if not E.enabled then return end
					local c = player.Character
					if not c then return end
					for _, part in ipairs(c:GetDescendants()) do
						if part:IsA("BasePart") then
							if E.orig[part] == nil then E.orig[part] = part.CanCollide end
							part.CanCollide = false
						end
					end
				end)
			end
			local function noclipOff()
				if E.noclipConn then E.noclipConn:Disconnect(); E.noclipConn = nil end
				for part, o in pairs(E.orig) do
					if part and part.Parent then part.CanCollide = o end
				end
				table.clear(E.orig)
			end
			local function fly(hrp, v)
				if not E.bv or E.bv.Parent ~= hrp then
					if E.bv then E.bv:Destroy() end
					E.bv = Instance.new("BodyVelocity")
					E.bv.Name = "AetherisTaskFly"
					E.bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
					E.bv.P = 15000
					E.bv.Velocity = Vector3.zero
					E.bv.Parent = hrp
				end
				E.bv.Velocity = v
			end
			local function stopFly()
				if E.bv then E.bv:Destroy(); E.bv = nil end
			end
			local function flyTo(hrp, target)
				local offset = target - hrp.Position
				local dist = offset.Magnitude
				if dist < 0.1 then fly(hrp, Vector3.zero) return end
				local speed
				if dist > 4 then speed = math.min(dist * 3, cfg().speed * 1.5) else speed = math.max(dist * 8, 20) end
				speed = math.min(speed, dist * 6)
				fly(hrp, (offset / dist) * speed)
			end

			-- ===== buscas =====
			local function nameMatch(name, names)
				for _, n in ipairs(names) do
					if name == n or name:sub(1, #n + 2) == n .. " [" then return true end
				end
				return false
			end
			local function nearestEnemy(names, hrp, filter)
				local folder = workspace:FindFirstChild("Enemies")
				local best, bd = nil, math.huge
				if not folder then return nil end
				for _, obj in ipairs(folder:GetChildren()) do
					if obj:IsA("Model") and (names == nil or nameMatch(obj.Name, names)) then
						local hum = obj:FindFirstChildOfClass("Humanoid")
						local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
						if hum and hum.Health > 0 and part and (not filter or filter(part.Position)) then
							local d = (part.Position - hrp.Position).Magnitude
							if d < bd then best, bd = {model = obj, part = part, dist = d}, d end
						end
					end
				end
				return best
			end
			local function nearestSpawn(names, hrp)
				local origin = workspace:FindFirstChild("_WorldOrigin")
				local folder = origin and origin:FindFirstChild("EnemySpawns")
				if folder then
					for _, sp in ipairs(folder:GetChildren()) do
						if nameMatch(sp.Name, names) then
							local ok, pos = pcall(function() return sp:GetPivot().Position end)
							if ok then E.known[tostring(pos)] = {name = sp.Name, pos = pos} end
						end
					end
				end
				local best, bd = nil, math.huge
				for _, e in pairs(E.known) do
					if nameMatch(e.name, names) then
						local d = (e.pos - hrp.Position).Magnitude
						if d < bd then best, bd = e.pos, d end
					end
				end
				return best, bd
			end
			local function itemCount(item)
				if not E.comm then return nil end
				local ok, inv = pcall(function() return E.comm:InvokeServer("getInventory") end)
				if ok and type(inv) == "table" then
					for _, it in pairs(inv) do
						if type(it) == "table" and it.Name == item then return it.Count or it.count or 1 end
					end
					return 0
				end
				return nil
			end

			-- ===== controle =====
			local function releaseAll()
				stopFly()
				noclipOff()
				AetherisBossBusy = (BossLogic and BossLogic.enabled) and true or false
			end
			local function stopMode(mode)
				if E.mode ~= mode then return end
				E.enabled = false
				E.mode = nil
				E.token = E.token + 1
				releaseAll()
				if say[mode] then say[mode]("💤 Desligado", Color3.fromRGB(150, 150, 180)) end
			end
			local function finish(mode)
				-- desliga também o toggle na interface
				local f = setters[mode]
				if f then f(false) else stopMode(mode) end
			end

			local step
			local function start(mode)
				if not init() then
					note("Não achei os remotes do jogo", Color3.fromRGB(255, 120, 120))
					finish(mode)
					return
				end
				if E.enabled and E.mode ~= mode then
					local prev = E.mode
					if setters[prev] then setters[prev](false) else stopMode(prev) end
				end
				if BossLogic and BossLogic.enabled and AetherisToggleByName and AetherisToggleByName["Auto Kill Boss"] then
					AetherisToggleByName["Auto Kill Boss"](false)
				end
				E.enabled = true
				E.mode = mode
				E.token = E.token + 1
				local my = E.token
				E.wasRaid = false
				E.raidPhase = "button"
				E.raidEndAt = nil
				E.raidClickAt = nil
				task.spawn(function()
					while E.enabled and E.token == my do
						AetherisBossBusy = true
						local ok, err = pcall(step)
						if not ok then warn("[Aetheris] tarefa extra:", err) end
						task.wait()
					end
				end)
			end

			-- ===== passos =====
			local function stepMaterial(hrp)
				local mat = E.material
				if not mat then say.material("Escolha um material", Color3.fromRGB(255, 205, 110)) stopFly() return end
				if E.goal > 0 and tick() - E.lastCount > 6 then
					E.lastCount = tick()
					local c = itemCount(mat.item)
					if c then
						E.have = c
						if c >= E.goal then
							note("Meta atingida: " .. c .. " " .. mat.item, Color3.fromRGB(110, 255, 160))
							finish("material")
							return
						end
					end
				end
				local tag = mat.item .. (E.have and (" (" .. E.have .. ")") or "")
				equip()
				buso()
				local t = nearestEnemy(mat.names, hrp)
				if t then
					noclipOn()
					say.material("⚔️ " .. tag .. " — atacando", Color3.fromRGB(150, 220, 255))
					flyTo(hrp, t.part.Position + Vector3.new(0, cfg().height, 0))
					hit(80)
					return
				end
				local sp, d = nearestSpawn(mat.names, hrp)
				if sp then
					noclipOn()
					if d > 70 then
						say.material("🧭 " .. tag .. " — indo ao spawn (" .. math.floor(d) .. "m)", Color3.fromRGB(150, 200, 255))
					else
						say.material("⏳ " .. tag .. " — esperando respawn", Color3.fromRGB(190, 190, 230))
					end
					flyTo(hrp, sp + Vector3.new(0, cfg().height, 0))
				else
					say.material("❓ Nenhum inimigo desse material aqui (outro mar?)", Color3.fromRGB(255, 160, 120))
					stopFly()
				end
			end

			-- ===== comprar o chip: com Beli ou com uma fruta (a de menor valor) =====
			local function findTool(pred)
				local char = player.Character
				local bp = player:FindFirstChild("Backpack")
				for _, holder in ipairs({char, bp}) do
					if holder then
						for _, t in ipairs(holder:GetChildren()) do
							if t:IsA("Tool") and pred(t) then return t end
						end
					end
				end
				return nil
			end
			local function hasChip()
				return findTool(function(t) return t.Name:lower():find("microchip", 1, true) ~= nil end) ~= nil
			end
			local function cheapestStoredFruit()
				if not E.comm then return nil end
				local ok, inv = pcall(function() return E.comm:InvokeServer("getInventory") end)
				if not ok or type(inv) ~= "table" then return nil end
				local best
				for _, it in pairs(inv) do
					if type(it) == "table" and it.Type == "Blox Fruit" and (it.Count or 1) > 0 then
						local v = tonumber(it.Value) or math.huge
						if not best or v < best.value then best = {name = it.Name, value = v} end
					end
				end
				return best
			end
			local function holdFruit()
				local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				local function isFruit(t) return t:IsA("Tool") and t.Name:find("Fruit$") ~= nil end
				local tool = findTool(isFruit)
				if not tool then
					-- sem fruta na mochila: abre o inventário e tira a de menor valor
					local best = cheapestStoredFruit()
					if not best then return false, "sem fruta no inventário" end
					say.raid("🎒 Tirando " .. best.name .. " do inventário", Color3.fromRGB(255, 205, 110))
					pcall(function() E.comm:InvokeServer("LoadFruit", best.name) end)
					for _ = 1, 16 do
						task.wait(0.25)
						tool = findTool(isFruit)
						if tool then break end
					end
					if not tool then return false, "não consegui tirar a fruta" end
				end
				if hum and tool.Parent ~= player.Character then pcall(function() hum:EquipTool(tool) end) end
				task.wait(0.3)
				return true
			end
			local function ensureChip()
				if hasChip() then return true end
				if E.pay == "Fruta" then
					local ok, why = holdFruit()
					if not ok then
						say.raid("⚠️ " .. why, Color3.fromRGB(255, 160, 120))
						return false
					end
				else
					-- Beli: guarda a fruta da mão para o jogo cobrar em dinheiro
					local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					if hum then pcall(function() hum:UnequipTools() end) end
				end
				say.raid("🔮 Comprando chip " .. E.chip .. " (" .. (E.pay == "Fruta" and "fruta" or "Beli") .. ")", Color3.fromRGB(190, 160, 255))
				pcall(function() E.comm:InvokeServer("RaidsNpc", "Select", E.chip) end)
				task.wait(0.8)
				if not hasChip() then
					say.raid("⚠️ Compra do chip não confirmada", Color3.fromRGB(255, 160, 120))
				end
				return true
			end

			-- ilhas da raid (só existem enquanto a raid está rodando)
			local function raidIslands()
				local origin = workspace:FindFirstChild("_WorldOrigin")
				local locs = origin and origin:FindFirstChild("Locations")
				local list = {}
				if locs then
					for i = 1, 5 do
						local isl = locs:FindFirstChild("Island " .. i)
						if isl then
							local ok, pos = pcall(function() return isl:GetPivot().Position end)
							if ok then list[i] = pos end
						end
					end
				end
				return list
			end
			local function raidButton()
				local map = workspace:FindFirstChild("Map")
				if not map then return nil end
				for _, holderName in ipairs({"CircleIsland", "Boat Castle"}) do
					local holder = map:FindFirstChild(holderName)
					local sum = holder and (holder:FindFirstChild("RaidSummon2") or holder:FindFirstChild("RaidSummon"))
					local btn = sum and sum:FindFirstChild("Button")
					local main = btn and btn:FindFirstChild("Main")
					local cd = main and main:FindFirstChildOfClass("ClickDetector")
					if cd then return cd, main end
				end
				return nil
			end
			-- Fases: "button" (ir ao botão e comprar/iniciar) -> "loading" (espera a raid e o mapa carregarem)
			--        -> "fight" (só inimigos das ilhas da raid) -> volta obrigatoriamente para "button"
			local function stepRaid(hrp)
				E.raidPhase = E.raidPhase or "button"
				local islands = raidIslands()
				local hasIslands = next(islands) ~= nil
				equip()
				buso()

				-- raid já rodando (ex.: você mesmo iniciou): vai direto para o carregamento
				if hasIslands and E.raidPhase == "button" then
					E.raidPhase = "loading"
					E.raidLoadedAt = nil
				end

				if E.raidPhase == "fight" then
					if not hasIslands then
						-- terminou: não fica atacando, volta ao botão
						if not E.raidEndAt then E.raidEndAt = tick() end
						if tick() - E.raidEndAt > 3 then
							E.raidEndAt = nil
							E.raidPhase = "button"
							note("Raid concluída", Color3.fromRGB(110, 255, 160))
							if not E.autoRaid then finish("raid") return end
						else
							say.raid("🏁 Raid terminando...", Color3.fromRGB(190, 190, 230))
							stopFly()
						end
						return
					end
					E.raidEndAt = nil
					noclipOn()
					local function nearIsland(pos)
						for _, ip in pairs(islands) do
							if (ip - pos).Magnitude <= 450 then return true end
						end
						return false
					end
					local t = nearestEnemy(nil, hrp, nearIsland)
					if t then
						say.raid("⚔️ Raid — limpando inimigos", Color3.fromRGB(150, 220, 255))
						flyTo(hrp, t.part.Position + Vector3.new(0, cfg().height, 0))
						hit(80)
						return
					end
					for i = 5, 1, -1 do
						if islands[i] then
							say.raid("🏝️ Raid — indo para a ilha " .. i, Color3.fromRGB(180, 200, 255))
							flyTo(hrp, islands[i] + Vector3.new(0, 60, 0))
							return
						end
					end
					return
				end

				if E.raidPhase == "loading" then
					-- espera o mapa da raid carregar antes de atacar qualquer coisa
					if not hasIslands then
						if E.raidClickAt and tick() - E.raidClickAt > 30 then
							E.raidPhase = "button" -- a raid não começou: tenta de novo
							E.raidClickAt = nil
							return
						end
						say.raid("⏳ Raid iniciada — esperando o mapa carregar...", Color3.fromRGB(190, 160, 255))
						fly(hrp, Vector3.zero)
						return
					end
					if not E.raidLoadedAt then
						E.raidLoadedAt = tick()
						for _, ip in pairs(islands) do
							pcall(function() player:RequestStreamAroundAsync(ip, 3) end)
						end
					end
					if tick() - E.raidLoadedAt < 5 then
						say.raid("🗺️ Carregando o mapa da raid...", Color3.fromRGB(190, 160, 255))
						fly(hrp, Vector3.zero)
						return
					end
					E.raidPhase = "fight"
					E.raidEndAt = nil
					return
				end

				-- fase "button": obrigatoriamente vai ao botão
				if not E.autoRaid then
					say.raid("⏳ Aguardando você iniciar a raid", Color3.fromRGB(190, 190, 230))
					stopFly()
					return
				end
				local cd, main = raidButton()
				if not cd then
					say.raid("❓ Botão da raid não achado (só no 2º/3º mar)", Color3.fromRGB(255, 160, 120))
					stopFly()
					return
				end
				noclipOn()
				local d = (main.Position - hrp.Position).Magnitude
				if d > 25 then
					say.raid("🧭 Indo ao botão da raid (" .. math.floor(d) .. "m)", Color3.fromRGB(150, 200, 255))
					flyTo(hrp, main.Position + Vector3.new(0, 6, 0))
					return
				end
				fly(hrp, Vector3.zero)
				if tick() - E.lastRaidTry > 8 then
					E.lastRaidTry = tick()
					if not ensureChip() then return end
					say.raid("🔮 Iniciando raid (" .. E.chip .. ")", Color3.fromRGB(190, 160, 255))
					local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					if hum then pcall(function() hum:UnequipTools() end) end
					task.wait(0.3)
					if fireclickdetector then
						pcall(fireclickdetector, cd)
						E.raidClickAt = tick()
						E.raidLoadedAt = nil
						E.raidPhase = "loading"
					else
						note("Seu executor não tem fireclickdetector", Color3.fromRGB(255, 120, 120))
					end
				end
			end

			local function stepGoto(hrp)
				local pos = E.gotoFn and E.gotoFn()
				if not pos then
					note("Evento terminou", Color3.fromRGB(255, 160, 120))
					finish("travel")
					return
				end
				noclipOn()
				local d = (pos - hrp.Position).Magnitude
				if d < 60 then
					note("Chegou em " .. E.gotoName, Color3.fromRGB(110, 255, 160))
					finish("travel")
					return
				end
				say.travel("🧭 Indo para " .. E.gotoName .. " (" .. math.floor(d) .. "m)", Color3.fromRGB(150, 200, 255))
				flyTo(hrp, pos + Vector3.new(0, cfg().height, 0))
			end

			-- ===== Auto Mastery: fila de armas, escolha de mobs (fracos/fortes/perto) e skills mais espertas =====
			local function hasWeapon(w)
				for _, holder in ipairs({player.Character, player:FindFirstChild("Backpack")}) do
					if holder then
						for _, t in ipairs(holder:GetChildren()) do
							if t:IsA("Tool") and toolType(t) == w then return true end
						end
					end
				end
				return false
			end
			local QORDER = {"Melee", "Fruit", "Sword", "Gun"}
			local function queueList()
				local l = {}
				for _, w in ipairs(QORDER) do
					if E.masteryQueue[w] and hasWeapon(w) then table.insert(l, w) end
				end
				return l
			end
			local function pickMastery(hrp)
				local folder = workspace:FindFirstChild("Enemies")
				if not folder then return nil end
				local best, bs
				for _, obj in ipairs(folder:GetChildren()) do
					if obj:IsA("Model") then
						local hum = obj:FindFirstChildOfClass("Humanoid")
						local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
						if hum and hum.Health > 0 and part then
							local d = (part.Position - hrp.Position).Magnitude
							-- o jogo guarda o nível do mob no atributo "Level" e marca bosses com "IsBoss"
							local lvl = tonumber(obj:GetAttribute("Level"))
							local power = lvl or hum.MaxHealth
							local isBoss = obj:GetAttribute("IsBoss") == true
							if d <= E.masteryRange and not (E.masteryNoBoss and isBoss) and (E.masteryMinHP <= 0 or (lvl or 0) >= E.masteryMinHP) then
								local score
								if E.masteryPrio == "weak" then score = power + d * 0.001
								elseif E.masteryPrio == "strong" then score = -power + d * 0.001
								else score = d end
								if not bs or score < bs then bs = score; best = {model = obj, part = part, dist = d, hp = hum.MaxHealth} end
							end
						end
					end
				end
				return best
			end
			local function stepMastery(hrp)
				local char = player.Character
				local qTag = ""
				local function advanceQueue(markDone)
					local list = queueList()
					local cur = list[E.qIdx]
					if markDone and cur then E.qDone[cur] = true end
					local allDone = #list > 0
					for _, w in ipairs(list) do if not E.qDone[w] then allDone = false end end
					if allDone and E.masteryGoal > 0 then
						note("Fila de armas concluída", Color3.fromRGB(110, 255, 160))
						finish("mastery")
						return true
					end
					for _ = 1, #list do
						E.qIdx = (E.qIdx % #list) + 1
						if not E.qDone[list[E.qIdx]] then break end
					end
					E.qStart = tick()
					E.masteryNow = nil
					E.masteryAt = 0
					return false
				end
				if E.masteryUseQueue then
					local list = queueList()
					if #list == 0 then
						say.mastery("❓ Fila vazia ou sem essas armas no inventário", Color3.fromRGB(255, 160, 120))
						stopFly()
						return
					end
					if E.qIdx > #list then E.qIdx = 1 end
					if E.qStart == 0 then E.qStart = tick() end
					if E.masteryQMin > 0 and tick() - E.qStart > E.masteryQMin * 60 then
						if advanceQueue(false) then return end
						list = queueList()
						if E.qIdx > #list then E.qIdx = 1 end
					end
					E.cfg.mastery.weapon = list[E.qIdx]
					qTag = "[" .. E.qIdx .. "/" .. #list .. "] "
				end
				local want = cfg().weapon
				local tool = char and char:FindFirstChildOfClass("Tool")
				if tool and toolType(tool) == want and tick() - E.masteryAt > 2 then
					E.masteryAt = tick()
					local lv = tool:FindFirstChild("Level")
					local mv = tool:GetAttribute("Level") or (lv and lv:IsA("ValueBase") and lv.Value) or nil
					if mv then
						E.masteryNow = tonumber(mv)
						if E.masteryGoal > 0 and E.masteryNow and E.masteryNow >= E.masteryGoal then
							note("Maestria " .. E.masteryNow .. " atingida (" .. tool.Name .. ")", Color3.fromRGB(110, 255, 160))
							if E.masteryUseQueue then
								advanceQueue(true)
							else
								finish("mastery")
							end
							return
						end
					end
				end
				local tag = WEAPON_LABELS[want]
				if tool and toolType(tool) == want then
					local ex = tool:GetAttribute("Exp")
					tag = tool.Name .. (E.masteryNow and (" · maestria " .. E.masteryNow) or "") .. (ex and (" (exp " .. math.floor(tonumber(ex) or 0) .. ")") or "")
				end
				equip()
				buso()
				local t = pickMastery(hrp)
				if not t then
					say.mastery("❓ " .. qTag .. "Sem mobs que sirvam num raio de " .. E.masteryRange .. "m", Color3.fromRGB(255, 160, 120))
					stopFly()
					return
				end
				noclipOn()
				say.mastery("⚔️ " .. qTag .. tag .. " — " .. t.model.Name, Color3.fromRGB(150, 220, 255))
				flyTo(hrp, t.part.Position + Vector3.new(0, cfg().height, 0))
				hit(80)
				if E.masterySkills and (want == "Fruit" or want == "Gun") and E.skillFn and t.dist < E.skillDist and tick() - E.skillAt > E.skillGap then
					E.skillAt = tick()
					task.spawn(E.skillFn)
				end
			end

			step = function()
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not hrp or not hum or hum.Health <= 0 then return end
				if E.mode == "material" then stepMaterial(hrp)
				elseif E.mode == "raid" then stepRaid(hrp)
				elseif E.mode == "mastery" then stepMastery(hrp)
				elseif E.mode == "travel" then stepGoto(hrp) end
			end

