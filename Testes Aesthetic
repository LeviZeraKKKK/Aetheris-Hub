		local countLabel = Instance.new("TextLabel")
		countLabel.Size = UDim2.new(1, -10, 0, COUNT_H)
		countLabel.Position = UDim2.new(0, 6, 0, PAD + SEARCH_H + 1)
		countLabel.BackgroundTransparency = 1
		countLabel.Font = currentGlobalFont
		countLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
		countLabel.TextSize = 8
		countLabel.TextXAlignment = Enum.TextXAlignment.Left
		countLabel.ZIndex = 61
		countLabel.Parent = gui

