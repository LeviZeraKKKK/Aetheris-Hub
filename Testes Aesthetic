					b.MouseButton1Click:Connect(function()
						state.value = opt.value
						state.label = opt.label
						applyHeaderIcon(opt.icon)
						setLabelText()
						close()
						if cfg.onSelect then cfg.onSelect(opt.value, opt) end
					end)
				end
			end
			if shownCount == 0 then
				local empty = Instance.new("TextLabel")
				empty.Size = UDim2.new(1, -6, 0, ROW - 2)
				empty.BackgroundTransparency = 1
				empty.Font = currentGlobalFont
				empty.Text = total == 0 and "Nenhuma opção encontrada." or "Nada encontrado."
				empty.TextColor3 = Color3.fromRGB(150, 150, 170)
				empty.TextSize = 10
				empty.ZIndex = 62
				empty.Parent = list
			end
			list.CanvasSize = UDim2.new(0, 0, 0, math.max(shownCount, 1) * ROW)
			local noun = total == 1 and "opção" or "opções"
			if query == "" then
				countLabel.Text = total .. " " .. noun
			else
				countLabel.Text = shownCount .. " de " .. total .. " " .. noun
			end
		end
		pop.populate = populate
		populate()
		search:GetPropertyChangedSignal("Text"):Connect(populate)

		TweenService:Create(gui, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(popW, popH)}):Play()

		-- se a caixa sair do lugar (rolagem) ou da tela (aba trocada, painel minimizado), fecha
		pop.startPos = boxPos
		pop.watch = RunService.Heartbeat:Connect(function()
			if not box.Parent or not isShown(box) or (box.AbsolutePosition - pop.startPos).Magnitude > 3 then
				close()
			end
		end)
		state.popup = pop
	end

	local function closePopup()
		local pop = state.popup
		state.popup = nil
		if not pop then return end
		if pop.watch then pop.watch:Disconnect() end
		if pop.backdrop then pop.backdrop:Destroy() end
		if pop.gui then pop.gui:Destroy() end
	end

	local function setOpen(open)
		if state.open == open then return end
		state.open = open
		TweenService:Create(arrow, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {Rotation = open and 180 or 0}):Play()
		TweenService:Create(frameStroke, TweenInfo.new(0.2), {
			Color = open and currentThemeColor or GRAYSTROKE, Transparency = open and 0.2 or 0.55
		}):Play()
		if open then openPopup() else closePopup() end
	end
	close = function() if state.open then setOpen(false) end end

	header.MouseEnter:Connect(function()
		TweenService:Create(box, TweenInfo.new(0.12), {BackgroundTransparency = split and 0.25 or 0.15}):Play()
	end)
	header.MouseLeave:Connect(function()
		TweenService:Create(box, TweenInfo.new(0.15), {BackgroundTransparency = split and 0 or 0.35}):Play()
	end)
	header.MouseButton1Click:Connect(function() setOpen(not state.open) end)
	frame.Destroying:Connect(closePopup)
	table.insert(AetherisThemeHooks, function(color)
		if not frame.Parent then return end
		local pop = state.popup
		if pop then
			pop.stroke.Color = color
			pop.list.ScrollBarImageColor3 = color
			pop.populate()
		end
	end)

	return {
		frame = frame,
		close = close,
			setValue = function(value, text, icon)
				state.value = value
				state.label = text
				applyHeaderIcon(icon)
				setLabelText()
		end,
	}
end

