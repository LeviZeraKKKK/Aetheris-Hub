				-- Lê o inventário do jogo (getInventory): frutas já guardadas e quantas cabem
				local function fruitKey(n)
					n = tostring(n or ""):lower()
					n = n:gsub("%s*fruit%s*$", "")
					return (n:match("^[^%-%s]+") or n)
				end
				local function inventoryInfo(comm)
					local ok, inv = pcall(function() return comm:InvokeServer("getInventory") end)
					if not ok or type(inv) ~= "table" then return nil end
					local stored, count = {}, 0
					for _, it in pairs(inv) do
						if type(it) == "table" then
							local nm = it.Name or it.name
							local ty = it.Type or it.type
							if nm and (ty == "Blox Fruit" or tostring(nm):find("%-")) then
								stored[fruitKey(nm)] = true
								count = count + 1
							end
						end
					end
					local cap
					pcall(function()
						local d = player:FindFirstChild("Data")
						local c = d and (d:FindFirstChild("FruitCap") or d:FindFirstChild("FruitCapacity"))
						if c then cap = tonumber(c.Value) end
					end)
					return {stored = stored, count = count, cap = cap}
				end
				addToggle(sec, "Auto Guardar Fruta", function(state)
					G.token = G.token + 1
					if not state then st.Text = "💤 Desligado"; st.TextColor3 = Color3.fromRGB(150, 150, 180) return end
					local my = G.token
					task.spawn(function()
						while G.token == my and screenGui.Parent do
							-- não guarda a fruta que a Raid Automática vai usar para pagar o chip
							local busyRaid = E.enabled and E.mode == "raid" and E.pay == "Fruta"
							local comm = getComm()
							if comm and not busyRaid then
								local char = player.Character
								for _, holder in ipairs({player:FindFirstChild("Backpack") or char, char or player:FindFirstChild("Backpack")}) do
									if holder then
										for _, t in ipairs(holder:GetChildren()) do
											-- fruta crua do chão: "Nome Fruit". A fruta já comida (arma) não termina em "Fruit"
											if t:IsA("Tool") and t.Name:find("Fruit$") and tick() - (G.lastTry[t] or 0) > 5 then
												G.lastTry[t] = tick()
