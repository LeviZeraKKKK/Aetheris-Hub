local function getEnemyRoot(model)
	if not model:IsA("Model") then return nil end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Head")
	if root and root:IsA("BasePart") then return root end
	return nil
end

local function makeEnemyText(parent, name, size, position, fontSize)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.25
	label.Font = currentGlobalFont
	label.TextSize = fontSize
	label.TextWrapped = false
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = parent
	return label
end

local chestEspObjects = {}
local function isChestName(name)
    local lowerName = string.lower(name or "")
    return lowerName:find("baú", 1, true) ~= nil
        or lowerName:find("bau", 1, true) ~= nil
        or lowerName:find("chest", 1, true) ~= nil
end
local function getChestPart(target)
    if target:IsA("BasePart") then return target end
    if target:IsA("Model") then
        return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end
local function getChestTarget(instance)
    local current = instance
    for _ = 1, 4 do
        if not current or current == workspace then break end
        if current:IsA("Model") and isChestName(current.Name) then return current end
        current = current.Parent
    end
    if instance:IsA("BasePart") and isChestName(instance.Name) then return instance end
    return nil
end
local function createChestESP(target)
    if chestEspObjects[target] then return end
    local part = getChestPart(target)
    if not part then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "AetherisChestHighlight"
    highlight.Adornee = target
    highlight.FillColor = chestEspChamsColor
    highlight.OutlineColor = chestEspChamsColor
    highlight.FillTransparency = 0.55
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = screenGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AetherisChestInfo"
    billboard.Adornee = part
    billboard.Size = UDim2.fromOffset(150, 34)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Enabled = false
    billboard.Parent = screenGui
    local nameLabel = makeEnemyText(billboard, "ChestName", UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 0), 12)
    nameLabel.Text = "Baú"
    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    local distanceLabel = makeEnemyText(billboard, "ChestDistance", UDim2.new(1, 0, 0, 15), UDim2.fromOffset(0, 18), 10)
    distanceLabel.TextXAlignment = Enum.TextXAlignment.Center
    chestEspObjects[target] = {highlight = highlight, billboard = billboard, nameLabel = nameLabel, distanceLabel = distanceLabel}
end
local function removeChestESP(target)
    local data = chestEspObjects[target]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    chestEspObjects[target] = nil
end
task.spawn(function()
    while screenGui.Parent do
        task.wait(0.5)
        if chestEspEnabled then
            local found = {}
            -- Os baús do jogo ficam em workspace.ChestModels (a coleta de baú do Farming usa essa
            -- pasta); Map entra também por garantia. Sem nenhuma das duas, varre o workspace.
            local searchRoots = {}
            local chestModelsRoot = workspace:FindFirstChild("ChestModels")
            if chestModelsRoot then table.insert(searchRoots, chestModelsRoot) end
            local mapRoot = workspace:FindFirstChild("Map") or map
            if mapRoot and mapRoot ~= workspace then table.insert(searchRoots, mapRoot) end
            if #searchRoots == 0 then table.insert(searchRoots, workspace) end
            for _, searchRoot in ipairs(searchRoots) do
                for _, instance in ipairs(searchRoot:GetDescendants()) do
                    if isChestName(instance.Name) then
                        local target = getChestTarget(instance)
                        if target and target:IsDescendantOf(searchRoot) and getChestPart(target) then
                            found[target] = true
                            if not chestEspObjects[target] then createChestESP(target) end
                        end
                    end
                end
            end
            for target in pairs(chestEspObjects) do
                if not found[target] or not target.Parent then removeChestESP(target) end
            end
        else
            for target in pairs(chestEspObjects) do removeChestESP(target) end
        end
    end
end)
