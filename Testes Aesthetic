-- Tudo fica dentro de um bloco do ... end: as variáveis locais da tela de carregamento
-- são liberadas no final e não pesam no limite de 200 locals do script.
do
	local WHITE = Color3.new(1, 1, 1)
	local themeLight = currentThemeColor:Lerp(WHITE, 0.45)

	-- Fundo escurecido + blur leve atrás do card para dar foco (removidos no final).
