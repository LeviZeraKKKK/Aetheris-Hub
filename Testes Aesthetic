			local shown = {}
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player then
					local hay = string.lower(p.DisplayName .. " " .. p.Name)
					if query == "" or string.find(hay, query, 1, true) then table.insert(shown, p) end
				end
			end
			table.sort(shown, function(x, y) return string.lower(x.DisplayName) < string.lower(y.DisplayName) end)
			updateBadge()

			if #shown == 0 then
				new("TextLabel", {
					Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, Font = Enum.Font.Gotham,
					Text = (query == "") and "Nenhum outro jogador no servidor." or "Nenhum jogador encontrado.",
