					restoreAimValues()
				end
			end)
		end, false)

		addSlider(secSilentGun, "FOV Multiplier", 1.0, 15.0, silentFovMultiplier, function(val)
			silentFovMultiplier = val
			if silentGunEnabled then applyAimValues() end
		end, 1, "x")

		addSlider(secSilentGun, "Distance Multiplier", 1.0, 5.0, silentDistMultiplier, function(val)
			silentDistMultiplier = val
			if silentGunEnabled then applyAimValues() end
		end, 1, "x")

		-- Dropdown de jogadores (mesmo estilo do Lock-On): cada clique na linha alterna
		-- Neutro -> Foco -> Aliado -> Neutro.
		-- Foco = o aim assist só atua nele (e entra na lista manual do Lock-On).
		-- Aliado = o aim assist não atua nele, e ele nunca é alvo do Lock-On.
		do
			local function new(class, props, parent)
				local o = Instance.new(class)
				for k, v in pairs(props) do o[k] = v end
				o.Parent = parent
				return o
			end
			local function round(parent, r) return new("UICorner", {CornerRadius = UDim.new(0, r)}, parent) end
			local GRAY = Color3.fromRGB(150, 150, 170)
			local OFFCOLOR = Color3.fromRGB(34, 34, 46)
			local ALLY = Color3.fromRGB(46, 160, 90)
			local LIST_HEIGHT = 158
			local dropOpen = false

			local header = new("TextButton", {
				Name = "AimPlayerDropdownHeader",
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundColor3 = Color3.fromRGB(34, 34, 46),
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = ""
				}, secSilentGun)
				round(header, 7)
				local headerStroke = new("UIStroke", {Color = Color3.fromRGB(70, 70, 95), Transparency = 0.55, Thickness = 1}, header)
				local headerIcon = new("ImageLabel", {
