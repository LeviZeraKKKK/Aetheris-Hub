		saved.last = g.name -- remember the last supported game you played
		persist()
		local ok, err = pcall(function()
			loadstring(game:HttpGet(g.url))()
		end)
		if not ok then warn("[Aetheris Loader] failed to load " .. g.name .. ": " .. tostring(err)) end
		return
	end
end

