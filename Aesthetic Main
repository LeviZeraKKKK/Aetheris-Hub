-- saved data: last game played + favorite games
local SAVE_FILE = "AetherisLoader.json"
local saved = {last = nil, favorites = {}}
pcall(function()
	if readfile and isfile and isfile(SAVE_FILE) then
		local data = HttpService:JSONDecode(readfile(SAVE_FILE))
		if type(data) == "table" then
			saved.last = data.last
			if type(data.favorites) == "table" then saved.favorites = data.favorites end
		end
	end
end)
local function persist()
	pcall(function()
		if writefile then writefile(SAVE_FILE, HttpService:JSONEncode(saved)) end
	end)
end

