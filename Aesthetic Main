local function buildCard(game_, order)
	local card = new("Frame", {LayoutOrder = order, Size = UDim2.new(1, 0, 0, CARD_H), BackgroundColor3 = CARD, BorderSizePixel = 0}, list)
	corner(card, 12)
	local cardStroke = stroke(card, LINE, 1, 0)

	-- ícone do jogo
	local iconBox = new("Frame", {Size = UDim2.new(0, 56, 0, 56), Position = UDim2.new(0, 12, 0, 12), BackgroundColor3 = CARD2, BorderSizePixel = 0}, card)
	corner(iconBox, 12)
	local iconStroke = stroke(iconBox, WHITE, 1.6, 0)
	gradient(iconStroke, 45)
	new("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop,
		Image = "rbxthumb://type=GameIcon&id=" .. tostring(game_.universeId) .. "&w=150&h=150",
	}, iconBox)
	corner(iconBox:FindFirstChildOfClass("ImageLabel"), 12)

	label(card, game_.name, 15, UDim2.new(0, 78, 0, 14), UDim2.new(1, -170, 0, 20), WHITE, Enum.Font.GothamBold)
	label(card, game_.subtitle, 10, UDim2.new(0, 78, 0, 36), UDim2.new(1, -170, 0, 14), GRAY)

	-- estado
	local pill = new("Frame", {
		Size = UDim2.new(0, 92, 0, 18), Position = UDim2.new(1, -104, 0, 14), BackgroundColor3 = Color3.fromRGB(22, 30, 48), BorderSizePixel = 0,
	}, card)
	corner(pill, 9)
	local pillStroke = stroke(pill, LINE, 1)
	local dot = new("Frame", {
		Size = UDim2.new(0, 6, 0, 6), Position = UDim2.new(0, 8, 0.5, -3), BackgroundColor3 = BLUE, BorderSizePixel = 0,
	}, pill)
	corner(dot, 3)
	label(pill, "Suportado", 9, UDim2.new(0, 20, 0, 0), UDim2.new(1, -24, 1, 0),
		Color3.fromRGB(150, 190, 240), Enum.Font.GothamBold)

	-- chips de recursos
	local chips = new("Frame", {Position = UDim2.new(0, 12, 0, 76), Size = UDim2.new(1, -24, 0, 34), BackgroundTransparency = 1}, card)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, chips)
	for i, feat in ipairs(game_.features) do
		local chip = new("Frame", {
			LayoutOrder = i, Size = UDim2.new(0, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Color3.fromRGB(24, 32, 50), BorderSizePixel = 0,
		}, chips)
		corner(chip, 8)
		stroke(chip, LINE, 1)
		new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, chip)
		new("TextLabel", {
			Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium, Text = feat, TextColor3 = Color3.fromRGB(190, 200, 222), TextSize = 9,
		}, chip)
	end

	-- botão de carregar (fundo em degradê + texto separado para o degradê não pintar o texto)
	local btn = new("Frame", {Position = UDim2.new(0, 12, 0, 116), Size = UDim2.new(1, -24, 0, 34), BackgroundTransparency = 1, ClipsDescendants = true}, card)
	corner(btn, 9)
	local fill = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0}, btn)
	local fillGrad = gradient(fill, 0)
	local btnScale = new("UIScale", {}, btn)
	local progress = new("Frame", {
		Size = UDim2.new(0, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = WHITE, BackgroundTransparency = 0.35,
		BorderSizePixel = 0, ZIndex = 3,
	}, btn)
	local btnLabel = label(btn, "Ir para o jogo", 12, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, -2),
		WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	btnLabel.ZIndex = 4
	local hit = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 5, AutoButtonColor = false}, btn)

	local busy = false
	local function setLabel(text, color)
		btnLabel.Text = text
		btnLabel.TextColor3 = color or WHITE
	end
	local function resetLater(delay)
		task.delay(delay, function()
			if not btn.Parent then return end
			progress.Size = UDim2.new(0, 0, 0, 3)
			setLabel("Ir para o jogo")
			fillGrad.Color = ColorSequence.new(PURPLE, BLUE)
			busy = false
		end)
	end

	hit.MouseEnter:Connect(function()
		TweenService:Create(btnScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.03}):Play()
	end)
	hit.MouseLeave:Connect(function()
		TweenService:Create(btnScale, TweenInfo.new(0.15), {Scale = 1}):Play()
	end)

	hit.MouseButton1Click:Connect(function()
		if busy then return end
		busy = true

		-- vai até o jogo suportado (ao entrar, rode o loader de novo e o hub carrega sozinho)
		setLabel("Teleportando...")
		TweenService:Create(progress, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.8, 0, 0, 3)}):Play()
		local ok = pcall(function() TeleportService:Teleport(game_.homePlaceId, player) end)
		if not ok then
			progress.Size = UDim2.new(0, 0, 0, 3)
			fillGrad.Color = ColorSequence.new(RED, Color3.fromRGB(176, 52, 110))
			setLabel("Falhou ao teleportar", WHITE)
			resetLater(2)
		end
	end)

	-- hover do cartão
	card.MouseEnter:Connect(function()
		TweenService:Create(cardStroke, TweenInfo.new(0.2), {Color = BLUE}):Play()
		TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(19, 26, 41)}):Play()
	end)
	card.MouseLeave:Connect(function()
		TweenService:Create(cardStroke, TweenInfo.new(0.2), {Color = LINE}):Play()
		TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = CARD}):Play()
	end)

	return card
end

