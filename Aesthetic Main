-- favorites first, then the last game played, then the rest in the original order
local function refreshOrder()
	for i, g in ipairs(GAMES) do
		local card = cardRefs[g.name]
		if card then
			local o = i * 10
			if saved.favorites[g.name] then o = o - 1000 end
			if saved.last == g.name then o = o - 500 end
			card.LayoutOrder = o
		end
	end
end

