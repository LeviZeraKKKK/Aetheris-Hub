local function glow(x, y, color)
	local g = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(x, 0, y, 0), Size = UDim2.new(0, 230, 0, 230),
		BackgroundColor3 = color, BackgroundTransparency = 0.88, BorderSizePixel = 0, ZIndex = 0,
