-- ===== teleport (tries several ways, in order) =====
local GuiService = game:GetService("GuiService")
local teleportFailedFlag = false

local function httpGet(url)
	local req = (syn and syn.request) or request or http_request or (http and http.request)
	if req then
		local ok, res = pcall(req, {Url = url, Method = "GET"})
		if ok and res and res.Body then return res.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok then return body end
	return nil
end

-- finds a public server of the game that is not full
local function pickServer(placeId)
	local body = httpGet("https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100")
	if not body then return nil end
	local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
	if not ok or type(data) ~= "table" or type(data.data) ~= "table" then return nil end
	local options = {}
	for _, sv in ipairs(data.data) do
		if (sv.playing or 0) < (sv.maxPlayers or 0) then table.insert(options, sv.id) end
	end
	if #options == 0 then return nil end
	return options[math.random(1, #options)]
end

-- waits up to N seconds; stops early if Roblox reports a failed teleport
local function waitUnlessFailed(seconds)
	local t = 0
	while t < seconds do
		if teleportFailedFlag or not gui.Parent then return end
		task.wait(0.25)
		t = t + 0.25
	end
end

-- returns true if the teleport got going (the game is about to close this script)
local function goToGame(g, status)
	local queue = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
	if queue then
		pcall(queue, 'loadstring(game:HttpGet("' .. g.url .. '"))()')
	end

	-- 1) normal teleport
	teleportFailedFlag = false
	status("Teleporting...")
	local ok, err = pcall(function() TeleportService:Teleport(g.homePlaceId, player) end)
	if not ok then
		warn("[Aetheris Loader] Teleport(placeId, player) error: " .. tostring(err))
		pcall(function() TeleportService:Teleport(g.homePlaceId) end)
	end
	waitUnlessFailed(6)
	if not gui.Parent then return true end

	-- 2) join a specific public server
	status("Trying another way...")
	teleportFailedFlag = false
	local serverId = pickServer(g.homePlaceId)
	if serverId then
		local ok2, err2 = pcall(function() TeleportService:TeleportToPlaceInstance(g.homePlaceId, serverId, player) end)
		if not ok2 then warn("[Aetheris Loader] TeleportToPlaceInstance error: " .. tostring(err2)) end
		waitUnlessFailed(6)
		if not gui.Parent then return true end
	else
		warn("[Aetheris Loader] could not list servers (no http function?)")
	end

	-- 3) last resort: open the game link / copy it
	local webLink = "https://www.roblox.com/games/" .. tostring(g.homePlaceId)
	local copied = false
	if setclipboard then copied = pcall(setclipboard, webLink) end
	pcall(function() GuiService:OpenBrowserWindow("roblox://placeId=" .. tostring(g.homePlaceId)) end)
	status(copied and "Link copied - open it" or "Teleport failed")
	return false
end

