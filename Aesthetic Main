-- Teleports to the game and queues the hub to load by itself once you arrive
local function goToGame(g)
	local queue = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
	if queue then
		pcall(queue, 'loadstring(game:HttpGet("' .. g.url .. '"))()')
	end
	local ok, err = pcall(function() TeleportService:Teleport(g.homePlaceId, player) end)
	if not ok then
		ok, err = pcall(function() TeleportService:Teleport(g.homePlaceId) end)
	end
	return ok, err
end

local function buildCard(game_, order)
	local card = new("Frame", {LayoutOrder = order, Size = UDim2.new(1, 0, 0, CARD_H), BackgroundColor3 = CARD, BorderSizePixel = 0}, list)
	corner(card, 10)
	local cardStroke = stroke(card, LINE, 1, 0)

	-- game icon
	local iconBox = new("Frame", {Size = UDim2.new(0, 40, 0, 40), Position = UDim2.new(0, 10, 0, 10), BackgroundColor3 = CARD2, BorderSizePixel = 0}, card)
	corner(iconBox, 9)
	local iconStroke = stroke(iconBox, WHITE, 1.4, 0)
	gradient(iconStroke, 45)
	local iconImg = new("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop,
		Image = "rbxthumb://type=GameIcon&id=" .. tostring(game_.universeId) .. "&w=150&h=150",
	}, iconBox)
	corner(iconImg, 9)

	label(card, game_.name, 12, UDim2.new(0, 58, 0, 11), UDim2.new(1, -140, 0, 16), WHITE, Enum.Font.GothamBold)
	label(card, game_.subtitle, 9, UDim2.new(0, 58, 0, 29), UDim2.new(1, -140, 0, 12), GRAY)

	local pill = new("Frame", {
		Size = UDim2.new(0, 70, 0, 16), Position = UDim2.new(1, -80, 0, 12), BackgroundColor3 = Color3.fromRGB(22, 30, 48), BorderSizePixel = 0,
	}, card)
	corner(pill, 8)
	stroke(pill, LINE, 1)
	local dot = new("Frame", {Size = UDim2.new(0, 5, 0, 5), Position = UDim2.new(0, 7, 0.5, -2), BackgroundColor3 = BLUE, BorderSizePixel = 0}, pill)
	corner(dot, 3)
	label(pill, "Supported", 8, UDim2.new(0, 17, 0, 0), UDim2.new(1, -20, 1, 0), Color3.fromRGB(150, 190, 240), Enum.Font.GothamBold)

	-- feature chips
	local chips = new("Frame", {Position = UDim2.new(0, 10, 0, 58), Size = UDim2.new(1, -20, 0, 30), BackgroundTransparency = 1}, card)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, chips)
	for i, feat in ipairs(game_.features) do
		local chip = new("Frame", {
			LayoutOrder = i, Size = UDim2.new(0, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Color3.fromRGB(24, 32, 50), BorderSizePixel = 0,
		}, chips)
		corner(chip, 7)
		stroke(chip, LINE, 1)
		new("UIPadding", {PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7)}, chip)
		new("TextLabel", {
			Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium, Text = feat, TextColor3 = Color3.fromRGB(190, 200, 222), TextSize = 8,
			TextWrapped = false,
		}, chip)
	end

	-- button (gradient on its own layer so it doesn't tint the text)
	local btn = new("Frame", {Position = UDim2.new(0, 10, 0, 92), Size = UDim2.new(1, -20, 0, 26), BackgroundTransparency = 1, ClipsDescendants = true}, card)
	corner(btn, 8)
	local fill = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0}, btn)
	local fillGrad = gradient(fill, 0)
	local btnScale = new("UIScale", {}, btn)
	local progress = new("Frame", {
		Size = UDim2.new(0, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = WHITE, BackgroundTransparency = 0.35,
		BorderSizePixel = 0, ZIndex = 3,
	}, btn)
	local btnLabel = label(btn, "Go to game", 11, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, -2), WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
	btnLabel.ZIndex = 4
	local hit = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 5, AutoButtonColor = false}, btn)

	local busy = false
	local function setLabel(text) btnLabel.Text = text end
	local function fail(text)
		progress.Size = UDim2.new(0, 0, 0, 3)
		fillGrad.Color = ColorSequence.new(RED, Color3.fromRGB(176, 52, 110))
		setLabel(text)
		task.delay(2.2, function()
			if not btn.Parent then return end
			fillGrad.Color = ColorSequence.new(PURPLE, BLUE)
			setLabel("Go to game")
			busy = false
		end)
	end

	-- if Roblox refuses the teleport, show why
	local failedConn = TeleportService.TeleportInitFailed:Connect(function(_, result, message)
		if not busy or not btn.Parent then return end
		warn("[Aetheris Loader] teleport failed: " .. tostring(result) .. " - " .. tostring(message))
		fail("Teleport failed")
	end)
	btn.Destroying:Connect(function() failedConn:Disconnect() end)

	hit.MouseEnter:Connect(function()
		TweenService:Create(btnScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.03}):Play()
	end)
	hit.MouseLeave:Connect(function()
		TweenService:Create(btnScale, TweenInfo.new(0.15), {Scale = 1}):Play()
	end)

	hit.Activated:Connect(function()
		if busy then return end
		busy = true
		setLabel("Teleporting...")
		TweenService:Create(progress, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.85, 0, 0, 3)}):Play()
		local ok, err = goToGame(game_)
		if not ok then
			warn("[Aetheris Loader] teleport error: " .. tostring(err))
			fail("Teleport failed")
		end
	end)

	card.MouseEnter:Connect(function()
		TweenService:Create(cardStroke, TweenInfo.new(0.2), {Color = BLUE}):Play()
		TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(19, 26, 41)}):Play()
	end)
	card.MouseLeave:Connect(function()
		TweenService:Create(cardStroke, TweenInfo.new(0.2), {Color = LINE}):Play()
		TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = CARD}):Play()
	end)
end

